<Project>
  <!-- Every C# project has an explicit layer. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FreeformHelper.Domain'">
    <HealthLayer>domain</HealthLayer>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FreeformHelper.Application'">
    <HealthLayer>application</HealthLayer>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FreeformHelper.Infrastructure'">
    <HealthLayer>infrastructure</HealthLayer>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FreeformHelper.UI'">
    <HealthLayer>presentation</HealthLayer>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FreeformHelper.Tests'">
    <HealthLayer>tests</HealthLayer>
  </PropertyGroup>
  <!-- BEGIN GENERATED HEALTH WARNING IDS -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FreeformHelper.Tests'">
    <HealthBaselineWarningIds>EnableGenerateDocumentationFile;IDE0330;IDE1006;RS0030</HealthBaselineWarningIds>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FreeformHelper.UI'">
    <HealthBaselineWarningIds>IDE1006;RS0030;VSTHRD002</HealthBaselineWarningIds>
  </PropertyGroup>
  <!-- END GENERATED HEALTH WARNING IDS -->
</Project>
