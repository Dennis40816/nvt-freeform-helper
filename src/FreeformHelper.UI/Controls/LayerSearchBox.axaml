<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             x:Class="FreeformHelper.UI.Controls.LayerSearchBox"
             x:DataType="controls:LayerSearchBox"
             x:Name="Root">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Nvt.Core.Avalonia/Icons/IconResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBox.layerSearch">
      <Setter Property="Height" Value="{DynamicResource NfcControlHeight}"/>
      <Setter Property="Padding" Value="{DynamicResource LayerSearchPadding}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space8}">
    <Grid>
      <TextBox x:Name="SearchBox" Classes="layerSearch singleLineActionInput" PlaceholderText="Search layers"
               Text="{Binding Query, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Search layers"/>
      <controls:FontIcon Classes="symbols" Glyph="{DynamicResource Nvt.Icon.Search}" IsHitTestVisible="False"
                         HorizontalAlignment="Left" Margin="{DynamicResource InsetLeft8}"/>
    </Grid>
    <Button x:Name="ClearSearchButton" Grid.Column="1" Classes="actionIconButton actionGhost flat"
            Click="ClearSearchButton_Click" ToolTip.Tip="Clear search (Esc)" AutomationProperties.Name="Clear search">
      <controls:FontIcon Classes="symbols" Glyph="{DynamicResource Nvt.Icon.Close}"/>
    </Button>
  </Grid>
</UserControl>
