<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FreeformHelper.UI.Controls.SettingsInfoLabel"
             x:Name="Root"
             ToolTip.Tip="{Binding Tip, ElementName=Root}">
  <SelectableTextBlock Classes="settingsInfoLabelText"
                       Text="{Binding Text, ElementName=Root}"
                       TextWrapping="Wrap"/>
</UserControl>
