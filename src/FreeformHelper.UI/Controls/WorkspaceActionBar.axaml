<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
             xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:primitives="clr-namespace:Nvt.Core.Avalonia.Primitives;assembly=Nvt.Core.Avalonia"
             x:Class="FreeformHelper.UI.Controls.WorkspaceActionBar"
             x:DataType="vm:FreeformHelperViewModel"
             IsVisible="{Binding IsRightPanelSettingsTab}">
  <Border BorderBrush="{DynamicResource NfcBorderMutedBrush}" BorderThickness="{DynamicResource BorderTopThin}"
          Background="{DynamicResource NfcSurfaceSubtleBrush}" Padding="{DynamicResource Inset8}">
    <StackPanel Spacing="{DynamicResource Space6}">
      <SelectableTextBlock Classes="stepNote" Text="{Binding WorkspaceWorkHint}" TextWrapping="Wrap"
                           IsVisible="{Binding WorkspaceWorkHint, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"/>
      <primitives:BalancedWrapPanel HorizontalAlignment="Right" BalanceLastRow="False"
                                  ItemSpacing="{DynamicResource Space6}" LineSpacing="{DynamicResource Space6}">
        <Border x:Name="RestoreHint" IsVisible="False">
          <Button Classes="actionGhost" Content="Restore Export Notch Rows"
                  Click="RestoreButton_Click"
                  ToolTip.Tip="Restore the hidden Export Notch Rows window (Ctrl+Shift+E)."/>
        </Border>
        <Button Classes="actionPrimary" Content="{Binding WorkspacePrimaryActionText}"
                Command="{Binding WorkspacePrimaryActionCommand}"/>
      </primitives:BalancedWrapPanel>
    </StackPanel>
  </Border>
</UserControl>
