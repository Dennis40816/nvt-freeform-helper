<Window x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
        xmlns:views="clr-namespace:FreeformHelper.UI.Views"
        mc:Ignorable="d"
        x:Class="FreeformHelper.UI.MainWindow"
        Title="FreeformHelper Modern"
        Icon="/Assets/AppIcon/freeform-helper.ico"
        WindowState="Maximized"
        Background="{DynamicResource NfcAppBackgroundBrush}"
        Foreground="{DynamicResource NfcTextBrush}"
        FontSize="{Binding FreeformHelper.GlobalFontBaseSize, FallbackValue=12}"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:FreeformHelperViewModel}">
      <views:FreeformHelperView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HowToUseViewModel}">
      <views:HowToUseView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DevViewModel}">
      <views:DevView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SimulationHostViewModel}">
      <views:SimulationHostView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CoordinatePlannerHostViewModel}">
      <views:CoordinatePlannerHostView/>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <Grid x:Name="ShellRoot"
          RowDefinitions="Auto,*">
      <!-- Shell header -->
      <Border Grid.Row="0"
              Background="{DynamicResource NfcSurfaceBrush}"
              BorderBrush="{DynamicResource NfcBorderMutedBrush}"
              BorderThickness="{StaticResource BorderBottomThin}"
              Padding="{StaticResource Inset10_6}">
        <Grid x:Name="ShellHeaderRow" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
            <ToggleButton Classes="shellTab actionGhost flat marked"
                          Content="Freeform Helper"
                          Tag="{x:Static vm:ShellPage.Workspace}"
                          IsChecked="{Binding IsWorkspaceActive, Mode=OneWay}"
                          Command="{Binding ShowWorkspaceCommand}"/>
            <ToggleButton Classes="shellTab actionGhost flat marked"
                          Content="Simulation"
                          Tag="{x:Static vm:ShellPage.Simulation}"
                          IsChecked="{Binding IsSimulationActive, Mode=OneWay}"
                          Command="{Binding ShowSimulationCommand}"/>
            <ToggleButton Classes="shellTab actionGhost flat marked"
                          Content="Coordinate"
                          Tag="{x:Static vm:ShellPage.Coordinate}"
                          IsChecked="{Binding IsCoordinateActive, Mode=OneWay}"
                          Command="{Binding ShowCoordinateCommand}"/>
            <ToggleButton Classes="shellTab actionGhost flat marked"
                          Content="How To Use"
                          Tag="{x:Static vm:ShellPage.HowToUse}"
                          IsChecked="{Binding IsHowToUseActive, Mode=OneWay}"
                          Command="{Binding ShowHowToUseCommand}"/>
            <ToggleButton Classes="shellTab actionGhost flat marked"
                          Content="Dev"
                          Tag="{x:Static vm:ShellPage.Dev}"
                          IsVisible="{Binding IsDevPageAvailable}"
                          IsChecked="{Binding IsDevActive, Mode=OneWay}"
                          Command="{Binding ShowDevCommand}"/>
          </StackPanel>
          <Menu x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Once"
                IsVisible="{Binding DataContext.IsWorkspaceActive, RelativeSource={RelativeSource AncestorType=Window}}"
                DataContext="{Binding FreeformHelper}" IsEnabled="{Binding IsProjectEditingEnabled}">
            <MenuItem Header="File">
              <MenuItem Header="Open DXF" Command="{Binding OpenDxfCommand}"/>
              <MenuItem Header="Save Project" Command="{Binding SaveProjectCommand}"/>
              <MenuItem Header="Load Project" Command="{Binding LoadProjectCommand}"/>
            </MenuItem>
            <MenuItem Header="Export">
              <MenuItem Header="Notch" IsEnabled="False"/>
              <MenuItem Header="Export Notch Rows…" Command="{Binding ExportNotchCommand}"
                        ToolTip.Tip="Pick Notch rows, then export using the existing file type selection."/>
              <Separator/>
              <MenuItem Header="DXF" IsEnabled="False"/>
              <MenuItem Header="Export DXF (Visible Layers)" Command="{Binding CadExport.ExportDxfVisibleCommand}"
                        ToolTip.Tip="Export visible canvas layers plus DXF-layer pads using the current export rules."/>
              <MenuItem Header="Export DXF (All Layers)" Command="{Binding CadExport.ExportDxfAllCommand}"
                        ToolTip.Tip="Export all DXF layers, including layers hidden on the canvas."/>
              <MenuItem Header="Export DXF Layer Image" Command="{Binding CadExport.ExportDxfLayerImageCommand}"/>
            </MenuItem>
            <MenuItem Header="Settings">
              <MenuItem Header="Open Settings" Click="OpenSettingsWindow_Click"/>
            </MenuItem>
          </Menu>
        </Grid>
      </Border>

      <!-- Current view -->
      <ContentControl Grid.Row="1"
                      Content="{Binding CurrentViewModel}"/>
    </Grid>
  </Grid>
</Window>
