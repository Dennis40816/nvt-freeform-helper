<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="using:Nvt.Core.Avalonia.Icons"
             xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
             xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
             mc:Ignorable="d"
             x:Class="FreeformHelper.UI.Views.DevView"
             Background="{DynamicResource NfcAppBackgroundBrush}"
             Foreground="{DynamicResource NfcTextBrush}">
  <Design.DataContext>
    <vm:DevViewModel/>
  </Design.DataContext>

  <ScrollViewer x:Name="DevRootScroll"
                Classes="viewportBoundScroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Border x:Name="DebugRoot"
            Classes="viewportBoundContent"
            Padding="{DynamicResource Inset24}">
      <StackPanel Spacing="{DynamicResource Space16}">
        <SelectableTextBlock x:Name="DevLoadedText"
                             Text="Dev page (minimal mode)."
                             FontSize="{DynamicResource FontSizeXl}"
                             FontWeight="SemiBold"/>
        <SelectableTextBlock Text="Prototype sections have been trimmed. This page now keeps only lightweight runtime/theme probes."
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource NfcTextMutedBrush}"/>
        <Border Background="{DynamicResource NfcSurfaceSubtleBrush}"
                BorderBrush="{DynamicResource NfcBorderBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="{DynamicResource Inset16}">
          <StackPanel Spacing="{DynamicResource Space12}">
            <SelectableTextBlock Text="Scroll bars" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"/>
            <ScrollViewer x:Name="DevScrollPreview" Classes="viewportBoundScroll"
                          Height="{StaticResource DevScrollPreviewHeight}"
                          VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
              <Border Classes="viewportBoundContent" Padding="{DynamicResource Inset12}">
                <SelectableTextBlock TextWrapping="Wrap"
                                     Text="Scroll preview&#10;Project settings&#10;Geometry&#10;Freeform&#10;Notch&#10;Index mapping&#10;Export review&#10;CAD pad details&#10;Regular pad details&#10;Simulation&#10;Copper replay&#10;Coordinate planner&#10;Layer selection&#10;Visibility&#10;Display options&#10;Diagnostics&#10;Verification&#10;Console entries&#10;Selection details&#10;Source bounds&#10;Advanced settings&#10;End of preview"/>
              </Border>
            </ScrollViewer>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource NfcSurfaceSubtleBrush}"
                BorderBrush="{DynamicResource NfcBorderBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="{DynamicResource Inset16}">
          <StackPanel Spacing="{DynamicResource Space12}">
            <SelectableTextBlock Text="CAD load spinner preview"
                                 FontSize="{DynamicResource FontSizeLg}"
                                 FontWeight="SemiBold"/>
            <SelectableTextBlock Text="Same LoadingSpinner control used by the CAD load host window."
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource NfcTextMutedBrush}"/>
            <Button Classes="actionNeutral" x:Name="DevTriggerSpinnerButton"
                    HorizontalAlignment="Left"
                    Content="Show loading spinner (1.5s)"
                    Click="OnDevTriggerSpinnerClick"/>
            <Border Background="{DynamicResource NfcSurfaceBrush}"
                    BorderBrush="{DynamicResource NfcBorderMutedBrush}"
                    BorderThickness="{StaticResource BorderThin}"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Height="{StaticResource DevScrollPreviewHeight}">
              <Grid>
                <Border Background="{DynamicResource NfcSurfaceSubtleBrush}"
                        CornerRadius="{DynamicResource RadiusSm}"
                        Margin="{DynamicResource Inset12}">
                  <Grid>
                    <SelectableTextBlock HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource NfcTextMutedBrush}"
                                         Text="Preview area"/>
                  </Grid>
                </Border>
                <Border x:Name="DevLoadingPreviewOverlay"
                        IsVisible="False"
                        Background="{DynamicResource NfcModalScrimBrush}"
                        CornerRadius="{DynamicResource RadiusMd}">
                  <controls:LoadingSpinner HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsAnimationActive="True"/>
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="workspaceSectionCard">
          <StackPanel Spacing="{DynamicResource Space12}">
            <SelectableTextBlock Text="Sidebar control states"
                                 FontSize="{DynamicResource FontSizeLg}"
                                 FontWeight="SemiBold"/>
            <Border Classes="workspaceSectionCard">
              <StackPanel Spacing="{DynamicResource Space8}">
                <Grid Classes="workspaceSectionHeader"
                      RowDefinitions="Auto,Auto">
                  <SelectableTextBlock Classes="workspaceSectionTitle"
                                       Text="Input"/>
                  <SelectableTextBlock Grid.Row="1"
                                       Classes="workspaceSectionSummary"
                                       Text="Manual uniform source; visible regulars share one scenario snapshot."/>
                </Grid>
                <Border Classes="workspaceDetailStrip">
                  <SelectableTextBlock Classes="workspaceSectionMeta"
                                       Text="Regular/FW memory frame input projected onto AA grid."/>
                </Border>
                <Grid ClipToBounds="False">
                  <ToggleButton Classes="workspaceFoldHeader">
                    <Grid Classes="workspaceFoldHeaderContent"
                          ColumnDefinitions="Auto,*">
                      <controls:FontIcon Grid.Column="0"
                                         Classes="symbols"
                                         Glyph="{x:Static icons:NvtIcons.ExpandMore}"/>
                      <SelectableTextBlock Grid.Column="1"
                                           Classes="workspaceSectionTitle"
                                           Text="EMS safety"/>
                    </Grid>
                  </ToggleButton>
                  <Border Classes="workspaceFoldCornerBadge">
                    <SelectableTextBlock Classes="workspaceFoldCornerBadgeText"
                                         Text="0"/>
                  </Border>
                </Grid>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="{DynamicResource Space8}">
                  <Button Classes="actionPrimary workspaceActionButton">
                    <Grid Classes="iconTextButtonContent" ColumnDefinitions="Auto,*,Auto">
                      <controls:FontIcon Grid.Column="0"
                                         Classes="symbols iconTextButtonLeadingIcon"
                                         Glyph="{x:Static icons:NvtIcons.AddCircle}"/>
                      <SelectableTextBlock Grid.Column="1"
                                           Classes="iconTextButtonLabel"
                                           Text="Import"/>
                      <Border Grid.Column="2" Classes="iconTextButtonTrailingSpacer"/>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1"
                          Classes="actionDanger workspaceActionButton">
                    <Grid Classes="iconTextButtonContent" ColumnDefinitions="Auto,*,Auto">
                      <controls:FontIcon Grid.Column="0"
                                         Classes="symbols iconTextButtonLeadingIcon"
                                         Glyph="{x:Static icons:NvtIcons.Remove}"/>
                      <SelectableTextBlock Grid.Column="1"
                                           Classes="iconTextButtonLabel"
                                           Text="Clear"/>
                      <Border Grid.Column="2" Classes="iconTextButtonTrailingSpacer"/>
                    </Grid>
                  </Button>
                </Grid>
                <StackPanel Spacing="{DynamicResource Space6}">
                  <Border Classes="workspaceFileRow">
                    <Grid Classes="workspaceFileRowContent"
                          ColumnDefinitions="Auto,*">
                      <controls:FontIcon Grid.Column="0"
                                         Classes="symbols workspaceFileRowIcon"
                                         Glyph="{x:Static icons:NvtIcons.DataObject}"/>
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource Space2}">
                        <SelectableTextBlock Classes="workspaceFileRowTitle"
                                             Text="regular_frame_001.csv"/>
                        <SelectableTextBlock Classes="workspaceFileRowMeta"
                                             Text="128 frames, compatible regular grid"/>
                        <SelectableTextBlock Classes="workspaceFileRowMeta"
                                             Text="Shape 42 x 36, channel order preserved"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="workspaceFileRow">
                    <Grid Classes="workspaceFileRowContent"
                          ColumnDefinitions="Auto,*">
                      <controls:FontIcon Grid.Column="0"
                                         Classes="symbols workspaceFileRowIcon"
                                         Glyph="{x:Static icons:NvtIcons.DataObject}"/>
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource Space2}">
                        <SelectableTextBlock Classes="workspaceFileRowTitle"
                                             Text="regular_frame_delta_review_long_filename.csv"/>
                        <SelectableTextBlock Classes="workspaceFileRowMeta"
                                             Text="Inspector summary wraps while the filename trims safely."/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="workspaceDetailStrip"
                    HorizontalAlignment="Left"
                    MaxWidth="{StaticResource PanelLeftWidth}">
              <StackPanel Spacing="{DynamicResource Space8}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{DynamicResource Space8}">
                  <Grid Classes="workspaceSectionHeader"
                        RowDefinitions="Auto,Auto">
                    <SelectableTextBlock Classes="workspaceSectionTitle"
                                         Text="DXF operation controls"/>
                    <SelectableTextBlock Grid.Row="1"
                                         Classes="workspaceSectionSummary"
                                         Text="Free-form edit actions using action role hierarchy."/>
                  </Grid>
                  <Button Grid.Column="1"
                          Classes="actionDanger actionIconButton dxfEditHeaderAction"
                          ToolTip.Tip="Reset all DXF edits.">
                    <controls:FontIcon Classes="symbols iconSm"
                                       Glyph="{x:Static icons:NvtIcons.RestartAlt}"/>
                  </Button>
                </Grid>
                <StackPanel Spacing="{DynamicResource Space6}">
                  <SelectableTextBlock Classes="dxfEditSectionLabel"
                                       Text="Quick actions"/>
                  <Border Classes="dxfEditActionGroup">
                    <StackPanel Spacing="{DynamicResource Space6}">
                      <SelectableTextBlock Classes="dxfEditActionGroupLabel"
                                           Text="Hide / restore"/>
                      <Button Classes="dxfEditMiniAction actionDanger"
                              ToolTip.Tip="Hide selected CAD pads.">
                        <StackPanel Classes="dxfEditMiniActionContent"
                                    Orientation="Horizontal"
                                    Spacing="{DynamicResource Space4}">
                          <controls:FontIcon Classes="symbols iconSm dxfEditMiniActionIcon"
                                             Glyph="{x:Static icons:NvtIcons.VisibilityOff}"/>
                          <SelectableTextBlock Classes="dxfEditMiniActionLabel"
                                               Text="Hide selected"/>
                        </StackPanel>
                      </Button>
                      <Grid Classes="dxfEditActionGroupRow"
                            RowDefinitions="Auto,Auto">
                        <Button Grid.Row="0"
                                Classes="dxfEditMiniAction actionNeutral"
                                ToolTip.Tip="Restore last hidden CAD batch.">
                          <StackPanel Classes="dxfEditMiniActionContent"
                                      Orientation="Horizontal"
                                      Spacing="{DynamicResource Space4}">
                            <controls:FontIcon Classes="symbols iconSm dxfEditMiniActionIcon"
                                               Glyph="{x:Static icons:NvtIcons.Undo}"/>
                            <SelectableTextBlock Classes="dxfEditMiniActionLabel"
                                                 Text="Undo hide"/>
                          </StackPanel>
                        </Button>
                        <Button Grid.Row="1"
                                Classes="dxfEditMiniAction actionNeutral"
                                ToolTip.Tip="Restore all manually hidden CAD pads.">
                          <StackPanel Classes="dxfEditMiniActionContent"
                                      Orientation="Horizontal"
                                      Spacing="{DynamicResource Space4}">
                            <controls:FontIcon Classes="symbols iconSm dxfEditMiniActionIcon"
                                               Glyph="{x:Static icons:NvtIcons.Visibility}"/>
                            <SelectableTextBlock Classes="dxfEditMiniActionLabel"
                                                 Text="Show all"/>
                          </StackPanel>
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Classes="dxfEditActionGroup">
                    <StackPanel Spacing="{DynamicResource Space6}">
                      <SelectableTextBlock Classes="dxfEditActionGroupLabel"
                                           Text="Combine / split"/>
                      <Button Classes="dxfEditMiniAction actionNeutral"
                              IsEnabled="False"
                              ToolTip.Tip="Combine selected CAD pads using geometry union.">
                        <StackPanel Classes="dxfEditMiniActionContent"
                                    Orientation="Horizontal"
                                    Spacing="{DynamicResource Space4}">
                          <controls:FontIcon Classes="symbols iconSm dxfEditMiniActionIcon"
                                             Glyph="{x:Static icons:NvtIcons.Merge}"/>
                          <SelectableTextBlock Classes="dxfEditMiniActionLabel"
                                               Text="Combine"/>
                        </StackPanel>
                      </Button>
                      <Button Classes="dxfEditMiniAction actionNeutral"
                              IsEnabled="False"
                              ToolTip.Tip="Split selected combined CAD groups back into their source pads.">
                        <StackPanel Classes="dxfEditMiniActionContent"
                                    Orientation="Horizontal"
                                    Spacing="{DynamicResource Space4}">
                          <controls:FontIcon Classes="symbols iconSm dxfEditMiniActionIcon"
                                             Glyph="{x:Static icons:NvtIcons.CallSplit}"/>
                          <SelectableTextBlock Classes="dxfEditMiniActionLabel"
                                               Text="Split selected"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <Border Classes="workspaceDetailStrip flat">
                  <StackPanel Spacing="{DynamicResource Space6}">
                    <SelectableTextBlock Classes="dxfEditSectionLabel"
                                         Text="Layer bulk toggle"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="{DynamicResource Space6}">
                      <ToggleButton Classes="dxfLayerBulkToggleButton"
                                    IsChecked="True"
                                    ToolTip.Tip="All layers are visible.">
                        <Grid Classes="dxfLayerBulkToggleContent"
                              ColumnDefinitions="Auto,*">
                          <Border Classes="dxfLayerBulkMixedIndicator"
                                  IsVisible="False"/>
                          <SelectableTextBlock Grid.Column="1"
                                               Classes="dxfLayerBulkToggleLabel"
                                               Text="All on"/>
                        </Grid>
                      </ToggleButton>
                      <ToggleButton Classes="dxfLayerBulkToggleButton"
                                    ToolTip.Tip="Every layer is hidden.">
                        <Grid Classes="dxfLayerBulkToggleContent"
                              ColumnDefinitions="Auto,*">
                          <Border Classes="dxfLayerBulkMixedIndicator"
                                  IsVisible="False"/>
                          <SelectableTextBlock Grid.Column="1"
                                               Classes="dxfLayerBulkToggleLabel"
                                               Text="All off"/>
                        </Grid>
                      </ToggleButton>
                      <ToggleButton Classes="dxfLayerBulkToggleButton"
                                    ToolTip.Tip="Some layers are hidden.">
                        <Grid Classes="dxfLayerBulkToggleContent"
                              ColumnDefinitions="Auto,*">
                          <Border Classes="dxfLayerBulkMixedIndicator"/>
                          <SelectableTextBlock Grid.Column="1"
                                               Classes="dxfLayerBulkToggleLabel"
                                               Text="All off"/>
                        </Grid>
                      </ToggleButton>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <StackPanel Spacing="{DynamicResource Space6}">
                  <SelectableTextBlock Classes="dxfEditSectionLabel"
                                       Text="Advanced edit"/>
                  <ToggleButton Classes="workspaceFoldHeader"
                                IsChecked="True">
                    <Grid Classes="workspaceFoldHeaderContent"
                          ColumnDefinitions="Auto,*,Auto">
                      <controls:FontIcon Grid.Column="0"
                                         Classes="symbols iconSm"
                                         Glyph="{x:Static icons:NvtIcons.Settings}"/>
                      <SelectableTextBlock Grid.Column="1"
                                           Text="Advanced edit"
                                           FontWeight="SemiBold"/>
                      <controls:FontIcon Grid.Column="2"
                                         Classes="symbols iconSm"
                                         Glyph="{x:Static icons:NvtIcons.ExpandLess}"/>
                    </Grid>
                  </ToggleButton>
                </StackPanel>
                <Border Classes="workspaceDetailStrip flat">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                        ColumnSpacing="{DynamicResource Space6}">
                    <SelectableTextBlock Grid.Column="0"
                                         VerticalAlignment="Center"
                                         Classes="dxfEditFieldLabel"
                                         Text="Advanced compact actions"/>
                    <Button Grid.Column="1"
                            Classes="actionNeutral actionIconButton dxfEditCompactIconAction"
                            ToolTip.Tip="Rotate selected CAD pads.">
                      <controls:FontIcon Classes="symbols iconSm dxfEditActionIcon"
                                         Glyph="{x:Static icons:NvtIcons.RotateRight}"/>
                    </Button>
                    <Button Grid.Column="2"
                            Classes="actionNeutral actionIconButton dxfEditCompactIconAction"
                            ToolTip.Tip="Move selected CAD pads to layer.">
                      <controls:FontIcon Classes="symbols iconSm dxfEditActionIcon"
                                         Glyph="{x:Static icons:NvtIcons.DriveFileMove}"/>
                    </Button>
                    <Button Grid.Column="3"
                            Classes="actionNeutral actionIconButton dxfEditCompactIconAction"
                            ToolTip.Tip="Create layer and move selected CAD pads.">
                      <controls:FontIcon Classes="symbols iconSm dxfEditActionIcon"
                                         Glyph="{x:Static icons:NvtIcons.AddCircle}"/>
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="workspaceFirstPeekBar">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
                <StackPanel Spacing="{DynamicResource Space4}">
                  <SelectableTextBlock Classes="workspaceFirstPeekTitle"
                                       Text="Simulation"/>
                  <SelectableTextBlock Classes="workspaceFirstPeekSubtitle"
                                       Text="Regular-grid surface simulation."/>
                </StackPanel>
                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                  <Border Classes="chipStatus"
                          Margin="{DynamicResource InsetRight6Bottom6}">
                    <SelectableTextBlock Classes="chipStatusText"
                                         Text="Session ready"/>
                  </Border>
                  <Border Classes="chipStatus"
                          Margin="{DynamicResource InsetRight6Bottom6}">
                    <SelectableTextBlock Classes="chipStatusText"
                                         Text="Manual source"/>
                  </Border>
                  <Border Classes="chipStatus warning"
                          Margin="{DynamicResource InsetRight6Bottom6}">
                    <SelectableTextBlock Classes="chipStatusText"
                                         Text="Safety warning"/>
                  </Border>
                </WrapPanel>
              </Grid>
            </Border>
            <Border Classes="workspaceSecondPeekBar">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
                <WrapPanel Orientation="Horizontal"
                           VerticalAlignment="Center">
                  <Border Classes="chipStatus"
                          Margin="{DynamicResource InsetRight6Bottom6}">
                    <SelectableTextBlock Classes="chipStatusText"
                                         Text="v1.1"/>
                  </Border>
                  <Border Classes="chipStatus"
                          Margin="{DynamicResource InsetRight6Bottom6}">
                    <SelectableTextBlock Classes="chipStatusText"
                                         Text="Heatmap"/>
                  </Border>
                  <Border Classes="chipStatus"
                          Margin="{DynamicResource InsetRight6Bottom6}">
                    <SelectableTextBlock Classes="chipStatusText"
                                         Text="AA area"/>
                  </Border>
                </WrapPanel>
                <SelectableTextBlock Grid.Column="1"
                                     Classes="workspaceSecondPeekStatus"
                                     Text="Canvas projected from current workspace"/>
              </Grid>
            </Border>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="viewportOverlayAction"
                      Margin="{DynamicResource InsetRight8Bottom6}"
                      ToolTip.Tip="Icon button">
                <controls:FontIcon Classes="symbols"
                                   Glyph="{x:Static icons:NvtIcons.Search}"/>
              </Button>
              <ToggleButton Classes="viewportOverlayAction"
                            Margin="{DynamicResource InsetRight8Bottom6}"
                            IsChecked="True"
                            ToolTip.Tip="Selected icon button">
                <controls:FontIcon Classes="symbols"
                                   Glyph="{x:Static icons:NvtIcons.Visibility}"/>
              </ToggleButton>
              <Button Classes="workspaceActionButton actionNeutral"
                      Width="{StaticResource NotchExportPrimaryButtonMinWidth}"
                      Margin="{DynamicResource InsetRight8Bottom6}"
                      ToolTip.Tip="Icon + text action">
                <Grid Classes="iconTextButtonContent" ColumnDefinitions="Auto,*,Auto">
                  <controls:FontIcon Grid.Column="0"
                                     Classes="symbols iconTextButtonLeadingIcon"
                                     Glyph="{x:Static icons:NvtIcons.ContentCopy}"/>
                  <SelectableTextBlock Grid.Column="1"
                                       Classes="iconTextButtonLabel"
                                       Text="Copy result"/>
                  <Border Grid.Column="2" Classes="iconTextButtonTrailingSpacer"/>
                </Grid>
              </Button>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="chipAction"
                      Margin="{DynamicResource InsetRight6Bottom6}">
                <Grid Classes="workspacePresetButtonContent" ColumnDefinitions="Auto,*">
                  <controls:FontIcon Grid.Column="0"
                                     Classes="symbols"
                                     Glyph="{x:Static icons:NvtIcons.AddCircle}"/>
                  <SelectableTextBlock Grid.Column="1"
                                       Classes="workspacePresetButtonLabel"
                                       Text="Uniform 400"/>
                </Grid>
              </Button>
              <Button Classes="chipAction"
                      Margin="{DynamicResource InsetRight6Bottom6}">
                <Grid Classes="workspacePresetButtonContent" ColumnDefinitions="Auto,*">
                  <controls:FontIcon Grid.Column="0"
                                     Classes="symbols"
                                     Glyph="{x:Static icons:NvtIcons.AddCircle}"/>
                  <SelectableTextBlock Grid.Column="1"
                                       Classes="workspacePresetButtonLabel"
                                       Text="Zero"/>
                </Grid>
              </Button>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
              <Border Classes="chipStatus"
                      Margin="{DynamicResource InsetRight6Bottom6}">
                <SelectableTextBlock Classes="chipStatusText"
                                     Text="Primary summary"/>
              </Border>
              <Border Classes="chipStatus warning"
                      Margin="{DynamicResource InsetRight6Bottom6}">
                <SelectableTextBlock Classes="chipStatusText"
                                     Text="Warning status"/>
              </Border>
              <Border Classes="chipStatus danger"
                      Margin="{DynamicResource InsetRight6Bottom6}">
                <SelectableTextBlock Classes="chipStatusText"
                                     Text="Long AA source summary with active layer and coordinate reference details"/>
              </Border>
            </WrapPanel>
            <Border Classes="workspaceInspectorContextStrip">
              <SelectableTextBlock Classes="workspaceInspectorContextText"
                                   Text="Selected REG (R128, C064), AA center 25.000 mm x 18.750 mm, source layer L2 copper, export-ready coordinate status."/>
            </Border>
          </StackPanel>
        </Border>
        <Border x:Name="CoreButtonRolesPreview" Classes="workspaceSectionCard">
          <StackPanel Spacing="{DynamicResource Space12}">
            <TextBlock Text="Core button roles" FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"/>
            <TextBlock Text="Use Tab to inspect keyboard focus; hover and press each role to inspect its states." TextWrapping="Wrap"/>
            <StackPanel x:Name="PrimaryButtonSamples" Spacing="{DynamicResource Space6}">
              <TextBlock Text="Primary: actionPrimary" FontWeight="SemiBold"/>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="actionPrimary" Content="Rest" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <ToggleButton Classes="actionPrimary" Content="Checked" IsChecked="True" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionPrimary" Content="Disabled" IsEnabled="False" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionPrimary" Content="A long action label that must remain readable and trim within its slot"
                        MaxWidth="{DynamicResource WorkspaceSummaryChipMaxWidth}" Margin="{DynamicResource InsetRight8Bottom6}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="NeutralButtonSamples" Spacing="{DynamicResource Space6}">
              <TextBlock Text="Neutral: actionNeutral" FontWeight="SemiBold"/>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="actionNeutral" Content="Rest" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <ToggleButton Classes="actionNeutral" Content="Checked" IsChecked="True" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionNeutral" Content="Disabled" IsEnabled="False" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionNeutral" Content="A long action label that must remain readable and trim within its slot"
                        MaxWidth="{DynamicResource WorkspaceSummaryChipMaxWidth}" Margin="{DynamicResource InsetRight8Bottom6}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="DangerButtonSamples" Spacing="{DynamicResource Space6}">
              <TextBlock Text="Danger: actionDanger" FontWeight="SemiBold"/>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="actionDanger" Content="Rest" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <ToggleButton Classes="actionDanger" Content="Checked" IsChecked="True" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionDanger" Content="Disabled" IsEnabled="False" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionDanger" Content="A long action label that must remain readable and trim within its slot"
                        MaxWidth="{DynamicResource WorkspaceSummaryChipMaxWidth}" Margin="{DynamicResource InsetRight8Bottom6}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="GhostButtonSamples" Spacing="{DynamicResource Space6}">
              <TextBlock Text="Ghost: actionGhost" FontWeight="SemiBold"/>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="actionGhost" Content="Rest" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <ToggleButton Classes="actionGhost" Content="Checked" IsChecked="True" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionGhost" Content="Disabled" IsEnabled="False" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionGhost" Content="A long action label that must remain readable and trim within its slot"
                        MaxWidth="{DynamicResource WorkspaceSummaryChipMaxWidth}" Margin="{DynamicResource InsetRight8Bottom6}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="FlatghostButtonSamples" Spacing="{DynamicResource Space6}">
              <TextBlock Text="Flat ghost: actionGhost flat" FontWeight="SemiBold"/>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="actionGhost flat" Content="Rest" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <ToggleButton Classes="actionGhost flat" Content="Checked" IsChecked="True" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionGhost flat" Content="Disabled" IsEnabled="False" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="actionGhost flat" Content="A long action label that must remain readable and trim within its slot"
                        MaxWidth="{DynamicResource WorkspaceSummaryChipMaxWidth}" Margin="{DynamicResource InsetRight8Bottom6}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="ChipButtonSamples" Spacing="{DynamicResource Space6}">
              <TextBlock Text="Chip: chipAction" FontWeight="SemiBold"/>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="chipAction" Content="Rest" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <ToggleButton Classes="chipAction" Content="Checked" IsChecked="True" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="chipAction" Content="Disabled" IsEnabled="False" Margin="{DynamicResource InsetRight8Bottom6}"/>
                <Button Classes="chipAction" Content="A long action label that must remain readable and trim within its slot"
                        MaxWidth="{DynamicResource WorkspaceSummaryChipMaxWidth}" Margin="{DynamicResource InsetRight8Bottom6}"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="IconButtonSamples" Spacing="{DynamicResource Space6}">
              <TextBlock Text="Icon: actionIconButton + actionGhost" FontWeight="SemiBold"/>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="actionIconButton actionGhost" ToolTip.Tip="Rest icon" Margin="{DynamicResource InsetRight8Bottom6}">
                  <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:NvtIcons.ContentCopy}"/>
                </Button>
                <ToggleButton Classes="actionIconButton actionGhost flat" IsChecked="True" ToolTip.Tip="Checked icon" Margin="{DynamicResource InsetRight8Bottom6}">
                  <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:NvtIcons.Visibility}"/>
                </ToggleButton>
                <Button Classes="actionIconButton actionGhost" IsEnabled="False" ToolTip.Tip="Disabled icon" Margin="{DynamicResource InsetRight8Bottom6}">
                  <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:NvtIcons.Delete}"/>
                </Button>
                <Button Classes="actionIconButton actionGhost" Content="A long icon label" ToolTip.Tip="Long-label clipping sample" Margin="{DynamicResource InsetRight8Bottom6}"/>
              </WrapPanel>
            </StackPanel>
            <WrapPanel x:Name="ProductButtonSamples" Orientation="Horizontal">
              <ToggleButton Classes="canvasQuickToggle" Content="Canvas off" Margin="{DynamicResource InsetRight8Bottom6}"/>
              <ToggleButton Classes="canvasQuickToggle" Content="Canvas on" IsChecked="True" Margin="{DynamicResource InsetRight8Bottom6}"/>
              <ToggleButton Classes="canvasQuickToggle" Content="Canvas disabled" IsEnabled="False" Margin="{DynamicResource InsetRight8Bottom6}"/>
              <ToggleButton Classes="canvasToolbarIcon" IsChecked="True" ToolTip.Tip="Canvas icon shape" Margin="{DynamicResource InsetRight8Bottom6}">
                <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:NvtIcons.Layers}"/>
              </ToggleButton>
              <Border Classes="chipStatus"><TextBlock Text="Status"/></Border>
              <Border Classes="chipStatus warning"><TextBlock Text="Warning"/></Border>
              <Border Classes="chipStatus danger"><TextBlock Text="Danger"/></Border>
              <Border Classes="chipStatus success"><TextBlock Text="Success"/></Border>
            </WrapPanel>
          </StackPanel>
        </Border>
        <panels:CollapsiblePanel Title="Integrated workspace controls" IsExpanded="True">
          <StackPanel Spacing="{DynamicResource Space8}">
            <panels:CollapsiblePanel Title="Flat diagnostic header" IsExpanded="False"/>
          </StackPanel>
        </panels:CollapsiblePanel>
        <Border Classes="workspaceSectionCard">
          <StackPanel Spacing="{DynamicResource Space12}">
            <SelectableTextBlock Classes="padInfoTitle" Text="PadHeader: common actions, wide and narrow"/>
            <SelectableTextBlock Classes="padInfoSubtle" Text="Unavailable actions keep their slot and explain why in a tooltip."/>
            <controls:PadHeader x:Name="DevCadHeader" Title="CAD pad" Subtitle="Single pad"
                                Width="{DynamicResource PanelRightWidth}" HorizontalAlignment="Left">
              <controls:PadHeader.KindMark>
                <Path Width="{DynamicResource IconSizeMd}" Height="{DynamicResource IconSizeMd}"
                      Fill="{DynamicResource BrushCanvasCadSelected}" Data="M2 12 L12 2 L22 12 L12 22 Z"/>
              </controls:PadHeader.KindMark>
              <controls:PadHeader.Actions>
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource Space2}">
                  <Border Grid.Column="0" ToolTip.Tip="Focus the best Regular match">
                    <Button Classes="actionGhost" ToolTip.Tip="Focus the best Regular match"
                            Classes.actionIconButton="{Binding !ShowActionLabels, ElementName=DevCadHeader}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FitScreen}"/>
                        <TextBlock Text="Locate match" IsVisible="{Binding ShowActionLabels, ElementName=DevCadHeader}"/>
                      </StackPanel>
                    </Button>
                  </Border>
                  <Border Grid.Column="1" ToolTip.Tip="Open Notch detail">
                    <Button Classes="actionGhost" ToolTip.Tip="Open Notch detail"
                            Classes.actionIconButton="{Binding !ShowActionLabels, ElementName=DevCadHeader}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.DataObject}"/>
                        <TextBlock Text="Notch detail" IsVisible="{Binding ShowActionLabels, ElementName=DevCadHeader}"/>
                      </StackPanel>
                    </Button>
                  </Border>
                  <Border Grid.Column="2" ToolTip.Tip="Turn on Color CAD by area first">
                    <Button Classes="actionGhost" IsEnabled="False" ToolTip.Tip="Turn on Color CAD by area first"
                            Classes.actionIconButton="{Binding !ShowActionLabels, ElementName=DevCadHeader}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.Layers}"/>
                        <TextBlock Text="Area bucket" IsVisible="{Binding ShowActionLabels, ElementName=DevCadHeader}"/>
                      </StackPanel>
                    </Button>
                  </Border>
                </Grid>
              </controls:PadHeader.Actions>
            </controls:PadHeader>
            <controls:PadHeader x:Name="DevCadHeaderNarrow" Title="CAD pad" Subtitle="Single pad"
                                Width="{DynamicResource PadHeaderNarrowPreviewWidth}" HorizontalAlignment="Left">
              <controls:PadHeader.KindMark>
                <Path Width="{DynamicResource IconSizeMd}" Height="{DynamicResource IconSizeMd}"
                      Fill="{DynamicResource BrushCanvasCadSelected}" Data="M2 12 L12 2 L22 12 L12 22 Z"/>
              </controls:PadHeader.KindMark>
              <controls:PadHeader.Actions>
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource Space2}">
                  <Border Grid.Column="0" ToolTip.Tip="Focus the best Regular match">
                    <Button Classes="actionGhost" ToolTip.Tip="Focus the best Regular match"
                            Classes.actionIconButton="{Binding !ShowActionLabels, ElementName=DevCadHeaderNarrow}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FitScreen}"/>
                        <TextBlock Text="Locate match" IsVisible="{Binding ShowActionLabels, ElementName=DevCadHeaderNarrow}"/>
                      </StackPanel>
                    </Button>
                  </Border>
                  <Border Grid.Column="1" ToolTip.Tip="Open Notch detail">
                    <Button Classes="actionGhost" ToolTip.Tip="Open Notch detail"
                            Classes.actionIconButton="{Binding !ShowActionLabels, ElementName=DevCadHeaderNarrow}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.DataObject}"/>
                        <TextBlock Text="Notch detail" IsVisible="{Binding ShowActionLabels, ElementName=DevCadHeaderNarrow}"/>
                      </StackPanel>
                    </Button>
                  </Border>
                  <Border Grid.Column="2" ToolTip.Tip="Turn on Color CAD by area first">
                    <Button Classes="actionGhost" IsEnabled="False" ToolTip.Tip="Turn on Color CAD by area first"
                            Classes.actionIconButton="{Binding !ShowActionLabels, ElementName=DevCadHeaderNarrow}">
                      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                        <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.Layers}"/>
                        <TextBlock Text="Area bucket" IsVisible="{Binding ShowActionLabels, ElementName=DevCadHeaderNarrow}"/>
                      </StackPanel>
                    </Button>
                  </Border>
                </Grid>
              </controls:PadHeader.Actions>
            </controls:PadHeader>
          </StackPanel>
        </Border>
        <SelectableTextBlock x:Name="DevProbeText"
                             TextWrapping="Wrap"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
