<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
        xmlns:viewModels="clr-namespace:FreeformHelper.UI.ViewModels"
        xmlns:sections="clr-namespace:FreeformHelper.UI.Views.WorkspaceSections"
        x:Class="FreeformHelper.UI.Views.IndexMappingReportWindow"
        x:DataType="viewModels:IndexMappingReportViewModel"
        x:Name="ReportWindow"
        Width="{DynamicResource IndexMappingReportWidth}"
        Height="{DynamicResource IndexMappingReportHeight}"
        MinWidth="{DynamicResource IndexMappingReportMinWidth}"
        MinHeight="{DynamicResource IndexMappingReportMinHeight}"
        WindowStartupLocation="CenterOwner"
        IsEnabled="{Binding Editing.IsProjectEditingEnabled}"
        Background="{DynamicResource BrushBgSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        Title="Verification Workspace">
  <Window.Styles>
    <StyleInclude Source="avares://FreeformHelper.UI/Styles/IndexMappingReport.axaml"/>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding #ReportWindow.FocusSearchCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchKeywordCommand}"/>
  </Window.KeyBindings>
  <panels:WorkspaceShell Classes="indexMappingReport"
                         LeftColumnWidth="{DynamicResource NotchExportMainLeftColumnWidth}"
                         RightColumnWidth="{DynamicResource IndexMappingReportInspectorWidth}">
    <panels:WorkspaceShell.SummaryContent>
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource Space12}">
        <SelectableTextBlock Classes="workspaceGroupTitle" VerticalAlignment="Center"
                             Text="{Binding ActiveVerificationStepText}"/>
        <Border Grid.Column="1" Classes="chipStatus">
          <SelectableTextBlock Classes="chipStatusText" Text="{Binding OverallStatusSummaryText}"/>
        </Border>
        <SelectableTextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding OpenIssueSummaryText}"/>
        <SelectableTextBlock Grid.Column="3" VerticalAlignment="Center"
                             Foreground="{DynamicResource BrushTextMuted}"
                             Text="{Binding MaskAuditSummary}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding MaskAuditSummary}"/>
        <SelectableTextBlock Grid.Column="4" VerticalAlignment="Center"
                             Foreground="{DynamicResource BrushTextMuted}" Text="{Binding TableRevisionText}"/>
      </Grid>
    </panels:WorkspaceShell.SummaryContent>
    <panels:WorkspaceShell.ToolbarContent>
      <sections:IndexMappingReportFilterBarView x:Name="FilterBar"/>
    </panels:WorkspaceShell.ToolbarContent>
    <panels:WorkspaceShell.LeftContent>
      <sections:IndexMappingReportLeftPaneView/>
    </panels:WorkspaceShell.LeftContent>
    <panels:WorkspaceShell.RightContent>
      <sections:IndexMappingReportRightPaneView/>
    </panels:WorkspaceShell.RightContent>
    <panels:WorkspaceShell.FooterContent>
      <sections:IndexMappingReportFooterView/>
    </panels:WorkspaceShell.FooterContent>
  </panels:WorkspaceShell>
</Window>
