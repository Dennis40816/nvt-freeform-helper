<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
             xmlns:sections="clr-namespace:FreeformHelper.UI.Views.WorkspaceSections"
             x:CompileBindings="True"
             mc:Ignorable="d"
             x:Class="FreeformHelper.UI.Views.CoordinatePlannerWorkspaceView"
             x:Name="WorkspaceRoot"
             x:DataType="vm:CoordinatePlannerWorkspaceViewModel"
             Background="{DynamicResource BrushBgApp}"
             Foreground="{DynamicResource BrushTextPrimary}">
  <UserControl.Styles>
    <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/MenuStyles.axaml"/>
  </UserControl.Styles>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource PanelLeftWidthGrid}"/>
      <ColumnDefinition Width="{StaticResource SplitterThicknessGrid}"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="{StaticResource SplitterThicknessGrid}"/>
      <ColumnDefinition Width="{StaticResource CoordinatePanelRightWidthGrid}"/>
    </Grid.ColumnDefinitions>
    <sections:CoordinatePlannerWorkspaceControlsPaneView Grid.Column="0"/>
    <GridSplitter Grid.Column="1"
                  Width="{StaticResource SplitterThickness}"
                  Background="{DynamicResource BrushBorder}"
                  HorizontalAlignment="Stretch"
                  ShowsPreview="True"/>
    <Border Grid.Column="2" Background="{DynamicResource BrushCanvasBackground}" ClipToBounds="True">
      <Grid x:Name="CoordinatePreviewHost" RowDefinitions="Auto,*" ClipToBounds="True">
        <Border Grid.Row="0" Classes="workspaceSecondPeekBar">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Space6}">
            <Button Classes="actionGhost actionIconButton"
                    ToolTip.Tip="Fit AA canvas (F)"
                    Command="{Binding FitCanvasCommand}">
              <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.FitScreen}"/>
            </Button>
            <ToggleButton Grid.Column="1"
                          Classes="actionGhost actionIconButton"
                          ToolTip.Tip="Toggle regular grid"
                          IsChecked="{Binding ShowRegular, Mode=TwoWay}">
              <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.Layers}"/>
            </ToggleButton>
            <ToggleButton Grid.Column="2"
                          Classes="actionGhost actionIconButton"
                          ToolTip.Tip="Toggle regular row and column labels"
                          IsChecked="{Binding ShowRegularAxisLabels, Mode=TwoWay}">
              <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.Straighten}"/>
            </ToggleButton>
            <ComboBox Grid.Column="3"
                      Width="{DynamicResource CoordinateOverlayModeComboWidth}"
                      ToolTip.Tip="Overlay density: Focus mutes unselected artifacts; Essentials keeps guides and corners; All includes every label."
                      ItemsSource="{Binding OverlayModeOptions}"
                      SelectedItem="{Binding SelectedOverlayModeOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CoordinatePlannerWorkspaceViewModel+CoordinatePlannerOverlayModeOption">
                  <TextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="5" Classes="actionGhost actionIconButton" ToolTip.Tip="Export preview image…">
              <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.ArrowDownward}"/>
              <Button.Flyout>
                <MenuFlyout Opened="PreviewImageMenu_Opened">
                  <MenuItem x:Name="PreviewImageDescription" Header="PNG / BMP" IsEnabled="False"/>
                  <MenuItem Header="Export preview…"
                            Command="{Binding ExportPreviewPngCommand}"
                            ToolTip.Tip="Captures CoordinatePreviewHost, including the canvas toolbar."/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <ToggleButton Grid.Column="6"
                          x:Name="CanvasHelpButton"
                          Classes="actionGhost actionIconButton"
                          ToolTip.Tip="Canvas help">
              <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.Info}"/>
            </ToggleButton>
            <Popup PlacementTarget="{Binding #CanvasHelpButton}"
                   Placement="BottomEdgeAlignedRight"
                   IsOpen="{Binding #CanvasHelpButton.IsChecked, Mode=TwoWay}"
                   IsLightDismissEnabled="True"
                   Topmost="False"
                   PlacementConstraintAdjustment="FlipX,FlipY,SlideX,SlideY">
              <Border Background="{DynamicResource BrushBgPanel}"
                      BorderBrush="{DynamicResource BrushBorder}"
                      BorderThickness="{DynamicResource BorderThin}"
                      CornerRadius="{DynamicResource RadiusMd}"
                      Padding="{DynamicResource Inset12}"
                      MaxWidth="{DynamicResource ViewMenuPopupMaxWidth}">
                <StackPanel Spacing="{DynamicResource Space8}">
                  <TextBlock Text="Canvas help" FontWeight="SemiBold"/>
                  <TextBlock Text="F fits the AA canvas. Wheel zooms; Ctrl + wheel zooms faster. Middle drag or Space + left drag pans; Shift + arrow keys pan by a small step."
                             TextWrapping="Wrap"/>
                  <TextBlock Text="Click a Pad or drag empty space to select Pads; Ctrl+A selects all visible Pads. Alt + click prefers a regular Pad where CAD and regular overlap. Selecting a table row marks its artifact without moving the canvas. Details opens the selected artifact."
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
        </Border>
        <Grid Grid.Row="1" ClipToBounds="True">
          <controls:PadCanvas x:Name="CoordinatePadCanvas"
                              CadPads="{Binding CadPadsForCanvas}"
                              RegularPads="{Binding RegularPads}"
                              FitBoundsOverride="{Binding PreviewBounds}"
                              ShowCad="{Binding ShowCad}"
                              ShowRegular="{Binding ShowRegular}"
                              ShowAxisLabels="{Binding ShowRegularAxisLabels}"
                              HighlightUnmatched="{Binding HighlightUnmatched}"
                              HighlightFreeform="{Binding HighlightFreeform}"
                              RegularLineOpacity="{StaticResource CoordinatePlannerRegularLineOpacity}"
                              RegularFillOpacity="{StaticResource CoordinatePlannerRegularFillOpacity}"
                              Focusable="True"/>
          <Canvas x:Name="CoordinateOverlayCanvas"
                  ClipToBounds="True"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  IsHitTestVisible="True"/>
          <Canvas x:Name="CoordinateOverlayLabelCanvas"
                  ClipToBounds="True"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  IsHitTestVisible="False"/>
        </Grid>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="3"
                  Width="{StaticResource SplitterThickness}"
                  Background="{DynamicResource BrushBorder}"
                  HorizontalAlignment="Stretch"
                  ShowsPreview="True"/>
    <sections:CoordinatePlannerWorkspaceDetailsPaneView Grid.Column="4"/>
  </Grid>
</UserControl>
