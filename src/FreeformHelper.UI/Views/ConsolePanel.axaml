<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:converters="clr-namespace:FreeformHelper.UI.Converters"
             xmlns:logConsole="clr-namespace:Nvt.Core.Avalonia.LogConsole;assembly=Nvt.Core.Avalonia"
             mc:Ignorable="d"
             x:Class="FreeformHelper.UI.Views.ConsolePanel">
  <UserControl.Resources>
    <converters:BooleanGlyphConverter x:Key="ConsoleToggleGlyph"
                                      FalseGlyph="{x:Static icons:IconGlyphs.ExpandLess}"
                                      TrueGlyph="{x:Static icons:IconGlyphs.ExpandMore}"/>
  </UserControl.Resources>
  <Border x:Name="ConsoleBorder"
          Background="{DynamicResource BrushBgSurface}"
          BorderBrush="{DynamicResource BrushBorder}"
          BorderThickness="{StaticResource BorderTopThin}"
          Padding="{StaticResource ConsolePanelPadding}">
    <Grid RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
        <ToggleButton x:Name="ConsoleToggleButton"
                      Classes="actionIconButton panelChromeToggle"
                      IsChecked="{Binding IsConsoleExpanded, Mode=TwoWay}"
                      ToolTip.Tip="Toggle console panel"
                      VerticalAlignment="Center"
                      Grid.Column="0"
                      Margin="{StaticResource InsetRight8}">
          <controls:FontIcon Classes="consoleToggleIcon symbols"
                             Glyph="{Binding IsChecked,
                             RelativeSource={RelativeSource AncestorType=ToggleButton},
                             Converter={StaticResource ConsoleToggleGlyph}}"/>
        </ToggleButton>
        <logConsole:ConsoleHeader x:Name="ConsoleHeaderControl"
                                  Grid.Column="1"
                                  Controller="{Binding ConsoleSession.Controller}"
                                  CopySelectedCommand="{Binding ConsoleSession.Controller.CopySelectionCommand}"
                                  CopyVisibleCommand="{Binding ConsoleSession.CopyVisibleCommand}"
                                  SaveLogCommand="{Binding ConsoleSession.SaveLogCommand}"/>
      </Grid>

      <Grid Grid.Row="1"
            RowDefinitions="Auto,*"
            IsVisible="{Binding IsConsoleExpanded}">
        <logConsole:ConsoleToolbar Grid.Row="0"
                                   Controller="{Binding ConsoleSession.Controller}"/>
        <Border Grid.Row="1"
                Background="{DynamicResource BrushBgApp}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusXs}"
                Margin="{StaticResource InsetTop2}">
          <Grid>
            <logConsole:ConsoleListView x:Name="ConsoleList"
                                        Controller="{Binding ConsoleSession.Controller}"
                                        Projection="{Binding ConsoleSession.Controller.Projection}"
                                        ViewState="{Binding ConsoleSession.Controller.ViewState}"
                                        TimeOptions="{Binding ConsoleSession.Controller.Options}"
                                        TimeMode="{Binding ConsoleSession.Controller.Filter.TimeMode}"/>
            <logConsole:ConsoleEmptyState Controller="{Binding ConsoleSession.Controller}"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
