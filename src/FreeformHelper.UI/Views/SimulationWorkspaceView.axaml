<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
    xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
    xmlns:views="clr-namespace:FreeformHelper.UI.Views"
    mc:Ignorable="d"
    xmlns:sections="clr-namespace:FreeformHelper.UI.Views.WorkspaceSections"
    x:Class="FreeformHelper.UI.Views.SimulationWorkspaceView"
    Background="{DynamicResource BrushBgApp}"
    Foreground="{DynamicResource BrushTextPrimary}">
  <UserControl.Styles>
    <Style Selector="views|ConsolePanel.expanded">
      <Setter Property="Height" Value="{DynamicResource SimulationConsoleHeight}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*"
      MinHeight="0"
      MinWidth="0">
    <Grid Grid.Row="0"
        MinHeight="0"
        MinWidth="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource PanelLeftWidthGrid}"/>
        <ColumnDefinition Width="{StaticResource SplitterThicknessGrid}"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="{StaticResource SplitterThicknessGrid}"/>
        <ColumnDefinition Width="{StaticResource PanelRightWidthGrid}"/>
      </Grid.ColumnDefinitions>
      <sections:SimulationWorkspaceControlsPaneView Grid.Column="0"/>
      <GridSplitter Grid.Column="1"
          Width="{StaticResource SplitterThickness}"
          Background="{DynamicResource BrushBorder}"
          HorizontalAlignment="Stretch"
          ShowsPreview="True"/>
      <Border Grid.Column="2"
          Background="{DynamicResource BrushCanvasBackground}"
          MinHeight="0"
          MinWidth="0"
          ClipToBounds="True">
        <Grid x:Name="SimulationCenterGrid" MinHeight="0"
            MinWidth="0"
            ClipToBounds="True">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{StaticResource SplitterRowHeight}"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <sections:SimulationWorkspaceViewOptionsView Grid.Row="0"/>
          <Grid Grid.Row="1"
              MinHeight="{DynamicResource SimulationCanvasMinHeight}"
              MinWidth="0"
              ClipToBounds="True">
            <controls:PadCanvas x:Name="SimulationPadCanvas"
                CadPads="{Binding CadPads}"
                RegularPads="{Binding RegularPads}"
                ShowCad="{Binding ShowCad}"
                ShowRegular="{Binding ShowRegular}"
                HighlightUnmatched="{Binding HighlightUnmatched}"
                HighlightFreeform="{Binding HighlightFreeform}"
                SimulationRegularOverlayItems="{Binding SimulationOverlayItems}"
                ShowSimulationRegularOverlay="True"
                SimulationRegularOverlayColorMode="{Binding SelectedCanvasColorMode}"
                SimulationRegularOverlayViewMode="{Binding SelectedCanvasViewMode}"
                SimulationRegularOverlayThresholdValue="{Binding ColorThresholdValue}"
                ShowSimulationCopperPillar="{Binding IsCopperSource}"
                SimulationCopperCenterX="{Binding CopperCenterX}"
                SimulationCopperCenterY="{Binding CopperCenterY}"
                SimulationCopperDiameter="{Binding CopperDiameter}"
                SelectionChanged="SimulationPadCanvas_SelectionChanged"
                PointerPressed="SimulationPadCanvas_PointerPressed"
                PointerMoved="SimulationPadCanvas_PointerMoved"
                PointerExited="SimulationPadCanvas_PointerExited"
                KeyDown="SimulationPadCanvas_KeyDown"
                RegularPadActivated="SimulationPadCanvas_RegularPadActivated"
                Focusable="True"/>
            <Canvas x:Name="SimulationRiskOverlay" IsHitTestVisible="False" ClipToBounds="True">
              <Border x:Name="SimulationRiskMarker" IsVisible="False" BorderBrush="{DynamicResource BrushWarning}"
                  BorderThickness="{DynamicResource BorderInput}" CornerRadius="{DynamicResource RadiusXs}"/>
            </Canvas>
            <TextBlock x:Name="SimulationSelectionCount" Classes="workspaceSectionMeta" VerticalAlignment="Bottom" Margin="{DynamicResource Inset8}" IsHitTestVisible="False"/>
            <Canvas x:Name="SimulationInlineEditorOverlay"
                ClipToBounds="True"
                IsVisible="False">
              <Button x:Name="SimulationInlineEditAction" Classes="actionPrimary actionTextButton"
                  Content="Edit" Click="InlineEdit_Click" IsVisible="False"/>
              <Border x:Name="SimulationInlineEditorCard"
                  Classes="padInfoPanel"
                  IsVisible="False"
                  MaxWidth="{StaticResource ViewMenuPopupMaxWidth}">
                <StackPanel Spacing="{StaticResource Space8}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space6}">
                    <SelectableTextBlock Classes="padInfoTitle" Text="{Binding SelectedRegularHeaderText}"/>
                    <Button Grid.Column="1" Classes="actionGhost actionIconButton" ToolTip.Tip="Close manual editor" Click="InlineClose_Click">
                      <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.Close}"/>
                    </Button>
                  </Grid>
                  <controls:NumberScrubber x:Name="SimulationInlineEditorValueInput"
                      Minimum="{StaticResource NumericInputMinimum}"
                      Maximum="{StaticResource NumericInputMaximum}"
                      SmallChange="0.1"
                      FormatString="0.###"
                      SnapToStep="False"
                      Value="{Binding SelectedManualValue, Mode=TwoWay}"/>
                  <StackPanel x:Name="OverrideFooterActions" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Space8}">
                    <Button Classes="actionGhost actionTextButton simulationActionButton" Content="Use global"
                        ToolTip.Tip="Removes the override for this pad only." Command="{Binding ClearSelectedOverrideCommand}" IsEnabled="{Binding HasSelectedOverride}"/>
                    <Button Classes="actionPrimary actionTextButton simulationActionButton" Content="Apply override" Command="{Binding ApplySelectedOverrideCommand}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Canvas>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource InsetTop12Right16}" Spacing="{DynamicResource Space4}">
              <Button Classes="actionIconButton viewportOverlayAction" Command="{Binding FitCanvasCommand}" ToolTip.Tip="Fit AA canvas (F)">
                <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.FitScreen}"/>
              </Button>
              <ToggleButton x:Name="CanvasHelpToggle" Classes="actionGhost actionIconButton" ToolTip.Tip="Canvas help">
                <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.Info}"/>
              </ToggleButton>
              <Popup PlacementTarget="{Binding #CanvasHelpToggle}" IsOpen="{Binding #CanvasHelpToggle.IsChecked, Mode=TwoWay}" IsLightDismissEnabled="True">
                <Border Classes="workspaceSectionCard" MaxWidth="{DynamicResource ViewMenuPopupMaxWidth}">
                  <StackPanel Spacing="{DynamicResource Space8}">
                    <TextBlock Text="Canvas help" FontWeight="SemiBold"/>
                    <TextBlock Text="Click to inspect. Ctrl+click toggles selection; Shift+click selects a range. Double-click a Manual pad to edit it." TextWrapping="Wrap"/>
                    <TextBlock Text="F fits content. Ctrl+wheel zooms. Space+drag or middle-button drag pans. Alt+drag selects an area. Ctrl+A selects all; Shift+arrows extends selection." TextWrapping="Wrap"/>
                    <TextBlock Text="B Before / A After / D Delta / C Changed / V toggles Before/After." TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>
            <SelectableTextBlock Text="{Binding CanvasHintText}"
                IsVisible="{Binding HasCanvasHint}"
                Foreground="{DynamicResource BrushTextMuted}"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="{StaticResource IndexMappingReportMinWidth}"
                Margin="{StaticResource Inset24}"
                IsHitTestVisible="False"/>
          </Grid>
          <GridSplitter Grid.Row="2"
              HorizontalAlignment="Stretch"
              Background="{DynamicResource BrushBorder}"
              ResizeDirection="Rows"
              ShowsPreview="True"/>
          <StackPanel Grid.Row="3" MinHeight="{DynamicResource Space0}">
            <sections:SimulationWorkspacePlaybackView/>
            <sections:SimulationWorkspaceCopperReplayView x:Name="CopperReplayView"/>
            <views:ConsolePanel x:Name="SimulationConsole" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
          </StackPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3"
          Width="{StaticResource SplitterThickness}"
          Background="{DynamicResource BrushBorder}"
          HorizontalAlignment="Stretch"
          ShowsPreview="True"/>
      <sections:SimulationWorkspaceDetailsPaneView Grid.Column="4"/>
    </Grid>
  </Grid>
</UserControl>
