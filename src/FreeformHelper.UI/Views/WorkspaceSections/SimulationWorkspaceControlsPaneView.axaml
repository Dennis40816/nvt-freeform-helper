<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
    xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
    xmlns:viewModels="clr-namespace:FreeformHelper.UI.ViewModels"
    x:Class="FreeformHelper.UI.Views.WorkspaceSections.SimulationWorkspaceControlsPaneView">
  <Border Grid.Column="0"
      Classes="workspaceSidePane left">
    <ScrollViewer Classes="scrollDevCandidate viewportBoundScroll"
        MinHeight="0"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
      <Border Classes="viewportBoundContent"
          Padding="{StaticResource InsetRight12Bottom20}">
        <StackPanel Classes="panelForm"
            Spacing="{StaticResource Space14}">
          <StackPanel Spacing="{StaticResource Space6}">
            <SelectableTextBlock Text="Input" FontWeight="SemiBold"/>
            <SelectableTextBlock Text="{Binding InputPurposeText}"
                Foreground="{DynamicResource BrushTextMuted}"
                TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Spacing="{DynamicResource Space8}">
            <ComboBox
                ItemsSource="{Binding SourceOptions}"
                SelectedItem="{Binding SelectedInputSourceOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <SelectableTextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <controls:HidePanelBlock Title="Input contract" IsExpanded="False">
              <StackPanel Spacing="{DynamicResource Space4}">
                <SelectableTextBlock Text="{Binding InputContractTitleText}" FontWeight="SemiBold"/>
                <SelectableTextBlock Text="{Binding InputContractDetailText}" TextWrapping="Wrap"/>
              </StackPanel>
            </controls:HidePanelBlock>
            <StackPanel
                Classes="panelFormField"
                Spacing="{StaticResource Space6}"
                IsVisible="{Binding IsManualSource}">
              <SelectableTextBlock Text="Global value" FontWeight="SemiBold"/>
              <controls:NumberScrubber Minimum="{StaticResource NumericInputMinimum}"
                  Maximum="{StaticResource NumericInputMaximum}"
                  SmallChange="0.1"
                  FormatString="0.###"
                  SnapToStep="False"
                  Value="{Binding GlobalValue, Mode=TwoWay}"/>
              <TextBlock Classes="workspaceSectionMeta" Text="Keeps per-pad overrides."/>
              <StackPanel Spacing="{StaticResource Space4}">
                <SelectableTextBlock Text="Uniform presets" FontWeight="SemiBold"/>
                <TextBlock Text="Sets every pad and clears all overrides." Classes="workspaceSectionMeta" TextWrapping="Wrap"/>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="actionChip chipAction"
                      Margin="{StaticResource InsetRight6Bottom6}"
                      Command="{Binding ApplyManualPresetCommand}"
                      CommandParameter="400">
                    <Grid Classes="workspacePresetButtonContent"
                        ColumnDefinitions="Auto,*">
                      <controls:FontIcon Grid.Column="0"
                          Classes="symbols"
                          Glyph="{x:Static icons:IconGlyphs.AddCircle}"/>
                      <SelectableTextBlock Grid.Column="1"
                          Classes="workspacePresetButtonLabel"
                          Text="Uniform 400"/>
                    </Grid>
                  </Button>
                  <Button Classes="actionChip chipAction"
                      Margin="{StaticResource InsetRight6Bottom6}"
                      Command="{Binding ApplyManualPresetCommand}"
                      CommandParameter="360">
                    <Grid Classes="workspacePresetButtonContent"
                        ColumnDefinitions="Auto,*">
                      <controls:FontIcon Grid.Column="0"
                          Classes="symbols"
                          Glyph="{x:Static icons:IconGlyphs.AddCircle}"/>
                      <SelectableTextBlock Grid.Column="1"
                          Classes="workspacePresetButtonLabel"
                          Text="Uniform 360"/>
                    </Grid>
                  </Button>
                  <Button Classes="actionChip chipAction"
                      Margin="{StaticResource InsetRight6Bottom6}"
                      Command="{Binding ApplyManualPresetCommand}"
                      CommandParameter="0">
                    <Grid Classes="workspacePresetButtonContent"
                        ColumnDefinitions="Auto,*">
                      <controls:FontIcon Grid.Column="0"
                          Classes="symbols"
                          Glyph="{x:Static icons:IconGlyphs.AddCircle}"/>
                      <SelectableTextBlock Grid.Column="1"
                          Classes="workspacePresetButtonLabel"
                          Text="Zero"/>
                    </Grid>
                  </Button>
                </WrapPanel>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space8}">
                <TextBlock Text="{Binding RandomScopeText}" Classes="workspaceSectionMeta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Classes="actionGhost actionTextButton simulationActionButton" Content="Random"
                    Command="{Binding RandomizeVisibleValuesCommand}" IsEnabled="{Binding CanRandomizeVisibleValues}"/>
              </Grid>
              <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="{DynamicResource BorderTopThin}" Padding="{DynamicResource InsetTop8}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space8}">
                  <TextBlock Text="Clears overrides in every region." Classes="workspaceSectionMeta" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <Button Grid.Column="1" Classes="actionGhost actionTextButton simulationActionButton" Content="Clear all"
                      Command="{Binding ClearAllManualOverridesCommand}" IsEnabled="{Binding HasManualOverrides}"/>
                </Grid>
              </Border>
            </StackPanel>
            <StackPanel Spacing="{DynamicResource Space8}" IsVisible="{Binding IsCsvSource}">
              <Button HorizontalAlignment="Right" Classes="actionTextButton simulationActionButton" Classes.actionPrimary="{Binding !CanPlayFrames}" Classes.actionNeutral="{Binding CanPlayFrames}"
                  Content="Import CSV" Command="{Binding ImportCsvCommand}" IsEnabled="{Binding CanImportCsv}"/>
              <ItemsControl ItemsSource="{Binding CsvFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="workspaceFileRow" Margin="{StaticResource InsetBottom6}">
                      <Grid Classes="workspaceFileRowContent" ColumnDefinitions="Auto,*">
                        <controls:FontIcon Grid.Column="0"
                            Classes="symbols workspaceFileRowIcon"
                            Glyph="{x:Static icons:IconGlyphs.DataObject}"/>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}">
                          <SelectableTextBlock Classes="workspaceFileRowTitle" Text="{Binding FileName}"/>
                          <SelectableTextBlock Classes="workspaceFileRowMeta" Text="{Binding SummaryText}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding CsvCompatibilityText}" Classes="workspaceSectionMeta" TextWrapping="Wrap"/>
              <controls:HidePanelBlock Title="Format details" IsExpanded="False">
                <StackPanel Spacing="{DynamicResource Space4}">
                  <SelectableTextBlock Text="{Binding CsvProjectionContractText}" TextWrapping="Wrap"/>
                  <SelectableTextBlock Text="{Binding CsvInspectorShapeSummaryText}" IsVisible="{Binding HasCsvInspectorData}" TextWrapping="Wrap"/>
                </StackPanel>
              </controls:HidePanelBlock>
              <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="{DynamicResource BorderTopThin}" Padding="{DynamicResource InsetTop8}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space8}">
                  <TextBlock Text="Stops playback and removes every file." Classes="workspaceSectionMeta" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Classes="actionGhost actionTextButton simulationActionButton" Content="Clear CSV"
                      Command="{Binding ClearCsvCommand}" IsEnabled="{Binding HasCsvFiles}"/>
                </Grid>
              </Border>
            </StackPanel>
            <StackPanel
                Classes="panelFormField"
                Spacing="{StaticResource Space6}"
                IsVisible="{Binding IsCopperSource}">
              <SelectableTextBlock Text="Copper" FontWeight="SemiBold"/>
              <StackPanel Classes="panelFormField">
                <SelectableTextBlock Text="Contact model"/>
                <ComboBox ItemsSource="{Binding CopperContactModelOptions}"
                    SelectedItem="{Binding SelectedCopperContactModelOption, Mode=TwoWay}"
                    ToolTip.Tip="{Binding CopperContactModelSummaryText}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <SelectableTextBlock Text="{Binding Display}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" Classes="panelFormField left">
                  <SelectableTextBlock Text="Center X"/>
                  <controls:NumberScrubber Minimum="{StaticResource NumericInputMinimum}"
                      Maximum="{StaticResource NumericInputMaximum}"
                      SmallChange="0.1"
                      FormatString="0.###"
                      SnapToStep="False"
                      ToolTip.Tip="Copper center X in regular-grid world coordinates."
                      Value="{Binding CopperCenterX, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="panelFormField right">
                  <SelectableTextBlock Text="Center Y"/>
                  <controls:NumberScrubber Minimum="{StaticResource NumericInputMinimum}"
                      Maximum="{StaticResource NumericInputMaximum}"
                      SmallChange="0.1"
                      FormatString="0.###"
                      SnapToStep="False"
                      ToolTip.Tip="Copper center Y in regular-grid world coordinates."
                      Value="{Binding CopperCenterY, Mode=TwoWay}"/>
                </StackPanel>
              </Grid>
              <StackPanel Classes="panelFormField">
                <SelectableTextBlock Text="Diameter"/>
                <controls:NumberScrubber Minimum="0"
                    Maximum="{StaticResource NumericInputMaximum}"
                    SmallChange="0.1"
                    FormatString="0.###"
                    SnapToStep="False"
                    ToolTip.Tip="Copper pillar diameter in the same unit as the regular grid, usually mm."
                    Value="{Binding CopperDiameter, Mode=TwoWay}"/>
              </StackPanel>
              <TextBlock Text="Move the cursor on the canvas to move the copper." Classes="workspaceSectionMeta" TextWrapping="Wrap"/>
              <controls:HidePanelBlock Title="Full-pad signal and baseline" IsExpanded="False">
                <StackPanel Spacing="{DynamicResource Space8}">
                  <StackPanel Classes="panelFormField">
                    <SelectableTextBlock Text="Full-pad signal"/>
                    <controls:NumberScrubber Minimum="{StaticResource NumericInputMinimum}"
                        Maximum="{StaticResource NumericInputMaximum}"
                        SmallChange="1"
                        FormatString="0.###"
                        SnapToStep="False"
                        ToolTip.Tip="{Binding CopperContactModelSummaryText}"
                        Value="{Binding CopperPeakValue, Mode=TwoWay}"/>
                  </StackPanel>
                  <StackPanel Classes="panelFormField">
                    <SelectableTextBlock Text="Baseline"/>
                    <controls:NumberScrubber Minimum="{StaticResource NumericInputMinimum}"
                        Maximum="{StaticResource NumericInputMaximum}"
                        SmallChange="1"
                        FormatString="0.###"
                        SnapToStep="False"
                        ToolTip.Tip="Base diff added to every regular before copper overlap is applied."
                        Value="{Binding CopperBaselineValue, Mode=TwoWay}"/>
                  </StackPanel>
                </StackPanel>
              </controls:HidePanelBlock>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Border>
</UserControl>
