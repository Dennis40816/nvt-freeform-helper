<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
             xmlns:app="clr-namespace:FreeformHelper.Application.Services;assembly=FreeformHelper.Application"
             xmlns:sections="clr-namespace:FreeformHelper.UI.Views.WorkspaceSections"
             x:Class="FreeformHelper.UI.Views.WorkspaceSections.CoordinatePlannerWorkspaceDetailsPaneView"
             x:Name="TableView"
             x:DataType="vm:CoordinatePlannerWorkspaceViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ListStyles.axaml"/>
    <Style Selector="ListBox.coordinateArtifactList ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource Inset8_6}"/>
    </Style>
  </UserControl.Styles>
  <Border Classes="workspaceSidePane right">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Space10}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Space8}">
        <TextBlock Text="Coordinate table" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding ArtifactSummaryText}"
                   Classes="workspaceSectionMeta"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="2"
                Content="Columns / sort"
                Classes="actionGhost actionTextButton"
                ToolTip.Tip="{Binding ArtifactSortStatusText}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Pixel column"
                        ToggleType="CheckBox"
                        IsChecked="{Binding #TableView.ShowPixelColumn, Mode=TwoWay}"/>
              <MenuItem Header="Machine column"
                        ToggleType="CheckBox"
                        IsChecked="{Binding #TableView.ShowMachineColumn, Mode=TwoWay}"/>
              <Separator/>
              <MenuItem Header="{Binding ArtifactSortStatusText}" IsEnabled="False"/>
              <MenuItem Header="Sort: original order"
                        Command="{Binding SortArtifactRowsCommand}"
                        CommandParameter="Default"/>
              <MenuItem Header="Sort: Artifact" Command="{Binding SortArtifactRowsCommand}" CommandParameter="Label"/>
              <MenuItem Header="Sort: Kind / recipe"
                        Command="{Binding SortArtifactRowsCommand}"
                        CommandParameter="Kind"/>
              <MenuItem Header="Sort: Pixel" Command="{Binding SortArtifactRowsCommand}" CommandParameter="Pixel"/>
              <MenuItem Header="Sort: Machine"
                        Command="{Binding SortArtifactRowsCommand}"
                        CommandParameter="Machine"/>
              <MenuItem Header="Sort: Safe" Command="{Binding SortArtifactRowsCommand}" CommandParameter="Safe"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Space6}">
        <TextBlock Text="{Binding ArtifactSortStatusText}" Classes="workspaceSectionMeta"/>
        <Border Grid.Row="1" Classes="workspaceTableHeader">
          <Grid ColumnDefinitions="*,Auto,Auto,*" ColumnSpacing="{DynamicResource Space8}">
            <Button Classes="workspaceTableHeaderButton"
                    Command="{Binding SortArtifactRowsCommand}"
                    CommandParameter="Label"
                    Content="Artifact"/>
            <Button Grid.Column="1"
                    Classes="workspaceTableHeaderButton"
                    Command="{Binding SortArtifactRowsCommand}"
                    CommandParameter="Pixel"
                    Content="Pixel"
                    Width="{DynamicResource CoordinateTableOptionalColumnWidth}"
                    IsVisible="{Binding #TableView.ShowPixelColumn}"/>
            <Button Grid.Column="2"
                    Classes="workspaceTableHeaderButton"
                    Command="{Binding SortArtifactRowsCommand}"
                    CommandParameter="Machine"
                    Content="Machine"
                    Width="{DynamicResource CoordinateTableOptionalColumnWidth}"
                    IsVisible="{Binding #TableView.ShowMachineColumn}"/>
            <Button Grid.Column="3"
                    Classes="workspaceTableHeaderButton"
                    Command="{Binding SortArtifactRowsCommand}"
                    CommandParameter="Safe"
                    Content="Safe"
                    ToolTip.Tip="{Binding SafeCoordinatePolicyText}"/>
          </Grid>
        </Border>
        <ListBox Grid.Row="2"
                 x:Name="CoordinateArtifactList"
                 ItemsSource="{Binding ArtifactRows}"
                 SelectedItem="{Binding SelectedArtifactRow, Mode=TwoWay}"
                 Classes="scrollV2 workspaceDataList coordinateArtifactList"
                 Background="{DynamicResource BrushTransparent}"
                 BorderThickness="{DynamicResource BorderNone}"
                 ScrollViewer.AllowAutoHide="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:CoordinateArtifactRow">
              <Grid ColumnDefinitions="*,Auto,Auto,*" ColumnSpacing="{DynamicResource Space8}">
                <StackPanel Spacing="{DynamicResource Space2}">
                  <TextBlock Text="{Binding Label}"
                             Classes="workspaceDataCellText strong"
                             ToolTip.Tip="{Binding Label}"/>
                  <TextBlock Text="{Binding KindRecipeText}" Classes="workspaceDataCellText"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding PixelText}"
                           Classes="workspaceDataCellText"
                           ToolTip.Tip="{Binding PixelText}"
                           Width="{DynamicResource CoordinateTableOptionalColumnWidth}"
                           IsVisible="{Binding $parent[sections:CoordinatePlannerWorkspaceDetailsPaneView].ShowPixelColumn}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding MachineText}"
                           Classes="workspaceDataCellText"
                           ToolTip.Tip="{Binding MachineText}"
                           Width="{DynamicResource CoordinateTableOptionalColumnWidth}"
                           IsVisible="{Binding $parent[sections:CoordinatePlannerWorkspaceDetailsPaneView].ShowMachineColumn}"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding SafeMachineText}"
                           Classes="workspaceDataCellText"
                           ToolTip.Tip="{Binding SafeMachineText}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Border Grid.Row="2"
              BorderBrush="{DynamicResource BrushBorder}"
              BorderThickness="{DynamicResource BorderTopThin}"
              Padding="{DynamicResource InsetTop8}">
        <StackPanel x:Name="CoordinateFooterActions"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource Space6}">
          <Button Content="Details"
                  Classes="actionGhost actionTextButton"
                  IsEnabled="{Binding HasSelectedArtifact}"
                  Command="{Binding ShowArtifactDetailCommand}"
                  CommandParameter="{Binding SelectedArtifactRow}"/>
          <Button Content="Copy selected"
                  Classes="actionGhost actionTextButton"
                  IsEnabled="{Binding HasSelectedArtifact}"
                  Command="{Binding CopySelectedArtifactCommand}"
                  ToolTip.Tip="Copy the selected coordinate row."/>
          <Button Content="Copy all"
                  Classes="actionGhost actionTextButton"
                  Command="{Binding CopyAllArtifactsCommand}"
                  ToolTip.Tip="Copy all coordinate rows in table order."/>
          <Button Content="Export…"
                  Classes="actionPrimary actionTextButton"
                  ToolTip.Tip="Export CSV or JSON in table order.">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Export CSV…" Command="{Binding ExportArtifactsCsvCommand}"/>
                <MenuItem Header="Export JSON…" Command="{Binding ExportArtifactsJsonCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
