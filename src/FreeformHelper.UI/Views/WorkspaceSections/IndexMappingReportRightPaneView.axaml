<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:primitives="clr-namespace:Nvt.Core.Avalonia.Primitives;assembly=Nvt.Core.Avalonia"
             xmlns:viewModels="clr-namespace:FreeformHelper.UI.ViewModels"
             x:Class="FreeformHelper.UI.Views.WorkspaceSections.IndexMappingReportRightPaneView"
             x:DataType="viewModels:IndexMappingReportViewModel">
  <Border Classes="workspaceInspectorHost mappingInspector">
    <ScrollViewer Classes="scrollV2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="{DynamicResource Space8}">
        <StackPanel Spacing="{DynamicResource Space6}">
          <SelectableTextBlock Classes="workspaceInspectorSectionTitle" Text="Step rail"/>
          <ItemsControl ItemsSource="{Binding VerificationSteps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <primitives:BalancedWrapPanel ItemSpacing="{DynamicResource Space2}" LineSpacing="{DynamicResource Space2}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:IndexMappingVerificationStepNodeViewModel">
                <ToggleButton Classes="actionGhost flat" Classes.active="{Binding IsActive}"
                              Padding="{DynamicResource Inset6_2}"
                              IsChecked="{Binding IsActive, Mode=OneWay}" Content="{Binding Title}"
                              Command="{Binding $parent[UserControl].((viewModels:IndexMappingReportViewModel)DataContext).SelectVerificationStepCommand}"
                              CommandParameter="{Binding Step}">
                  <ToolTip.Tip>
                    <StackPanel Spacing="{DynamicResource Space2}">
                      <TextBlock Text="{Binding VerifyHint}" TextWrapping="WrapWithOverflow"/>
                      <TextBlock Text="{Binding StatusText}"/>
                      <TextBlock Text="{Binding KeyChecks}" TextWrapping="WrapWithOverflow"/>
                    </StackPanel>
                  </ToolTip.Tip>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Content="Sync filter with step" IsChecked="{Binding SyncFilterWithStepRail, Mode=TwoWay}"
                    ToolTip.Tip="When enabled, selecting a step rail node also switches the left-table filter to the preferred diagnostics mode for that step."/>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space6}">
          <StackPanel Spacing="{DynamicResource Space4}">
            <SelectableTextBlock Classes="workspaceInspectorSectionTitle" Text="{Binding SelectedMappingTargetText}"
                                 TextWrapping="WrapWithOverflow"/>
            <Border Classes="chipStatus" HorizontalAlignment="Left">
              <SelectableTextBlock Classes="chipStatusText" Text="{Binding SelectedDecision.StatusDisplay}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedDecision.StatusDisplay}"/>
            </Border>
          </StackPanel>
          <Button Grid.Column="1" Classes="actionGhost" Content="Locate" VerticalAlignment="Top"
                  Command="{Binding LocateSelectedIssueCommand}" IsEnabled="{Binding CanLocateSelectedDecision}"/>
        </Grid>
        <Border Classes="workspaceCodeBlock">
          <StackPanel Spacing="{DynamicResource Space4}">
            <SelectableTextBlock Classes="workspaceInspectorSectionTitle" Text="Impact"/>
            <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding ActiveStepImpactText}"
                                 TextWrapping="WrapWithOverflow"/>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
              ColumnSpacing="{DynamicResource Space8}" RowSpacing="{DynamicResource Space4}">
          <TextBlock Foreground="{DynamicResource BrushTextMuted}" Text="Source"/>
          <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedDecisionSourceText}" TextWrapping="WrapWithOverflow"/>
          <TextBlock Grid.Row="1" Foreground="{DynamicResource BrushTextMuted}" Text="Confidence"/>
          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDecisionConfidenceText}"/>
        </Grid>
        <controls:HidePanelBlock x:Name="EntityJourney" Title="Entity journey" DefaultExpanded="False" IsExpanded="False">
          <StackPanel Spacing="{DynamicResource Space4}">
            <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding SelectedDecisionSubtitleText}"
                                 TextWrapping="WrapWithOverflow"/>
            <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding SelectedJourneyText}"
                                 TextWrapping="WrapWithOverflow"/>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock x:Name="StepFields" Title="{Binding ActiveStepFieldsTitle}"
                                 DefaultExpanded="False" IsExpanded="False">
          <StackPanel Spacing="{DynamicResource Space6}">
            <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding ActiveStepCardStatusText}"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="{DynamicResource Space8}" RowSpacing="{DynamicResource Space6}">
              <TextBlock Text="IC" Foreground="{DynamicResource BrushTextMuted}"/>
              <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedDecision.IcDisplayText}"/>
              <TextBlock Grid.Row="1" Text="Diff" Foreground="{DynamicResource BrushTextMuted}"/>
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDecision.CurrentDisplay}"/>
              <TextBlock Grid.Row="2" Text="Input" Foreground="{DynamicResource BrushTextMuted}"/>
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveStepInputText}" TextWrapping="WrapWithOverflow"/>
              <TextBlock Grid.Row="3" Text="Decision" Foreground="{DynamicResource BrushTextMuted}"/>
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ActiveStepDecisionText}" TextWrapping="WrapWithOverflow"/>
              <TextBlock Grid.Row="4" Text="Output" Foreground="{DynamicResource BrushTextMuted}"/>
              <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActiveStepOutputText}" TextWrapping="WrapWithOverflow"/>
              <TextBlock Grid.Row="5" Text="Action" Foreground="{DynamicResource BrushTextMuted}"/>
              <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ActiveStepActionText}" TextWrapping="WrapWithOverflow"/>
            </Grid>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock x:Name="AdvancedDetails" Title="Advanced details" DefaultExpanded="False"
                                 IsExpanded="{Binding IsAlgorithmTraceExpanded, Mode=TwoWay}">
          <StackPanel Spacing="{DynamicResource Space6}">
            <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding Step4RawBestText}" IsVisible="{Binding IsStep4Active}"/>
            <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding Step4MaskedBestText}" IsVisible="{Binding IsStep4Active}"/>
            <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding Step4PassiveCompensationText}" IsVisible="{Binding IsStep4Active}"/>
            <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding Step4OffsetSupportText}" IsVisible="{Binding IsStep4Active}"/>
            <SelectableTextBlock Classes="workspaceInspectorContextText" Text="{Binding Step4CandidateAttributionTitle}" IsVisible="{Binding IsStep4Active}"/>
            <ItemsControl ItemsSource="{Binding Step4CandidateAttributionLines}" IsVisible="{Binding IsStep4Active}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <SelectableTextBlock Classes="workspaceInspectorContextText" Text="{Binding ., StringFormat='- {0}'}"
                                       TextWrapping="WrapWithOverflow"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <SelectableTextBlock Classes="workspaceInspectorContextText" Text="{Binding AlgorithmTraceStatusText}"/>
            <ItemsControl ItemsSource="{Binding AlgorithmTraceDetailEntries}" IsVisible="{Binding IsAlgorithmTraceReady}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:IndexMappingAlgorithmTraceEntryViewModel">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space6}">
                    <SelectableTextBlock Text="{Binding Label}" FontWeight="SemiBold" IsVisible="{Binding IsKey}"/>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="WrapWithOverflow"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </controls:HidePanelBlock>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
