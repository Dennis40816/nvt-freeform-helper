<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:viewModels="clr-namespace:FreeformHelper.UI.ViewModels"
             x:Class="FreeformHelper.UI.Views.WorkspaceSections.NotchExportSelectionRowsPaneView"
             x:DataType="viewModels:NotchExportSelectionViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://FreeformHelper.UI/Styles/ExportNotchRows.axaml"/>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource Space6}">
    <TextBlock Text="{Binding VisibleRowsSummaryText}"/>
    <Border Grid.Row="1" Classes="workspaceTableHeader">
      <Grid ColumnSpacing="{StaticResource Space6}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource NotchExportIntegratedCheckWidth}"/>
          <ColumnDefinition Width="{StaticResource NotchExportIntegratedRowWidth}"/>
          <ColumnDefinition Width="{StaticResource NotchExportIntegratedIcWidth}"/>
          <ColumnDefinition Width="{StaticResource NotchExportIntegratedDiffWidth}"/>
          <ColumnDefinition Width="{StaticResource NotchExportIntegratedMatchWidth}"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="{StaticResource NotchExportIntegratedStatusWidth}"/>
        </Grid.ColumnDefinitions>
        <CheckBox Classes="exportRowCheck" IsChecked="{Binding VisibleRowsSelection, Mode=TwoWay}"
                  IsEnabled="{Binding HasRows}" HorizontalAlignment="Center"
                  AutomationProperties.Name="Include all shown rows in export"
                  ToolTip.Tip="Include all shown rows in export"/>
        <Button Grid.Column="1" Classes="actionGhost flat" Padding="{StaticResource Inset2}" Classes.active="{Binding IsRowColumnFilterActive}"
                Tag="row" Click="OpenHeaderFilterButton_Click" ToolTip.Tip="Filter # values (Excel-style).">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <TextBlock Text="#"/><controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FilterAlt}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="actionGhost flat" Padding="{StaticResource Inset2}" Classes.active="{Binding IsIcColumnFilterActive}"
                Tag="ic" Click="OpenHeaderFilterButton_Click" ToolTip.Tip="Filter IC values (Excel-style).">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <TextBlock Text="IC"/><controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FilterAlt}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="actionGhost flat" Padding="{StaticResource Inset2}" Classes.active="{Binding IsDiffColumnFilterActive}"
                Tag="diff" Click="OpenHeaderFilterButton_Click" ToolTip.Tip="Filter Diff values (Excel-style).">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <TextBlock Text="Diff"/><controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FilterAlt}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Classes="actionGhost flat" Padding="{StaticResource Inset2}" Classes.active="{Binding IsMatchColumnFilterActive}"
                Tag="match" Click="OpenHeaderFilterButton_Click" ToolTip.Tip="Filter Combine values (Excel-style).">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <TextBlock Text="Combine"/><controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FilterAlt}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="5" Classes="actionGhost flat" Padding="{StaticResource Inset2}" Classes.active="{Binding IsMappingColumnFilterActive}"
                Tag="map" Click="OpenHeaderFilterButton_Click" ToolTip.Tip="Filter REG -> CAD values (Excel-style).">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <TextBlock Text="REG → CAD"/><controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FilterAlt}"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="6" Classes="actionGhost flat" Padding="{StaticResource Inset2}" Classes.active="{Binding IsStatusColumnFilterActive}"
                Tag="status" Click="OpenHeaderFilterButton_Click" ToolTip.Tip="Filter Status values (Excel-style).">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <TextBlock Text="Status"/><controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FilterAlt}"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <ListBox Grid.Row="2" Classes="scrollV2 notchExportRows"
             ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
             ScrollViewer.AllowAutoHide="False" ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="viewModels:NotchExportRowItemViewModel">
          <StackPanel Spacing="{StaticResource Space4}" ToolTip.Tip="Click to inspect · checkbox includes in export">
            <ContentControl Content="{Binding VisibleGroup}" IsVisible="{Binding HasVisibleGroup}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="viewModels:NotchExportIcGroupViewModel">
                  <Border Background="{DynamicResource BrushBgPanel}" Padding="{StaticResource Inset4}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Space6}">
                      <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource BrushTextPrimary}"/>
                      <TextBlock Grid.Column="1" Text="{Binding SummaryText}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource BrushTextMuted}"/>
                      <Button Grid.Column="2" Classes="actionGhost" Content="All shown"
                              Command="{Binding SelectAllGroupCommand}" ToolTip.Tip="Check visible rows in this IC only"/>
                      <Button Grid.Column="3" Classes="actionGhost" Content="None shown"
                              Command="{Binding SelectNoneGroupCommand}" ToolTip.Tip="Uncheck visible rows in this IC only"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <Grid ColumnSpacing="{StaticResource Space6}" PointerPressed="InspectRow_PointerPressed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource NotchExportIntegratedCheckWidth}"/>
                <ColumnDefinition Width="{StaticResource NotchExportIntegratedRowWidth}"/>
                <ColumnDefinition Width="{StaticResource NotchExportIntegratedIcWidth}"/>
                <ColumnDefinition Width="{StaticResource NotchExportIntegratedDiffWidth}"/>
                <ColumnDefinition Width="{StaticResource NotchExportIntegratedMatchWidth}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource NotchExportIntegratedStatusWidth}"/>
              </Grid.ColumnDefinitions>
              <CheckBox Classes="exportRowCheck" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        HorizontalAlignment="Center" ToolTip.Tip="Include in export"/>
              <TextBlock Grid.Column="1" Text="{Binding RowNumberText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="2" Text="{Binding IcText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding DiffText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="{Binding MatchSummaryText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="{Binding MappingText}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MappingText}"/>
              <TextBlock Grid.Column="6" Text="{Binding StatusText}" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="2" IsVisible="{Binding HasNoRows}" VerticalAlignment="Top"
            Background="{DynamicResource BrushBgPanel}" Padding="{StaticResource Inset12}">
      <StackPanel Spacing="{StaticResource Space4}">
        <TextBlock Text="No rows match the view filters."/>
        <TextBlock Classes="stepNote" Text="Use Reset filters above to show every row."/>
      </StackPanel>
    </Border>
    <Button Grid.Row="3" Classes="actionNeutral" Content="Replace selection with shown rows"
            IsVisible="{Binding HasRows}"
            HorizontalAlignment="Right" Command="{Binding UseShownOnlyCommand}"
            ToolTip.Tip="Unchecks every hidden row and checks the shown rows."/>
  </Grid>
</UserControl>
