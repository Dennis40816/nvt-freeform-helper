<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:viewModels="clr-namespace:FreeformHelper.UI.ViewModels"
             x:Class="FreeformHelper.UI.Views.WorkspaceSections.IndexMappingReportLeftPaneView"
             x:DataType="viewModels:IndexMappingReportViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Space6}">
    <Border Classes="workspaceTableHeader">
      <Grid Classes="mappingDecisionColumns" ColumnSpacing="{DynamicResource Space8}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{DynamicResource IndexMappingReportCadColumnWidth}"/>
          <ColumnDefinition Width="{DynamicResource IndexMappingReportRegColumnWidth}"/>
          <ColumnDefinition Width="{DynamicResource IndexMappingReportResultColumnWidth}"/>
          <ColumnDefinition Width="{DynamicResource IndexMappingReportReasonColumnWidth}"/>
        </Grid.ColumnDefinitions>
        <TextBlock Classes="workspaceTableHeaderText" Text="CAD"/>
        <TextBlock Grid.Column="1" Classes="workspaceTableHeaderText" Text="REG"/>
        <TextBlock Grid.Column="2" Classes="workspaceTableHeaderText" Text="Result"/>
        <TextBlock Grid.Column="3" Classes="workspaceTableHeaderText" Text="Reason"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <SelectableTextBlock Text="No CAD/REG entity rows under current filter."
                           Foreground="{DynamicResource BrushTextMuted}" IsVisible="{Binding HasNoDecisionRows}"/>
      <ListBox x:Name="DecisionList" Classes="scrollV2 workspaceDataList mappingDecisions"
               ItemsSource="{Binding DecisionRows}" SelectedItem="{Binding SelectedDecision, Mode=TwoWay}"
               IsVisible="{Binding HasDecisionRows}" Background="{DynamicResource BrushTransparent}"
               BorderThickness="{DynamicResource BorderNone}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="viewModels:IndexMappingDecisionRowViewModel">
            <Button Classes="actionGhost flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding $parent[UserControl].((viewModels:IndexMappingReportViewModel)DataContext).SelectDecisionCommand}"
                    CommandParameter="{Binding}">
              <Grid Classes="mappingDecisionColumns" ColumnSpacing="{DynamicResource Space8}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{DynamicResource IndexMappingReportCadColumnWidth}"/>
                  <ColumnDefinition Width="{DynamicResource IndexMappingReportRegColumnWidth}"/>
                  <ColumnDefinition Width="{DynamicResource IndexMappingReportResultColumnWidth}"/>
                  <ColumnDefinition Width="{DynamicResource IndexMappingReportReasonColumnWidth}"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{Binding CadDisplayText}" ToolTip.Tip="{Binding Title}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding RegularDisplayText}" ToolTip.Tip="{Binding RegularDisplayText}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding StatusDisplay}" ToolTip.Tip="{Binding StatusDisplay}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding DecisionReasonCodeText}" ToolTip.Tip="{Binding ReasonText}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <controls:HidePanelBlock x:Name="AggregateDiagnostics" Grid.Row="2" Title="{Binding AggregateDecisionTitle}"
                             DefaultExpanded="False" IsExpanded="False" IsVisible="{Binding HasAggregateDecisionRows}">
      <ScrollViewer Classes="scrollV2" MaxHeight="{DynamicResource IndexMappingReportAggregateMaxHeight}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{DynamicResource Space6}">
          <SelectableTextBlock Classes="workspaceSectionMeta" Text="{Binding AggregateDecisionSummaryText}"
                               TextWrapping="WrapWithOverflow"/>
          <ItemsControl ItemsSource="{Binding AggregateDecisionRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:IndexMappingDecisionRowViewModel">
                <Button Classes="actionGhost flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        ToolTip.Tip="{Binding ReasonText}"
                        Command="{Binding $parent[UserControl].((viewModels:IndexMappingReportViewModel)DataContext).SelectDecisionCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="1.4*,1*,*" ColumnSpacing="{DynamicResource Space8}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding DecisionReasonCodeText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding ActionHint}" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </controls:HidePanelBlock>
  </Grid>
</UserControl>
