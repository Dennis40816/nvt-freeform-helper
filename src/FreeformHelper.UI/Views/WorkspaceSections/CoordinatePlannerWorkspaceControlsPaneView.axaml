<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
             xmlns:sections="clr-namespace:FreeformHelper.UI.Views.WorkspaceSections"
             xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
             x:Class="FreeformHelper.UI.Views.WorkspaceSections.CoordinatePlannerWorkspaceControlsPaneView"
             x:DataType="vm:CoordinatePlannerWorkspaceViewModel"
             x:CompileBindings="True">
  <UserControl.Styles>
    <StyleInclude Source="avares://Nvt.Core.Avalonia/Panels/PanelsStyles.axaml"/>
  </UserControl.Styles>
  <Border Classes="workspaceSidePane left">
    <ScrollViewer Classes="scrollDevCandidate viewportBoundScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Border Classes="viewportBoundContent" Padding="{DynamicResource InsetRight12Bottom20}">
        <StackPanel Classes="panelForm" Spacing="{DynamicResource Space12}">
          <panels:CollapsiblePanel Title="Reference" IsExpanded="True">
            <StackPanel Spacing="{DynamicResource Space8}">
              <StackPanel Classes="panelFormField">
                <controls:SettingsInfoLabel Text="Preview layer"
                                            Tip="Controls only which CAD layer is displayed; AA outline selects the planning boundary."/>
                <ComboBox ItemsSource="{Binding LayerOptions}"
                          SelectedItem="{Binding SelectedLayerOption, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CoordinatePlannerWorkspaceViewModel+CoordinatePlannerCadLayerOption">
                      <TextBlock Text="{Binding Display}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Classes="panelFormField">
                <controls:SettingsInfoLabel Text="AA outline"
                                            Tip="Selects the source bounds used to plan coordinates."/>
                <ComboBox ItemsSource="{Binding AaBoundsOptions}"
                          SelectedItem="{Binding SelectedAaBoundsOption, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CoordinatePlannerWorkspaceViewModel+CoordinatePlannerBoundsOption">
                      <TextBlock Text="{Binding Display}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <SelectableTextBlock Text="{Binding ActiveAreaSourceSummaryText}"
                                   Classes="workspaceSectionMeta"
                                   TextWrapping="Wrap"/>
            </StackPanel>
          </panels:CollapsiblePanel>
          <sections:CoordinatePlannerGuidesSectionView/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space8}">
            <ToggleButton Content="BIST center rect"
                          Classes="actionGhost actionTextButton"
                          HorizontalContentAlignment="Left"
                          IsChecked="{Binding ShowBistRectangle, Mode=TwoWay}"/>
            <Border Grid.Column="1" Classes="chipStatus" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
                <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.Visibility}" IsVisible="{Binding HasBistRectangle}"/>
                <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.VisibilityOff}" IsVisible="{Binding !HasBistRectangle}"/>
                <TextBlock Text="{Binding BistGenerationStatusText}"/>
              </StackPanel>
            </Border>
          </Grid>
          <sections:CoordinatePlannerArraySectionView/>
          <sections:CoordinatePlannerCalibrationSectionView/>
          <sections:CoordinatePlannerCustomSectionView/>
          <sections:CoordinatePlannerCornerCircleSectionView/>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Border>
</UserControl>
