<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
             x:Class="FreeformHelper.UI.Views.WorkflowSteps.RightWorkflowStep2View">
    <panels:CollapsiblePanel x:Name="Step2Block" Title="Step 2 · Freeform tagging"
                             IsExpanded="{Binding IsStep2Expanded, Mode=TwoWay}">
      <panels:CollapsiblePanel.HeaderRight>
        <Button Tag="Step2FreeformTagging"
                Classes="actionIconButton actionGhost workflowStepAction" Click="OpenSettingsButton_Click"
                ToolTip.Tip="Open Settings at Step 2 section.">
          <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:IconGlyphs.Settings}"/>
        </Button>
      </panels:CollapsiblePanel.HeaderRight>
      <StackPanel Spacing="{StaticResource Space8}" HorizontalAlignment="Stretch">
        <SelectableTextBlock Classes="stepNote" Text="{Binding FreeformAutoDetectSummary}" TextWrapping="Wrap"/>
        <panels:CollapsiblePanel Title="Stats" IsExpanded="False" IsVisible="{Binding HasFreeformAutoDetectRows}">
          <StackPanel Spacing="{StaticResource Space6}">
            <Grid ColumnDefinitions="2*,Auto,Auto">
              <SelectableTextBlock Grid.Column="0"
                                   Text="Type"
                                   FontWeight="SemiBold"/>
              <SelectableTextBlock Grid.Column="1"
                                   Text="Count"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
              <SelectableTextBlock Grid.Column="2"
                                   Text="Ratio"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="{StaticResource InsetLeft10}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding FreeformAutoDetectRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="2*,Auto,Auto">
                    <SelectableTextBlock Grid.Column="0" Text="{Binding Type}"/>
                    <SelectableTextBlock Grid.Column="1"
                                         Text="{Binding CountText}"
                                         HorizontalAlignment="Right"/>
                    <SelectableTextBlock Grid.Column="2"
                                         Text="{Binding RatioText}"
                                         HorizontalAlignment="Right"
                                         Margin="{StaticResource InsetLeft10}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </panels:CollapsiblePanel>
        <SelectableTextBlock Text="Manual override · selected Regular" FontWeight="SemiBold"/>
        <SelectableTextBlock Classes="stepNote" Text="{Binding ManualOverrideHint}" TextWrapping="Wrap"/>
        <Grid Classes="panelActionRow"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="{StaticResource Space6}">
          <Button Grid.Column="0"
                  Content="None"
                  Command="{Binding SetFreeformNoneCommand}"
                  ToolTip.Tip="Mark selection as none."/>
          <Button Grid.Column="1"
                  Content="X"
                  Command="{Binding SetFreeformXCommand}"
                  ToolTip.Tip="Mark selection as X-way."/>
          <Button Grid.Column="2"
                  Content="Y"
                  Command="{Binding SetFreeformYCommand}"
                  ToolTip.Tip="Mark selection as Y-way."/>
          <Button Grid.Column="3"
                  Content="XY"
                  Command="{Binding SetFreeformXYCommand}"
                  ToolTip.Tip="Mark selection as XY-way."/>
        </Grid>
        <Separator/>
        <SelectableTextBlock Classes="stepNote" Text="Clears tagging and invalidates Steps 3 to 5 and validation." TextWrapping="Wrap"/>
        <Button Classes="actionTextButton actionDanger" Content="Clear result"
                HorizontalAlignment="Right" Command="{Binding ClearStep2ResultCommand}"
                ToolTip.Tip="Clears tagging and invalidates Steps 3 to 5 and validation."/>
      </StackPanel>
    </panels:CollapsiblePanel>
</UserControl>
