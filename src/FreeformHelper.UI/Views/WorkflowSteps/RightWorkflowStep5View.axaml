<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
             x:Class="FreeformHelper.UI.Views.WorkflowSteps.RightWorkflowStep5View">
    <panels:CollapsiblePanel x:Name="Step5Block" Title="Step 5 · Notch export"
                             IsExpanded="{Binding IsStep5Expanded, Mode=TwoWay}">
      <panels:CollapsiblePanel.HeaderRight>
        <Button Tag="Step5NotchExport"
                Classes="actionIconButton actionGhost workflowStepAction" Click="OpenSettingsButton_Click"
                ToolTip.Tip="Open Settings at Step 5 section.">
          <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:IconGlyphs.Settings}"/>
        </Button>
      </panels:CollapsiblePanel.HeaderRight>
      <StackPanel Spacing="{StaticResource Space8}" HorizontalAlignment="Stretch">
        <SelectableTextBlock Classes="stepNote" Text="{Binding NotchExportSummary}" TextWrapping="Wrap"/>
        <SelectableTextBlock Text="Handoff checklist" FontWeight="SemiBold" ToolTip.Tip="{Binding NotchExportHandoffChecklistText}"/>
        <SelectableTextBlock Text="{Binding NotchExportHandoffFileText}" ToolTip.Tip="{Binding NotchExportHandoffChecklistText}"/>
        <SelectableTextBlock Classes="stepNote" Text="{Binding NotchExportHandoffVersionText}"/>
        <SelectableTextBlock Classes="stepNote" Text="{Binding NotchExportHandoffProfileText}"/>
        <SelectableTextBlock Classes="stepNote" Text="Review export safety" ToolTip.Tip="{Binding NotchExportSafetyPolicySummary}"/>
        <SelectableTextBlock Classes="stepNote" Text="{Binding NotchEmsSafetyShortText}" ToolTip.Tip="{Binding NotchEmsSafetyPolicySummary}"/>
        <SelectableTextBlock Classes="stepNote" Text="Guard changes require a new export."/>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding NotchExportProgress}"
                     IsVisible="{Binding ShouldShowNotchExportProgress}" Height="{StaticResource Space6}"/>
        <SelectableTextBlock Classes="stepNote" IsVisible="{Binding ShouldShowNotchExportProgress}"
                             Text="{Binding NotchExportProgressText}"/>
        <Separator/>
        <SelectableTextBlock Classes="stepNote" Text="Clears the export result and Validation Quick Trace." TextWrapping="Wrap"/>
        <Button Classes="actionTextButton actionDanger" Content="Clear result"
                HorizontalAlignment="Right" Command="{Binding ClearStep5ResultCommand}"
                ToolTip.Tip="Clears the export result and Validation Quick Trace."/>
      </StackPanel>
    </panels:CollapsiblePanel>
</UserControl>
