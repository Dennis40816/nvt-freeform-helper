<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="using:Nvt.Core.Avalonia.Icons"
             xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
             xmlns:primitives="clr-namespace:Nvt.Core.Avalonia.Primitives;assembly=Nvt.Core.Avalonia"
             x:Class="FreeformHelper.UI.Views.WorkflowSteps.RightWorkflowStep3View">
    <panels:CollapsiblePanel x:Name="Step3Block" Title="Step 3 · Notch compensation"
                             IsExpanded="{Binding IsStep3Expanded, Mode=TwoWay}">
      <panels:CollapsiblePanel.HeaderRight>
        <Button Tag="Step3NotchCompensation"
                Classes="actionIconButton actionGhost workflowStepAction" Click="OpenSettingsButton_Click"
                ToolTip.Tip="Open Settings at Step 3 section.">
          <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:NvtIcons.Settings}"/>
        </Button>
      </panels:CollapsiblePanel.HeaderRight>
      <StackPanel Spacing="{StaticResource Space8}" HorizontalAlignment="Stretch">
        <SelectableTextBlock Classes="stepNote" Text="{Binding NotchEffectiveModelSummary}" TextWrapping="Wrap"/>
        <SelectableTextBlock Text="Export guards" FontWeight="SemiBold"
                             ToolTip.Tip="Changes apply immediately; generate a new export after editing."/>
        <WrapPanel ItemSpacing="{StaticResource Space2}" LineSpacing="{StaticResource Space4}"
                   ToolTip.Tip="{Binding NotchTargetCoverageGuardSummary}">
          <ToggleSwitch Classes="compact" AutomationProperties.Name="Target coverage cap"
                        IsChecked="{Binding EnableTargetCoverageGuard, Mode=TwoWay}" OnContent="" OffContent=""
                        VerticalAlignment="Center"/>
          <SelectableTextBlock Text="Target coverage cap" TextWrapping="Wrap" VerticalAlignment="Center"
                               Width="{DynamicResource WorkflowGuardLabelWidth}"/>
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space2}" VerticalAlignment="Center">
            <controls:NumberScrubber Minimum="0" Maximum="255" SmallChange="1" FormatString="0"
                                     Width="{StaticResource ButtonMinWidthSm}"
                                     IsEnabled="{Binding EnableTargetCoverageGuard}"
                                     Value="{Binding TargetCoverageCapPercent, Mode=TwoWay}"
                                     ToolTip.Tip="{Binding NotchTargetCoverageCapHelpText}"/>
            <SelectableTextBlock Grid.Column="1" Classes="stepNote" Text="%" VerticalAlignment="Center"/>
          </Grid>
        </WrapPanel>
        <WrapPanel ItemSpacing="{StaticResource Space2}" LineSpacing="{StaticResource Space4}"
                   ToolTip.Tip="{Binding NotchBoundaryVirtualAreaCapSummary}">
          <ToggleSwitch Classes="compact" AutomationProperties.Name="ToFull area cap"
                        IsChecked="{Binding EnableBoundaryVirtualAreaCap, Mode=TwoWay}" OnContent="" OffContent=""
                        VerticalAlignment="Center"/>
          <SelectableTextBlock Text="ToFull area cap" TextWrapping="Wrap" VerticalAlignment="Center"
                               Width="{DynamicResource WorkflowGuardLabelWidth}"/>
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space2}" VerticalAlignment="Center">
            <controls:NumberScrubber Minimum="0" Maximum="1000" SmallChange="10" FormatString="0.#"
                                     Width="{StaticResource ButtonMinWidthSm}"
                                     IsEnabled="{Binding EnableBoundaryVirtualAreaCap}"
                                     Value="{Binding BoundaryVirtualAreaCapPercent, Mode=TwoWay}"
                                     ToolTip.Tip="Maximum virtual To Full area relative to original overlap area."/>
            <SelectableTextBlock Grid.Column="1" Classes="stepNote" Text="% overlap" VerticalAlignment="Center"/>
          </Grid>
        </WrapPanel>
        <Separator/>
        <SelectableTextBlock Text="Preview" FontWeight="SemiBold"
                             ToolTip.Tip="Display only; stage and playback do not change export."/>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space8}">
          <Button Classes="actionIconButton actionGhost" Command="{Binding PreviousNotchPreviewStageCommand}"
                  IsEnabled="{Binding CanControlNotchPreviewStage}" ToolTip.Tip="Previous stage">
            <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:NvtIcons.ChevronLeft}"/>
          </Button>
          <SelectableTextBlock Grid.Column="1" Text="{Binding NotchPreviewStageSummary}"
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <Button Grid.Column="2" Classes="actionIconButton actionGhost" Command="{Binding NextNotchPreviewStageCommand}"
                  IsEnabled="{Binding CanControlNotchPreviewStage}" ToolTip.Tip="Next stage">
            <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:NvtIcons.ChevronRight}"/>
          </Button>
        </Grid>
        <primitives:BalancedWrapPanel ItemSpacing="{StaticResource Space8}" LineSpacing="{StaticResource Space4}"
                                      BalanceLastRow="False">
          <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space4}">
            <ToggleSwitch x:Name="AutoPlaySwitch" AutomationProperties.Name="Auto play" OnContent="" OffContent=""
                          IsEnabled="{Binding CanControlNotchPreviewStage}"
                          IsChecked="{Binding NotchPreviewAutoPlayEnabled, Mode=TwoWay}"/>
            <TextBlock Grid.Column="1" Text="Auto play" VerticalAlignment="Center"
                       IsEnabled="{Binding CanControlNotchPreviewStage}" PointerPressed="AutoPlayLabel_PointerPressed"/>
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space8}"
                ToolTip.Tip="Auto play interval; applies to canvas stage playback only.">
            <SelectableTextBlock Text="every" Classes="stepNote" VerticalAlignment="Center"/>
            <controls:NumberScrubber Minimum="200" Maximum="5000" SmallChange="100" FormatString="0"
                                     Grid.Column="1" Width="{StaticResource ButtonMinWidthSm}"
                                     IsEnabled="{Binding CanControlNotchPreviewStage}"
                                     Value="{Binding NotchPreviewAutoPlayIntervalMs, Mode=TwoWay}"/>
            <SelectableTextBlock Grid.Column="2" Text="ms" Classes="stepNote" VerticalAlignment="Center"/>
          </Grid>
        </primitives:BalancedWrapPanel>
        <panels:CollapsiblePanel Title="Allocation details"
                                 IsExpanded="{Binding IsStep3ToFullDetailsExpanded, Mode=TwoWay}">
          <StackPanel Spacing="{StaticResource Space4}">
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding NotchAllocationModelSummary}"
                                 TextWrapping="Wrap"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding NotchToRegularSemanticSummary}"
                                 TextWrapping="Wrap"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding NotchToFullSemanticSummary}"
                                 TextWrapping="Wrap"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding ToFullStrictOverlapPercent, StringFormat='Current strict overlap: {0:0.###}%'}"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding NotchToFullRuleEngineSummary}"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="Debug step: use stage arrows for fast To Full layer preview; display toggles are in the canvas toolbar and Settings > Step 3."/>
          </StackPanel>
        </panels:CollapsiblePanel>
        <Separator/>
        <Button Classes="actionDanger" Content="Clear preview"
                HorizontalAlignment="Right" Command="{Binding ClearStep3ResultCommand}"
                ToolTip.Tip="Clears preview and invalidates export and validation results."/>
      </StackPanel>
    </panels:CollapsiblePanel>
</UserControl>
