<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
             x:Class="FreeformHelper.UI.Views.WorkflowSteps.RightWorkflowStep3View">
    <panels:CollapsiblePanel x:Name="Step3Block" Title="Step 3 · Notch compensation"
                             IsExpanded="{Binding IsStep3Expanded, Mode=TwoWay}">
      <panels:CollapsiblePanel.HeaderRight>
        <Button Tag="Step3NotchCompensation"
                Classes="actionIconButton actionGhost workflowStepAction" Click="OpenSettingsButton_Click"
                ToolTip.Tip="Open Settings at Step 3 section.">
          <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:IconGlyphs.Settings}"/>
        </Button>
      </panels:CollapsiblePanel.HeaderRight>
      <StackPanel Spacing="{StaticResource Space8}" HorizontalAlignment="Stretch">
        <SelectableTextBlock Classes="stepNote" Text="{Binding NotchEffectiveModelSummary}" TextWrapping="Wrap"/>
        <SelectableTextBlock Text="Export-critical guards" FontWeight="SemiBold"/>
        <SelectableTextBlock Classes="stepNote" Text="{Binding NotchTargetCoverageGuardSummary}" TextWrapping="Wrap"/>
        <SelectableTextBlock Classes="stepNote" Text="{Binding NotchBoundaryVirtualAreaCapSummary}" TextWrapping="Wrap"/>
        <panels:CollapsiblePanel Title="Edit guards" IsExpanded="False">
          <StackPanel Spacing="{StaticResource Space8}">
            <SelectableTextBlock Classes="stepNote" Text="Changes apply immediately; generate a new export after editing." TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space8}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField">
                <SelectableTextBlock Text="Target coverage guard"/>
                <SelectableTextBlock Classes="stepNote"
                                     Text="{Binding NotchTargetCoverageGuardSummary}"
                                     TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding EnableTargetCoverageGuard, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Classes="panelFormField">
              <SelectableTextBlock Text="Target cap (%)"/>
              <controls:NumberScrubber Minimum="0"
                                       Maximum="255"
                                       SmallChange="1"
                                       FormatString="0"
                                       IsEnabled="{Binding EnableTargetCoverageGuard}"
                                       Value="{Binding TargetCoverageCapPercent, Mode=TwoWay}"
                                       ToolTip.Tip="{Binding NotchTargetCoverageCapHelpText}"/>
            </StackPanel>
            <Separator Margin="{StaticResource InsetTop2Bottom8}"/>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space8}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField">
                <SelectableTextBlock Text="Boundary virtual-area cap"/>
                <SelectableTextBlock Classes="stepNote"
                                     Text="{Binding NotchBoundaryVirtualAreaCapSummary}"
                                     TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding EnableBoundaryVirtualAreaCap, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Classes="panelFormField">
              <SelectableTextBlock Text="Virtual cap (%)"/>
              <controls:NumberScrubber Minimum="0"
                                       Maximum="1000"
                                       SmallChange="10"
                                       FormatString="0.#"
                                       IsEnabled="{Binding EnableBoundaryVirtualAreaCap}"
                                       Value="{Binding BoundaryVirtualAreaCapPercent, Mode=TwoWay}"
                                       ToolTip.Tip="Maximum virtual To Full area relative to original overlap area."/>
            </StackPanel>
          </StackPanel>
        </panels:CollapsiblePanel>
        <Separator/>
        <SelectableTextBlock Text="Preview" FontWeight="SemiBold"/>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space8}">
          <Button Classes="actionIconButton actionGhost" Command="{Binding PreviousNotchPreviewStageCommand}"
                  IsEnabled="{Binding CanControlNotchPreviewStage}" ToolTip.Tip="Previous stage">
            <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:IconGlyphs.ChevronLeft}"/>
          </Button>
          <SelectableTextBlock Grid.Column="1" Text="{Binding NotchPreviewStageSummary}"
                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <Button Grid.Column="2" Classes="actionIconButton actionGhost" Command="{Binding NextNotchPreviewStageCommand}"
                  IsEnabled="{Binding CanControlNotchPreviewStage}" ToolTip.Tip="Next stage">
            <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:IconGlyphs.ChevronRight}"/>
          </Button>
        </Grid>
        <CheckBox Content="Auto play" IsEnabled="{Binding CanControlNotchPreviewStage}"
                  IsChecked="{Binding NotchPreviewAutoPlayEnabled, Mode=TwoWay}"/>
        <SelectableTextBlock Classes="stepNote" Text="Display only; stage and playback do not change export."/>
        <panels:CollapsiblePanel Title="Play interval" IsExpanded="False">
          <StackPanel Classes="panelFormField">
            <controls:SettingsInfoLabel Text="Interval (ms)" Tip="Auto play interval; applies to canvas stage playback only."/>
            <controls:NumberScrubber Minimum="200" Maximum="5000" SmallChange="100" FormatString="0"
                                     IsEnabled="{Binding CanControlNotchPreviewStage}"
                                     Value="{Binding NotchPreviewAutoPlayIntervalMs, Mode=TwoWay}"/>
          </StackPanel>
        </panels:CollapsiblePanel>
        <panels:CollapsiblePanel Title="ToFull / allocation details"
                                 IsExpanded="{Binding IsStep3ToFullDetailsExpanded, Mode=TwoWay}">
          <StackPanel Spacing="{StaticResource Space4}">
            <SelectableTextBlock Text="ToFull / allocation details"
                                 FontWeight="SemiBold"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding NotchAllocationModelSummary}"
                                 TextWrapping="Wrap"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding NotchToRegularSemanticSummary}"
                                 TextWrapping="Wrap"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding NotchToFullSemanticSummary}"
                                 TextWrapping="Wrap"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding ToFullStrictOverlapPercent, StringFormat='Current strict overlap: {0:0.###}%'}"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="{Binding NotchToFullRuleEngineSummary}"/>
            <SelectableTextBlock Classes="stepNote"
                                 Text="Debug step: use stage arrows for fast To Full layer preview; display toggles are in the canvas toolbar and Settings > Step 3."/>
          </StackPanel>
        </panels:CollapsiblePanel>
        <Separator/>
        <SelectableTextBlock Classes="stepNote" Text="Clears preview and invalidates export and validation results." TextWrapping="Wrap"/>
        <Button Classes="actionTextButton actionDanger" Content="Clear preview"
                HorizontalAlignment="Right" Command="{Binding ClearStep3ResultCommand}"
                ToolTip.Tip="Clears preview and invalidates export and validation results."/>
      </StackPanel>
    </panels:CollapsiblePanel>
</UserControl>
