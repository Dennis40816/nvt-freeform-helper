<Window x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
        xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
        x:Class="FreeformHelper.UI.Views.DxfEditChangeListWindow"
        Width="{DynamicResource DxfEditChangeListWidth}"
        Height="{DynamicResource DxfEditChangeListHeight}"
        MinWidth="{DynamicResource DxfEditChangeListMinWidth}"
        MinHeight="{DynamicResource DxfEditChangeListMinHeight}"
        WindowStartupLocation="CenterOwner"
        IsEnabled="{Binding Editing.IsProjectEditingEnabled}"
        ShowInTaskbar="False"
        Background="{DynamicResource BrushBgSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        Title="DXF Edit Details">
  <Window.Styles>
    <StyleInclude Source="avares://FreeformHelper.UI/Styles/DxfEditDetails.axaml"/>
  </Window.Styles>
  <panels:WorkspaceShell Classes="dxfEditDetails"
                         x:DataType="vm:DxfEditChangeListViewModel" x:CompileBindings="True"
                         Subtitle="{Binding SubtitleText}"
                         LeftColumnWidth="{DynamicResource NotchExportMainLeftColumnWidth}"
                         RightColumnWidth="{DynamicResource DxfEditDetailsInspectorWidth}">
    <panels:WorkspaceShell.HeaderRight>
      <Button Classes="actionNeutral" Content="Refresh"
              Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh rows"/>
    </panels:WorkspaceShell.HeaderRight>
    <panels:WorkspaceShell.SummaryContent>
      <WrapPanel x:Name="CategorySwitches" Orientation="Horizontal">
        <ToggleButton Classes="actionGhost flat" Classes.active="{Binding IsHiddenKindSelected}"
                      IsChecked="{Binding IsHiddenKindSelected, Mode=OneWay}"
                      Content="{Binding HiddenCategoryText}" Command="{Binding SetHiddenKindCommand}"/>
        <ToggleButton Classes="actionGhost flat" Classes.active="{Binding IsDuplicateKindSelected}"
                      IsChecked="{Binding IsDuplicateKindSelected, Mode=OneWay}"
                      Content="{Binding DuplicateCategoryText}" Command="{Binding SetDuplicateKindCommand}"/>
        <ToggleButton Classes="actionGhost flat" Classes.active="{Binding IsCombinedKindSelected}"
                      IsChecked="{Binding IsCombinedKindSelected, Mode=OneWay}"
                      Content="{Binding CombinedCategoryText}" Command="{Binding SetCombinedKindCommand}"/>
        <ToggleButton Classes="actionGhost flat" Classes.active="{Binding IsMovedKindSelected}"
                      IsChecked="{Binding IsMovedKindSelected, Mode=OneWay}"
                      Content="{Binding MovedCategoryText}" Command="{Binding SetMovedKindCommand}"/>
        <ToggleButton Classes="actionGhost flat" Classes.active="{Binding IsRotatedKindSelected}"
                      IsChecked="{Binding IsRotatedKindSelected, Mode=OneWay}"
                      Content="{Binding RotatedCategoryText}" Command="{Binding SetRotatedKindCommand}"/>
      </WrapPanel>
    </panels:WorkspaceShell.SummaryContent>
    <panels:WorkspaceShell.LeftContent>
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Space8}">
        <Grid x:Name="BulkToolbar" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space8}">
          <TextBlock Text="{Binding SelectedVisibleRowsSummaryText}" VerticalAlignment="Center"
                     Classes="workspaceFilterResultText" TextWrapping="Wrap"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Space6}">
            <Button Classes="actionNeutral" Content="{Binding BulkActionCountText}"
                    Command="{Binding ApplySelectedEntriesCommand}"
                    IsEnabled="{Binding CanApplySelectedEntries}" IsVisible="{Binding IsSingleActionBulkMode}"
                    ToolTip.Tip="{Binding BulkActionToolTip}"/>
            <Button Classes="actionNeutral" Content="{Binding RestoreSelectedDuplicateCountText}"
                    Command="{Binding RestoreSelectedDuplicateEntriesCommand}"
                    IsEnabled="{Binding CanRestoreSelectedDuplicateEntries}" IsVisible="{Binding IsDuplicateBulkMode}"
                    ToolTip.Tip="{Binding RestoreSelectedDuplicateToolTip}"/>
            <Button Classes="actionNeutral" Content="{Binding RehideSelectedDuplicateCountText}"
                    Command="{Binding RehideSelectedDuplicateEntriesCommand}"
                    IsEnabled="{Binding CanRehideSelectedDuplicateEntries}" IsVisible="{Binding IsDuplicateBulkMode}"
                    ToolTip.Tip="{Binding RehideSelectedDuplicateToolTip}"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" x:Name="RowsHeader" Classes="workspaceTableHeader">
          <Grid ColumnSpacing="{DynamicResource Space8}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{DynamicResource NotchExportTableColCheckWidth}"/>
              <ColumnDefinition Width="{DynamicResource DxfEditDetailsPadColumnWidth}"/>
              <ColumnDefinition Width="{DynamicResource DxfEditDetailsChangeColumnWidth}"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding AreAllVisibleRowsSelected, Mode=TwoWay}"
                      IsEnabled="{Binding HasRows}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      ToolTip.Tip="Select all rows in this category (Ctrl+A)"
                      AutomationProperties.Name="Select all rows in this category"/>
            <TextBlock Grid.Column="1" Classes="workspaceTableHeaderText" Text="Pad"/>
            <TextBlock Grid.Column="2" Classes="workspaceTableHeaderText" Text="Change"/>
          </Grid>
        </Border>
        <Grid Grid.Row="2">
          <TextBlock x:Name="EmptyRowsHint" Text="No DXF edit rows in this scope."
                     IsVisible="{Binding HasNoRows}" Foreground="{DynamicResource BrushTextMuted}"
                     Margin="{DynamicResource Inset8}" TextWrapping="Wrap"/>
          <ListBox x:Name="RowsListBox" ItemsSource="{Binding Rows}" Classes="scrollV2 workspaceDataList"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" IsVisible="{Binding HasRows}"
                   Background="{DynamicResource BrushTransparent}" BorderThickness="{DynamicResource BorderNone}"
                   ScrollViewer.AllowAutoHide="False" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DxfEditChangeListEntry">
                <Button Classes="workspaceDataRow" Classes.workspaceDataRowActive="{Binding IsInspectorSelected}"
                        Command="{Binding $parent[Window].((vm:DxfEditChangeListViewModel)DataContext).SelectEntryCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnSpacing="{DynamicResource Space8}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{DynamicResource NotchExportTableColCheckWidth}"/>
                      <ColumnDefinition Width="{DynamicResource DxfEditDetailsPadColumnWidth}"/>
                      <ColumnDefinition Width="{DynamicResource DxfEditDetailsChangeColumnWidth}"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding RowTitleText}"/>
                    <StackPanel Grid.Column="1" Spacing="{DynamicResource Space2}">
                      <TextBlock Classes="workspaceDataCellText strong" Text="{Binding RowTitleText}"/>
                      <TextBlock Classes="workspaceDataCellText" Text="{Binding CurrentLayerText}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="workspaceDataCellText"
                               Text="{Binding ListDetailText}" ToolTip.Tip="{Binding DetailText}"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </panels:WorkspaceShell.LeftContent>
    <panels:WorkspaceShell.RightContent>
      <Border x:Name="Inspector" Classes="workspaceInspectorHost">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="{DynamicResource Space10}">
          <TextBlock Text="Inspector" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" x:Name="InspectorSelectionHint" Text="{Binding SelectedRowHeaderText}" TextWrapping="Wrap"/>
          <Border Grid.Row="2" Classes="chipStatus" IsVisible="{Binding HasSelectedEntry}">
            <TextBlock Classes="chipStatusText" Text="{Binding SelectedRowStatusText}" TextWrapping="Wrap"/>
          </Border>
          <Border Grid.Row="3" Classes="workspaceInspectorSection" IsVisible="{Binding HasSelectedEntry}">
            <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space4}">
              <TextBlock Classes="workspaceInspectorSectionTitle" Text="Detail"/>
              <ScrollViewer Grid.Row="1" x:Name="InspectorDetailScroll"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock Classes="workspaceInspectorValue" Text="{Binding SelectedRowDetailText}" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Grid>
          </Border>
          <StackPanel Grid.Row="4" x:Name="InspectorActions" Orientation="Horizontal"
                      HorizontalAlignment="Right" Spacing="{DynamicResource Space6}">
            <Button Classes="actionGhost actionIconButton" IsVisible="{Binding HasSelectedEntry}"
                    ToolTip.Tip="{Binding SelectedRowActionText}" AutomationProperties.Name="Quick action">
              <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.Info}"/>
            </Button>
            <Button Classes="actionGhost" Content="Focus"
                    Command="{Binding FocusSelectedEntryCommand}" IsEnabled="{Binding CanFocusSelectedEntry}"/>
            <Button Classes="actionPrimary" Content="{Binding SelectedRowActionLabelText}"
                    Command="{Binding ApplySelectedEntryCommand}" IsEnabled="{Binding CanApplySelectedEntry}"/>
          </StackPanel>
        </Grid>
      </Border>
    </panels:WorkspaceShell.RightContent>
    <panels:WorkspaceShell.FooterContent>
      <StackPanel x:Name="FooterActions" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Classes="actionNeutral" Content="Close" Command="{Binding CloseCommand}"/>
      </StackPanel>
    </panels:WorkspaceShell.FooterContent>
  </panels:WorkspaceShell>
</Window>
