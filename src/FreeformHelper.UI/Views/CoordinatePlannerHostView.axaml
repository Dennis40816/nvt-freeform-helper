<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:views="clr-namespace:FreeformHelper.UI.Views"
             xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
             x:Class="FreeformHelper.UI.Views.CoordinatePlannerHostView"
             x:DataType="vm:CoordinatePlannerHostViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource BrushBgApp}"
             Foreground="{DynamicResource BrushTextPrimary}">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="workspaceFirstPeekBar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource Space12}">
        <TextBlock Text="Coordinate" Classes="workspaceFirstPeekTitle" VerticalAlignment="Center"/>
        <Border Grid.Column="1"
                Classes="chipStatus"
                Classes.warning="{Binding IsWorkspaceStale}"
                ToolTip.Tip="{Binding SourceDimensionsTooltipText}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}">
            <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.Info}" IsVisible="{Binding !IsWorkspaceStale}"/>
            <controls:FontIcon Classes="symbols" Glyph="{x:Static icons:IconGlyphs.Warning}" IsVisible="{Binding IsWorkspaceStale}"/>
            <TextBlock Text="{Binding SourceStatusText}"/>
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="2"
                   Text="{Binding StaleWorkspaceBannerText}"
                   IsVisible="{Binding IsWorkspaceStale}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="3"
                x:Name="RefreshPlanButton"
                Content="Refresh"
                Classes="actionNeutral actionTextButton"
                IsVisible="{Binding IsWorkspaceStale}"
                ToolTip.Tip="{Binding StaleWorkspaceBannerText}"
                Command="{Binding OpenCoordinatePlannerCommand}"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding HasNoWorkspace}" Padding="{DynamicResource Inset24}">
      <StackPanel Spacing="{DynamicResource Space12}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="{DynamicResource IndexMappingReportMinWidth}">
        <TextBlock Text="{Binding PlaceholderTitle}" FontSize="{DynamicResource FontSizeXl}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding PlaceholderSubtitle}"
                   Foreground="{DynamicResource BrushTextMuted}"
                   TextWrapping="Wrap"/>
        <Button x:Name="BuildPlanButton"
                Content="Build from current workspace"
                HorizontalAlignment="Right"
                Classes="actionPrimary actionTextButton"
                Command="{Binding OpenCoordinatePlannerCommand}"
                IsEnabled="{Binding CanOpenCoordinatePlanner}"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding HasWorkspace}">
      <views:CoordinatePlannerWorkspaceView DataContext="{Binding CurrentWorkspace}"/>
    </Border>
  </Grid>
</UserControl>
