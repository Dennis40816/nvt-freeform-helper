<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             x:Class="FreeformHelper.UI.Views.SettingsSections.SettingsStep2SectionView">
  <StackPanel Classes="settingsPage">
    <Border Classes="settingsSectionBlock">
      <StackPanel Spacing="{StaticResource Space12}">
        <StackPanel Spacing="{StaticResource Space4}">
          <SelectableTextBlock Classes="settingsSectionTitle"
                               Text="Freeform tagging"/>
          <SelectableTextBlock Classes="settingsSectionMeta"
                               Text="Freeform thresholds and auto-replay behavior."/>
        </StackPanel>
        <Grid ColumnDefinitions="1*,1*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="{StaticResource Space12}"
              RowSpacing="{StaticResource Space12}">
          <Border Grid.Row="0"
                  Grid.Column="0"
                  Classes="settingsFieldTile">
            <StackPanel Classes="panelFormField">
              <controls:SettingsInfoLabel Text="Freeform TH (dominant axis ratio)" Tip="Dominant-axis ratio threshold used when Step 2 tags XWay, YWay, or XYWay."/>
              <controls:NumberScrubber Minimum="0"
                                       Maximum="1"
                                       SmallChange="0.01"
                                       FormatString="0.##"
                                       SnapToStep="False"
                                       Value="{Binding FreeformAxisThreshold, Mode=TwoWay}"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0"
                  Grid.Column="1"
                  Classes="settingsFieldTile">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space10}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField">
                <controls:SettingsInfoLabel Text="XY WAY EN" Tip="Allow Step 2 to detect X/Y freeform direction automatically."/>
                <SelectableTextBlock Classes="stepNote"
                                     Text="Detect X/Y direction automatically."
                                     TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding EnableAutoDetectXy, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="1"
                  Grid.Column="0"
                  Classes="settingsFieldTile">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space10}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField">
                <controls:SettingsInfoLabel Text="Edge spill EN" Tip="Enable edge-specific freeform rules for boundary spill cases."/>
                <SelectableTextBlock Classes="stepNote"
                                     Text="Use edge-specific freeform rules."
                                     TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding EnableFreeformEdgeSpecialization, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="1"
                  Grid.Column="1"
                  Classes="settingsFieldTile">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space10}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField">
                <controls:SettingsInfoLabel Text="Load auto-run Step 2" Tip="Replay Step 2 tagging automatically after a project is loaded."/>
                <SelectableTextBlock Classes="stepNote"
                                     Text="Replay tagging after project load."
                                     TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding AutoReplayStep2AfterProjectLoad, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
