<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:corePrimitives="using:Nvt.Core.Avalonia.Primitives"
             xmlns:icons="using:Nvt.Core.Avalonia.Icons"
             x:Class="FreeformHelper.UI.Views.SettingsSections.SettingsGeneralSectionView">
  <StackPanel Classes="settingsPage">
    <Border Classes="settingsSectionBlock">
      <StackPanel Spacing="{StaticResource Space12}">
        <Grid ColumnDefinitions="Auto,*,*,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="{StaticResource Space12}"
              RowSpacing="{StaticResource Space12}">
          <SelectableTextBlock Grid.Row="0"
                               Grid.Column="0"
                               Classes="settingsSectionTitle"
                               Text="IC"
                               ToolTip.Tip="Core setup · most projects start here."/>
          <StackPanel Grid.Row="0"
                      Grid.Column="1"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Cascade" Tip="Number of IC cascade blocks used to build the full regular grid."/>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space8}">
              <controls:NumberScrubber Grid.Column="0"
                                       Minimum="1"
                                       Maximum="{StaticResource NumericInputMaximum}"
                                       SmallChange="1"
                                       FormatString="0"
                                       Value="{Binding CascadeNum, Mode=TwoWay}"/>
              <Button Grid.Column="1"
                      Classes="actionIconButton actionGhost"
                      Click="EditCascadeDetailsButton_Click"
                      ToolTip.Tip="Edit per-IC X/Y channels.">
                <controls:FontIcon Classes="symbols iconSm"
                                   Glyph="{x:Static icons:NvtIcons.Edit}"/>
              </Button>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="0"
                      Grid.Column="2"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Total X channels" Tip="Computed from per-IC X channels in Cascade details."/>
            <Border Height="{StaticResource FormControlHeight}">
              <SelectableTextBlock Classes="settingsPassiveValue"
                                   VerticalAlignment="Center"
                                   Text="{Binding XChannels, StringFormat='{}{0:0}'}"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="0"
                      Grid.Column="3"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Total Y channels" Tip="Computed as the max Y channel count across Cascade details."/>
            <Border Height="{StaticResource FormControlHeight}">
              <SelectableTextBlock Classes="settingsPassiveValue"
                                   VerticalAlignment="Center"
                                   Text="{Binding YChannels, StringFormat='{}{0:0}'}"/>
            </Border>
          </StackPanel>
          <SelectableTextBlock Grid.Row="1"
                               Grid.Column="0"
                               Classes="settingsSectionTitle"
                               Text="Active area"
                               ToolTip.Tip="Core setup · most projects start here."/>
          <StackPanel Grid.Row="1"
                      Grid.Column="1"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="AA size X (mm)" Tip="Active-area width in millimeters for generated regular grid placement."/>
            <controls:NumberScrubber Minimum="0.1"
                                     Maximum="{StaticResource NumericInputMaximum}"
                                     SmallChange="0.0001"
                                     FormatString="0.####"
                                     SnapToStep="False"
                                     Value="{Binding ActiveAreaWidth, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Row="1"
                      Grid.Column="2"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="AA size Y (mm)" Tip="Active-area height in millimeters for generated regular grid placement."/>
            <controls:NumberScrubber Minimum="0.1"
                                     Maximum="{StaticResource NumericInputMaximum}"
                                     SmallChange="0.0001"
                                     FormatString="0.####"
                                     SnapToStep="False"
                                     Value="{Binding ActiveAreaHeight, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Grid.Column="1"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="AA pixels X" Tip="Optional. Panel pixel count across the AA width, for example 6480. Stored with the project. Nothing reads it yet. Leave 0 when unknown."/>
            <controls:NumberScrubber Minimum="0"
                                     Maximum="100000"
                                     SmallChange="1"
                                     FormatString="0"
                                     AutomationProperties.Name="AA pixels X"
                                     Value="{Binding ActiveAreaPixels.PixelsX, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Grid.Column="2"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="AA pixels Y" Tip="Optional. Panel pixel count across the AA height, for example 848. Stored with the project. Nothing reads it yet. Leave 0 when unknown."/>
            <controls:NumberScrubber Minimum="0"
                                     Maximum="100000"
                                     SmallChange="1"
                                     FormatString="0"
                                     AutomationProperties.Name="AA pixels Y"
                                     Value="{Binding ActiveAreaPixels.PixelsY, Mode=TwoWay}"/>
          </StackPanel>
          <SelectableTextBlock Grid.Row="2"
                               Grid.Column="3"
                               Classes="stepNote"
                               VerticalAlignment="Bottom"
                               IsVisible="{Binding ActiveAreaPixels.HasStatus}"
                               Text="{Binding ActiveAreaPixels.StatusText}"
                               TextWrapping="Wrap"/>
          <SelectableTextBlock Grid.Row="3"
                               Grid.Column="0"
                               Classes="settingsSectionTitle"
                               Text="Grid"
                               ToolTip.Tip="Core setup · most projects start here."/>
          <StackPanel Grid.Row="3"
                      Grid.Column="1"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Scan order" Tip="Diff-index numbering direction for the generated regular grid."/>
            <ComboBox ItemsSource="{Binding ScanOrderOptions}"
                      SelectedItem="{Binding SelectedScanOrderOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <SelectableTextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="3"
                      Grid.Column="2"
                      Grid.ColumnSpan="2"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Regular source" Tip="Choose generated regular grid or a DXF layer as the regular-pad source."/>
            <ComboBox ItemsSource="{Binding RegularSourceModeOptions}"
                      SelectedItem="{Binding SelectedRegularSourceModeOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <SelectableTextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="4"
                      Grid.Column="2"
                      Grid.ColumnSpan="2"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Regular layer" Tip="DXF layer used as regular geometry when Regular source is DXF layer."/>
            <ComboBox Classes="regularLayerSelector"
                      IsEnabled="{Binding IsDxfLayerRegularSource}"
                      ItemsSource="{Binding RegularSourceLayerOptions}"
                      SelectedItem="{Binding SelectedRegularSourceLayerOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <SelectableTextBlock Text="{Binding Display}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="4"
                      Grid.Column="1"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Grid padding (%)" Tip="Padding percentage applied when generating the regular grid inside the AA size."/>
            <controls:NumberScrubber Minimum="0"
                                     Maximum="50"
                                     SmallChange="1"
                                     FormatString="0"
                                     Value="{Binding GridPaddingPercent, Mode=TwoWay}"/>
          </StackPanel>
          <SelectableTextBlock Grid.Row="5"
                               Grid.Column="0"
                               Classes="settingsSectionTitle"
                               Text="Advanced"
                               ToolTip.Tip="Advanced mapping · adjust only for coordinate output or panel alignment."/>
          <StackPanel Grid.Row="5"
                      Grid.Column="1"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Coordinate pixel X" Tip="FW reported X-coordinate width used by Coordinate planning and export diagnostics; it does not change regular grid geometry or notch allocation."/>
            <controls:NumberScrubber Minimum="1"
                                     Maximum="{StaticResource NumericInputMaximum}"
                                     SmallChange="1"
                                     FormatString="0"
                                     Value="{Binding CoordinatePixelWidth, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Row="5"
                      Grid.Column="2"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Coordinate pixel Y" Tip="FW reported Y-coordinate height used by Coordinate planning and export diagnostics; it does not change regular grid geometry or notch allocation."/>
            <controls:NumberScrubber Minimum="1"
                                     Maximum="{StaticResource NumericInputMaximum}"
                                     SmallChange="1"
                                     FormatString="0"
                                     Value="{Binding CoordinatePixelHeight, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Row="6"
                      Grid.Column="1"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Panel bias X" Tip="Horizontal panel alignment offset used only in panel alignment mode."/>
            <controls:NumberScrubber Minimum="{StaticResource NumericInputMinimum}"
                                     Maximum="{StaticResource NumericInputMaximum}"
                                     SmallChange="0.0001"
                                     FormatString="0.####"
                                     SnapToStep="False"
                                     IsEnabled="{Binding IsPanelAlignment}"
                                     Value="{Binding PanelBiasX, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Row="6"
                      Grid.Column="2"
                      Classes="panelFormField settingsFieldTile"
                      VerticalAlignment="Bottom">
            <corePrimitives:InfoLabel Text="Panel bias Y" Tip="Vertical panel alignment offset used only in panel alignment mode."/>
            <controls:NumberScrubber Minimum="{StaticResource NumericInputMinimum}"
                                     Maximum="{StaticResource NumericInputMaximum}"
                                     SmallChange="0.0001"
                                     FormatString="0.####"
                                     SnapToStep="False"
                                     IsEnabled="{Binding IsPanelAlignment}"
                                     Value="{Binding PanelBiasY, Mode=TwoWay}"/>
          </StackPanel>
        </Grid>
        <SelectableTextBlock Classes="stepNote"
                             IsVisible="{Binding IsDxfLayerRegularSource}"
                             Text="{Binding DxfRegularSourceHint}"
                             TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Border Classes="settingsSectionBlock">
      <StackPanel Spacing="{StaticResource Space12}">
        <SelectableTextBlock Classes="settingsSectionTitle"
                             Text="Import and project behavior"
                             ToolTip.Tip="DXF import scope and project-load behavior."/>
        <Grid ColumnDefinitions="1*,1*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="{StaticResource Space12}"
              RowSpacing="{StaticResource Space12}">
          <Border Grid.Row="0"
                  Grid.Column="0"
                  Classes="settingsFieldTile">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space10}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField"
                          VerticalAlignment="Center">
                <corePrimitives:InfoLabel Text="Only closed polylines" Tip="Import only closed DXF polylines as CAD pads; open lines are ignored."/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding ImportOnlyClosedPolylines, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="0"
                  Grid.Column="1"
                  Classes="settingsFieldTile">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space10}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField"
                          VerticalAlignment="Center">
                <corePrimitives:InfoLabel Text="Import block polylines" Tip="Also scan polylines nested inside DXF BLOCK definitions."/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding ImportBlockPolylines, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="1"
                  Grid.Column="0"
                  Classes="settingsFieldTile">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space10}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField"
                          VerticalAlignment="Center">
                <corePrimitives:InfoLabel Text="Auto bounds from visible layers" Tip="Recompute DXF bounds from currently visible layers after layer filters change."/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding RecalcBoundsOnLayerFilter, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="1"
                  Grid.Column="1"
                  Classes="settingsFieldTile">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space10}">
              <StackPanel Grid.Column="0"
                          Classes="panelFormField"
                          VerticalAlignment="Center">
                <corePrimitives:InfoLabel Text="Apply visual preferences on load" Tip="After project load, keep project geometry but reapply app-level display preferences."/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            IsChecked="{Binding ApplyAppVisualPreferencesOnProjectLoad, Mode=TwoWay}"
                            OnContent=""
                            OffContent=""
                            MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="settingsSectionBlock">
      <StackPanel Spacing="{StaticResource Space12}">
        <SelectableTextBlock Classes="settingsSectionTitle"
                             Text="Application appearance"
                             ToolTip.Tip="Workspace display scale and generated grid alignment."/>
        <Grid ColumnDefinitions="1*,1*"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="{StaticResource Space12}"
              RowSpacing="{StaticResource Space12}">
          <Border Grid.Row="0"
                  Grid.Column="0"
                  Classes="settingsFieldTile">
            <StackPanel Classes="panelFormField">
              <corePrimitives:InfoLabel Text="Grid alignment mode" Tip="Controls how the generated regular grid is aligned to panel AA or CAD geometry."/>
              <ComboBox ItemsSource="{Binding GridAlignmentOptions}"
                        SelectedItem="{Binding SelectedGridAlignmentOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <SelectableTextBlock Text="{Binding Display}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>
          <Border Grid.Row="0"
                  Grid.Column="1"
                  Classes="settingsFieldTile">
            <StackPanel Classes="panelFormField">
              <corePrimitives:InfoLabel Text="Log level" Tip="Minimum log verbosity written to the app console and log file."/>
              <ComboBox ItemsSource="{Binding LogLevelOptions}"
                        SelectedItem="{Binding SelectedLogLevelOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <SelectableTextBlock Text="{Binding Display}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>
          <Border Grid.Row="1"
                  Grid.Column="0"
                  Classes="settingsFieldTile">
            <StackPanel Classes="panelFormField">
              <corePrimitives:InfoLabel Text="Global font size (%)" Tip="Scales UI text across the app; project geometry is unchanged."/>
              <controls:NumberScrubber Minimum="80"
                                       Maximum="140"
                                       SmallChange="1"
                                       FormatString="0"
                                       Value="{Binding GlobalFontSizePercent, Mode=TwoWay}"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1"
                  Grid.Column="1"
                  Classes="settingsFieldTile">
            <StackPanel Classes="panelFormField">
              <corePrimitives:InfoLabel Text="Highlight line width adjust" Tip="Extra stroke width for selected or highlighted pads on canvas."/>
              <controls:NumberScrubber Minimum="-2"
                                       Maximum="4"
                                       SmallChange="0.1"
                                       FormatString="0.0#"
                                       Value="{Binding HighlightStrokeWidthAdjust, Mode=TwoWay}"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Classes="settingsFieldTile">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="{StaticResource Space12}">
              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          Spacing="{StaticResource Space8}"
                          VerticalAlignment="Center">
                <ToggleSwitch x:Name="SizingScopeSwitch"
                              IsChecked="{Binding UseLocalSizing, Mode=TwoWay}"
                              AutomationProperties.Name="Sizing scope"
                              VerticalAlignment="Center"/>
                <TextBlock PointerReleased="SizingScopeText_PointerReleased" Text="Local"
                           IsVisible="{Binding UseLocalSizing}"
                           VerticalAlignment="Center"/>
                <TextBlock PointerReleased="SizingScopeText_PointerReleased" Text="Global"
                           IsVisible="{Binding !UseLocalSizing}"
                           VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Classes="panelFormField"
                          VerticalAlignment="Center">
                <corePrimitives:InfoLabel Text="Sizing scope" Tip="Local adjusts selected rows or columns; Global redistributes the whole generated grid."/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="settingsSectionBlock"
            IsVisible="{Binding HasLayerCategoryRows}">
      <StackPanel Spacing="{StaticResource Space12}">
        <SelectableTextBlock Classes="settingsSectionTitle"
                             Text="Layer categories"
                             ToolTip.Tip="Batch toggle DXF layers by parsed content category."/>
        <ItemsControl ItemsSource="{Binding LayerCategoryRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="settingsFieldTile"
                      Margin="{StaticResource InsetBottom6}">
                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Row="0"
                              Grid.Column="0"
                              Grid.RowSpan="2"
                              Spacing="{StaticResource Space2}">
                    <SelectableTextBlock Text="{Binding Display}"
                                         FontWeight="SemiBold"/>
                    <SelectableTextBlock Text="{Binding Description}"
                                         Classes="stepNote"
                                         TextWrapping="Wrap"/>
                    <SelectableTextBlock Text="{Binding Summary}"
                                         Classes="stepNote"
                                         TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Classes="actionNeutral" Grid.Row="0"
                          Grid.Column="1"
                          Margin="{StaticResource InsetRight8}"
                          Content="On"
                          Command="{Binding EnableCommand}"/>
                  <Button Classes="actionNeutral" Grid.Row="0"
                          Grid.Column="2"
                          Content="Off"
                          Command="{Binding DisableCommand}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
