<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:corePrimitives="using:Nvt.Core.Avalonia.Primitives"
             x:Class="FreeformHelper.UI.Views.SettingsSections.SettingsStep3SectionView">
  <StackPanel Classes="panelForm settingsPage">
    <Border Classes="settingsSectionBlock">
      <StackPanel Spacing="{StaticResource Space8}">
        <StackPanel Classes="panelFormField">
          <corePrimitives:InfoLabel Text="Compensation model" Tip="Select the Step 3 compensation model that drives To Regular and To Full behavior. Single source of truth for Step 3 behavior."/>
          <ComboBox ItemsSource="{Binding NotchCompensationModelOptions}"
                    SelectedItem="{Binding SelectedNotchCompensationModelOption, Mode=TwoWay}"
                    ToolTip.Tip="{Binding NotchCompensationModelSummary}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <SelectableTextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <WrapPanel ItemSpacing="{StaticResource Space8}"
                   LineSpacing="{StaticResource Space8}">
          <Border Classes="chipStatus">
            <SelectableTextBlock Classes="chipStatusText"
                                 Text="{Binding NotchEffectiveModelSummary}"/>
          </Border>
          <Border Classes="chipStatus">
            <SelectableTextBlock Classes="chipStatusText"
                                 Text="{Binding NotchEmsSafetyShortText}"/>
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="settingsSectionBlock">
      <StackPanel Spacing="{StaticResource Space8}">
        <SelectableTextBlock Classes="settingsSectionTitle"
                             Text="Signal semantics"/>
        <WrapPanel ItemSpacing="{StaticResource Space8}"
                   LineSpacing="{StaticResource Space8}">
          <Border Classes="chipStatus">
            <SelectableTextBlock Classes="chipStatusText"
                                 Text="{Binding NotchAllocationModelShortText}"/>
          </Border>
          <Border Classes="chipStatus"
                  ToolTip.Tip="To Regular meaning: Restore area signal before redistribution.">
            <SelectableTextBlock Classes="chipStatusText"
                                 Text="{Binding NotchToRegularShortText}"/>
          </Border>
          <Border Classes="chipStatus"
                  ToolTip.Tip="To Full meaning: To Full expands pads into reachable free area. Expand into free area; cap impossible expansion.">
            <SelectableTextBlock Classes="chipStatusText"
                                 Text="{Binding NotchToFullShortText}"/>
          </Border>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Classes="settingsSectionBlock">
      <StackPanel Spacing="{StaticResource Space12}">
        <SelectableTextBlock Classes="settingsSectionTitle"
                             Text="Advanced allocation gates"
                             ToolTip.Tip="Compute gates and diagnostic trace controls."/>
        <Grid ColumnDefinitions="1*,1*"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="{StaticResource Space12}"
              RowSpacing="{StaticResource Space12}">
          <StackPanel Grid.Row="0"
                      Grid.Column="0"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="To Regular EN (derived)" Tip="Derived from the selected compensation model; restores area-proportional signal before redistribution."/>
            <ToggleSwitch Classes="settingsColumnSwitch"
                          IsEnabled="False"
                          IsChecked="{Binding EnableToRegular, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                          Height="{StaticResource FormControlHeight}"
                          HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Grid.Row="0"
                      Grid.Column="1"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="To Full EN (derived)" Tip="Derived from the selected compensation model; enables To Full expansion."/>
            <ToggleSwitch Classes="settingsColumnSwitch"
                          IsEnabled="False"
                          IsChecked="{Binding EnableToFull, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                          Height="{StaticResource FormControlHeight}"
                          HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Grid.Row="1"
                      Grid.Column="0"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="Multi-owner strict overlap (%)" Tip="To Full ignores overlaps and free areas below this ratio. A smaller target share is ignored unless To Full applies to it. Blocking does not use this value. Higher ignores smaller overlaps."/>
            <controls:NumberScrubber Minimum="0"
                                     Maximum="100"
                                     SmallChange="0.1"
                                     FormatString="0.###"
                                     SnapToStep="False"
                                     Value="{Binding ToFullStrictOverlapPercent, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Grid.Column="0"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="Use To Full rule engine" Tip="ON uses the newer centralized To Full gate engine; OFF falls back to the legacy inline gate path."/>
            <ToggleSwitch Classes="settingsColumnSwitch"
                          IsChecked="{Binding EnableToFullRuleEngine, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                          Height="{StaticResource FormControlHeight}"
                          HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Grid.Column="1"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="Keep To Full trace" Tip="Store per-regular To Full rule decisions for diagnostics and runtime query payloads. Adds diagnostics only; notch output is unchanged."/>
            <ToggleSwitch Classes="settingsColumnSwitch"
                          IsEnabled="{Binding EnableToFullRuleEngine}"
                          IsChecked="{Binding EnableToFullRuleTrace, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                          Height="{StaticResource FormControlHeight}"
                          HorizontalAlignment="Left"/>
          </StackPanel>
        </Grid>
        <SelectableTextBlock Classes="stepNote"
                             Text="{Binding ToFullRuleEngineSummary}"/>
      </StackPanel>
    </Border>

    <Border Classes="settingsSectionBlock">
      <StackPanel Spacing="{StaticResource Space12}">
        <SelectableTextBlock Classes="settingsSectionTitle"
                             Text="AA preview display"
                             ToolTip.Tip="Display-only diagnostics; generated notch rows are unchanged. Preview switches do not change computation."/>
        <Grid ColumnDefinitions="1*,1*"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="{StaticResource Space12}"
              RowSpacing="{StaticResource Space12}">
          <StackPanel Grid.Row="0"
                      Grid.Column="0"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="Stage auto play" Tip="Loop the Step 3 preview layers automatically in the AA canvas."/>
            <ToggleSwitch Classes="settingsColumnSwitch"
                          IsChecked="{Binding NotchPreviewAutoPlayEnabled, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                          Height="{StaticResource FormControlHeight}"
                          HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Grid.Row="0"
                      Grid.Column="1"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="Interval (ms)" Tip="Delay between Step 3 preview layers during auto play."/>
            <controls:NumberScrubber Minimum="200"
                                     Maximum="5000"
                                     SmallChange="100"
                                     FormatString="0"
                                     Value="{Binding NotchPreviewAutoPlayIntervalMs, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Row="1"
                      Grid.Column="0"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="Show To Regular labels" Tip="Display To Regular ratio labels on the Step 3 preview canvas only."/>
            <ToggleSwitch Classes="settingsColumnSwitch"
                          IsChecked="{Binding ShowNotchToRegularLabels, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                          Height="{StaticResource FormControlHeight}"
                          HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Grid.Row="1"
                      Grid.Column="1"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="Show To Full overlay" Tip="Display To Full support stages on the Step 3 preview canvas only."/>
            <ToggleSwitch Classes="settingsColumnSwitch"
                          IsChecked="{Binding ShowNotchCanvasPreview, Mode=TwoWay}"
                          OnContent=""
                          OffContent=""
                          MinWidth="{StaticResource ViewMenuSwitchMinWidth}"
                          Height="{StaticResource FormControlHeight}"
                          HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Grid.Column="0"
                      Classes="panelFormField">
            <corePrimitives:InfoLabel Text="To Full layer stage" Tip="Choose the To Full preview layer: seed, candidate, or final support result."/>
            <controls:NumberScrubber Minimum="1"
                                     Maximum="3"
                                     SmallChange="1"
                                     FormatString="0"
                                     Value="{Binding NotchPreviewVisualizationStep, Mode=TwoWay}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
