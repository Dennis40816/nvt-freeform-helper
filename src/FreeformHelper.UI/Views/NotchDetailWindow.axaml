<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FreeformHelper.UI.Views" xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
        x:Class="FreeformHelper.UI.Views.NotchDetailWindow" x:DataType="vm:NotchDetailViewModel" x:CompileBindings="True"
        Width="{DynamicResource NotchDetailWidth}" Height="{DynamicResource NotchDetailHeight}"
        MinWidth="{DynamicResource NotchDetailMinWidth}" MinHeight="{DynamicResource NotchDetailMinHeight}"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource NfcSurfaceBrush}"
        Foreground="{DynamicResource NfcTextBrush}" Title="Notch detail">
  <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Padding="{DynamicResource NotchExplanationWindowInset}">
      <views:NotchDetailContent x:Name="DetailContent"/>
    </Border>
  </ScrollViewer>
</Window>
