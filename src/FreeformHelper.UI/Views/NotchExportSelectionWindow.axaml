<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
        xmlns:primitives="clr-namespace:Nvt.Core.Avalonia.Primitives;assembly=Nvt.Core.Avalonia"
        xmlns:viewModels="clr-namespace:FreeformHelper.UI.ViewModels"
        xmlns:sections="clr-namespace:FreeformHelper.UI.Views.WorkspaceSections"
        x:Class="FreeformHelper.UI.Views.NotchExportSelectionWindow"
        x:DataType="viewModels:NotchExportSelectionViewModel"
        Width="{StaticResource NotchExportSelectionWidth}"
        Height="{StaticResource NotchExportSelectionHeight}"
        MinWidth="{StaticResource NotchExportSelectionMinWidth}"
        MinHeight="{StaticResource NotchExportSelectionMinHeight}"
        WindowStartupLocation="CenterOwner"
        IsEnabled="{Binding Editing.IsProjectEditingEnabled}"
        Opacity="{StaticResource NotchExportSelectionOpacity}"
        Background="{DynamicResource BrushBgSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        Title="Export Notch Rows">
  <Window.Styles>
    <StyleInclude Source="avares://FreeformHelper.UI/Styles/ExportNotchRows.axaml"/>
  </Window.Styles>
  <panels:WorkspaceShell Classes="exportRows"
                         Subtitle="Check the rows to export, then press Export."
                         LeftColumnWidth="{StaticResource NotchExportMainLeftColumnWidth}"
                         RightColumnWidth="{StaticResource NotchExportIntegratedInspectorWidth}">
    <panels:WorkspaceShell.HeaderRight>
      <StackPanel Spacing="{StaticResource Space4}">
        <Grid ColumnDefinitions="Auto,Auto">
          <StackPanel Classes="panelFormField left" IsVisible="{Binding HasExportTypeOptions}">
            <TextBlock Classes="stepNote" Text="Export format"/>
            <ComboBox ItemsSource="{Binding ExportTypeOptions}"
                      Width="{StaticResource NotchExportTopDropdownWidth}"
                      IsEnabled="{Binding CanSelectExportType}"
                      SelectedItem="{Binding SelectedExportTypeOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:FreeformHelperViewModel+NotchExportFileTypeOption">
                  <TextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Classes="panelFormField right" IsVisible="{Binding HasVersionOptions}">
            <TextBlock Classes="stepNote" Text="Notch version"
                       ToolTip.Tip="Single-version choice is saved with the next Save Project."/>
            <ComboBox ItemsSource="{Binding VersionOptions}"
                      Width="{StaticResource NotchExportIntegratedVersionWidth}"
                      IsEnabled="{Binding CanSelectVersion}"
                      SelectedItem="{Binding SelectedVersionOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:NotchExportVersionOption">
                  <TextBlock Text="{Binding Display}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        <TextBlock Text="Version is set by Export format" HorizontalAlignment="Right"
                   IsVisible="{Binding IsVersionSelectionPinnedByExportType}"/>
      </StackPanel>
    </panels:WorkspaceShell.HeaderRight>
    <panels:WorkspaceShell.SummaryContent>
      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"
                  ToolTip.Tip="Counts: rows in the current version scope matching each category.">
        <ToggleButton Classes="actionGhost flat" Content="Selected only"
                      IsChecked="{Binding IsSelectedOnlyActive, Mode=OneWay}"
                      Command="{Binding ToggleSelectedOnlyCommand}"/>
        <ToggleButton Classes="actionGhost flat" Content="{Binding LinkedFilterText}"
                      IsChecked="{Binding IsFilterLinkedOnly, Mode=OneWay}"
                      Command="{Binding SetViewFilterModeCommand}"
                      CommandParameter="{x:Static viewModels:NotchExportRowDisplayMode.LinkedOnly}"/>
        <ToggleButton Classes="actionGhost flat" Content="{Binding TransferFilterText}"
                      IsChecked="{Binding IsFilterTransferOnly, Mode=OneWay}"
                      Command="{Binding SetViewFilterModeCommand}"
                      CommandParameter="{x:Static viewModels:NotchExportRowDisplayMode.TransferOnly}"/>
        <ToggleButton Classes="actionGhost flat" Content="{Binding NoOpFilterText}"
                      IsChecked="{Binding IsFilterWarningOnly, Mode=OneWay}"
                      Command="{Binding SetViewFilterModeCommand}"
                      CommandParameter="{x:Static viewModels:NotchExportRowDisplayMode.WarningOnly}"/>
        <ToggleButton Classes="actionGhost flat" Content="{Binding LegacyFilterText}"
                      IsChecked="{Binding IsFilterLegacyOnly, Mode=OneWay}"
                      Command="{Binding SetViewFilterModeCommand}"
                      CommandParameter="{x:Static viewModels:NotchExportRowDisplayMode.LegacyOnly}"/>
        <ToggleButton Classes="actionGhost flat" Content="{Binding NoCadFilterText}"
                      IsChecked="{Binding IsFilterNoCadOnly, Mode=OneWay}"
                      Command="{Binding SetViewFilterModeCommand}"
                      CommandParameter="{x:Static viewModels:NotchExportRowDisplayMode.NoCadOnly}"/>
      </StackPanel>
    </panels:WorkspaceShell.SummaryContent>
    <panels:WorkspaceShell.ToolbarContent>
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,*,Auto"
            ColumnSpacing="{StaticResource Space8}" RowSpacing="{StaticResource Space4}">
        <TextBox Width="{StaticResource NotchExportSearchWidth}"
                 PlaceholderText="{Binding SearchWatermarkText}"
                 Text="{Binding SearchKeyword, Mode=TwoWay}"/>
        <Button Grid.Column="1" Classes="actionGhost actionIconButton"
                Click="ShowFilterBuilderButton_Click" ToolTip.Tip="Filter helper"
                AutomationProperties.Name="Filter helper">
          <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FilterAlt}"/>
        </Button>
        <Button Grid.Column="2" Classes="actionGhost" Content="Reset filters"
                Command="{Binding ClearSearchKeywordCommand}"
                ToolTip.Tip="Clears every view filter; keeps version and sort."/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="{StaticResource Space6}">
          <TextBlock VerticalAlignment="Center" Text="Sort"
                     ToolTip.Tip="Sort changes the list only. Export keeps row order."/>
          <ComboBox Width="{StaticResource NotchExportSortDropdownWidth}"
                    ItemsSource="{Binding SortModeOptions}" IsEnabled="{Binding CanSelectSortMode}"
                    SelectedItem="{Binding SelectedSortModeOption, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="viewModels:NotchExportSortModeOption">
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal"
                    Spacing="{StaticResource Space6}" IsVisible="{Binding HasHeaderFilterChip}">
          <TextBlock VerticalAlignment="Center" Classes="stepNote" Text="Also filtered:"/>
          <Border Classes="chipStatus">
            <SelectableTextBlock Text="{Binding HeaderFilterChipText}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Grid>
    </panels:WorkspaceShell.ToolbarContent>
    <panels:WorkspaceShell.LeftContent>
      <sections:NotchExportSelectionRowsPaneView/>
    </panels:WorkspaceShell.LeftContent>
    <panels:WorkspaceShell.RightContent>
      <ScrollViewer Classes="scrollV2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource Space8}">
          <StackPanel x:Name="InspectorPanel" Spacing="{StaticResource Space6}" IsVisible="{Binding HasSelectedRow}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space6}">
              <SelectableTextBlock Text="{Binding InspectorHeaderText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <Border Grid.Column="1" Classes="chipStatus">
                <TextBlock Text="{Binding SelectedRow.StatusText}"/>
              </Border>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="{StaticResource Space12}" RowSpacing="{StaticResource Space4}">
              <TextBlock Classes="stepNote" Text="Diff"/>
              <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedRowPayloadAnchorText}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Classes="stepNote" Text="Combine"/>
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRowPayloadCombineText}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Classes="stepNote" Text="Target 1"/>
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRowPayloadTarget1Text}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="3" Classes="stepNote" Text="Target 2"/>
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRowPayloadTarget2Text}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="4" Classes="stepNote" Text="Version"/>
              <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRow.VersionText}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="5" Classes="stepNote" Text="Mapping"/>
              <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRowPadRelationText}" TextWrapping="Wrap"/>
            </Grid>
            <SelectableTextBlock IsVisible="{Binding IsSelectedRowLegacy}" Text="{Binding SelectedRowCodePreviewText}"
                                 TextWrapping="Wrap" ToolTip.Tip="Legacy payload columns"/>
            <SelectableTextBlock Text="{Binding SelectedRowAnalysisText}" TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding SelectedRowOutcomeText}"/>
            <Button Classes="actionGhost" HorizontalAlignment="Right" Click="CopyPayloadButton_Click"
                    ToolTip.Tip="Copy payload">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.ContentCopy}"/>
                <TextBlock Text="Copy payload"/>
              </StackPanel>
            </Button>
            <panels:CollapsiblePanel x:Name="LowFrequencyDetail" Title="Low-frequency detail"
                                     IsExpanded="{Binding ShowSelectedRowDetailSection, Mode=TwoWay}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                    ColumnSpacing="{StaticResource Space12}" RowSpacing="{StaticResource Space4}">
                <TextBlock Classes="stepNote" Text="Flags"/>
                <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedRowFlagsText}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Classes="stepNote" Text="Comment"/>
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRowCommentText}" TextWrapping="Wrap"/>
              </Grid>
            </panels:CollapsiblePanel>
          </StackPanel>
          <TextBlock IsVisible="{Binding HasNoSelectedRow}" Text="Select a row on the left to inspect it."
                     Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"/>
          <primitives:SectionFrame x:Name="ExportChecksSection" Title="Export checks">
            <StackPanel Spacing="{StaticResource Space6}">
              <panels:CollapsiblePanel Title="{Binding SimulationSafetyExportBadgeText}"
                                       IsVisible="{Binding NeedsSimulationCheckAttention}"
                                       IsExpanded="{Binding NeedsSimulationCheckAttention, Mode=OneWay}">
                <StackPanel Spacing="{StaticResource Space4}">
                  <Border Classes="chipStatus warning" IsVisible="{Binding HasSimulationPhysicalAuditWarning}"
                          ToolTip.Tip="{Binding SimulationSafetyExportSummaryText}">
                    <SelectableTextBlock Classes="chipStatusText" Text="{Binding SimulationSafetyExportSummaryText}" TextWrapping="Wrap"/>
                  </Border>
                  <SelectableTextBlock IsVisible="{Binding HasNoSimulationPhysicalAuditWarning}"
                                       Text="{Binding SimulationSafetyExportSummaryText}" TextWrapping="Wrap"/>
                  <SelectableTextBlock IsVisible="{Binding IsExportBlockedBySimulationSafety}"
                                       Text="{Binding SimulationSafetyExportHighRiskText}" TextWrapping="Wrap"/>
                </StackPanel>
              </panels:CollapsiblePanel>
              <panels:CollapsiblePanel Title="{Binding ToFullCoverageBadgeText}"
                                       IsVisible="{Binding HasToFullCoverageWarning}"
                                       IsExpanded="{Binding HasToFullCoverageWarning, Mode=OneWay}">
                <StackPanel Spacing="{StaticResource Space4}">
                  <SelectableTextBlock Text="{Binding ToFullCoverageSummaryText}" TextWrapping="Wrap"/>
                  <SelectableTextBlock Text="{Binding ToFullCoverageDetailText}" TextWrapping="Wrap"/>
                  <SelectableTextBlock IsVisible="{Binding HasToFullCoverageMissingList}"
                                       Text="{Binding ToFullCoverageMissingListText}" TextWrapping="Wrap"/>
                </StackPanel>
              </panels:CollapsiblePanel>
              <panels:CollapsiblePanel Title="Passed checks" IsVisible="{Binding HasPassedExportChecks}" IsExpanded="False">
                <StackPanel Spacing="{StaticResource Space6}">
                  <StackPanel Spacing="{StaticResource Space4}" IsVisible="{Binding IsSimulationSafetyClean}">
                    <TextBlock Text="{Binding SimulationSafetyExportBadgeText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <SelectableTextBlock Text="{Binding SimulationSafetyExportSummaryText}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Spacing="{StaticResource Space4}" IsVisible="{Binding HasNoToFullCoverageWarning}">
                    <TextBlock Text="{Binding ToFullCoverageBadgeText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <SelectableTextBlock Text="{Binding ToFullCoverageSummaryText}" TextWrapping="Wrap"/>
                    <SelectableTextBlock Text="{Binding ToFullCoverageDetailText}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </panels:CollapsiblePanel>
            </StackPanel>
          </primitives:SectionFrame>
          <panels:CollapsiblePanel Title="Workspace locate" IsExpanded="True">
            <StackPanel Spacing="{StaticResource Space6}">
              <SelectableTextBlock Text="{Binding WorkspaceSelectionSummaryText}" TextWrapping="Wrap"/>
              <StackPanel Spacing="{StaticResource Space4}" IsVisible="{Binding CanHidePanelForInspect}">
                <TextBlock Classes="stepNote" Text="{Binding RestoreShortcutHintText}" TextWrapping="Wrap"/>
                <Button Classes="actionGhost" Content="Hide panel (inspect AA)" HorizontalAlignment="Right"
                        Command="{Binding HidePanelForInspectCommand}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space6}">
                <Button Classes="actionGhost" Content="Clear linked rows" Command="{Binding DisableWorkspaceLinkedRowsCommand}"/>
                <Button Classes="actionGhost" Content="Check all linked" Command="{Binding EnableWorkspaceLinkedRowsCommand}"/>
              </StackPanel>
              <TextBlock IsVisible="{Binding HasNoWorkspaceLinkedRows}" TextWrapping="Wrap"
                         Text="No linked rows in view. Check the view filters, then click CAD / REG pads in the workspace."/>
              <ScrollViewer IsVisible="{Binding HasWorkspaceLinkedRows}"
                            MaxHeight="{StaticResource NotchExportSelectionWorkspaceListMaxHeight}"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding WorkspaceLinkedRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:NotchExportRowItemViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space6}">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip.Tip="Include in export"/>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}">
                          <TextBlock Text="{Binding WorkspaceLinkText}" TextWrapping="Wrap"/>
                          <TextBlock Classes="stepNote" Text="{Binding WorkspaceLinkDetailText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="actionGhost" Content="Preview"
                                Command="{Binding $parent[Window].((viewModels:NotchExportSelectionViewModel)DataContext).SelectPreviewRowCommand}"
                                CommandParameter="{Binding}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </panels:CollapsiblePanel>
        </StackPanel>
      </ScrollViewer>
    </panels:WorkspaceShell.RightContent>
    <panels:WorkspaceShell.FooterContent>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space8}">
        <SelectableTextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                             Text="{Binding ExportSummaryText}" TextWrapping="Wrap"/>
        <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="{StaticResource Space8}">
          <SelectableTextBlock VerticalAlignment="Center" Foreground="{DynamicResource BrushWarning}" TextWrapping="Wrap"
                               Text="{Binding HiddenSelectedRowsHintText}" IsVisible="{Binding HasHiddenSelectedRows}"/>
          <Button Classes="actionNeutral" Content="Cancel" Click="CancelButton_Click"/>
          <Button Classes="actionPrimary" Content="Export" IsEnabled="{Binding HasSelection}"
                  ToolTip.Tip="Export checked rows in their original order." Click="ExportButton_Click"/>
        </StackPanel>
      </Grid>
    </panels:WorkspaceShell.FooterContent>
  </panels:WorkspaceShell>
</Window>
