<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
        x:Class="FreeformHelper.UI.Views.WarningDialog"
        x:DataType="vm:WarningDialogViewModel"
        Classes="sharedMessageDialog"
        CanResize="False" WindowStartupLocation="CenterOwner" SizeToContent="Height"
        Title="{Binding Title}">
  <Window.Styles>
    <StyleInclude Source="avares://FreeformHelper.UI/Styles/ConfirmWarningDialogs.axaml"/>
  </Window.Styles>
  <Border Padding="{DynamicResource Inset16}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Space12}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space8}">
        <controls:FontIcon Classes="symbols iconLg" Glyph="{DynamicResource Nvt.Icon.Warning}"
                           Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Top"/>
        <SelectableTextBlock x:Name="TitleText" Grid.Column="1" Classes="dialogTitle" Text="{Binding Title}"/>
      </Grid>
      <ScrollViewer x:Name="MessageScroll" Grid.Row="1" Classes="dialogBody">
        <SelectableTextBlock x:Name="MessageText" Classes="dialogBodyText" Text="{Binding Message}"/>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="OkButton" Classes="actionTextButton actionPrimary"
                IsDefault="True" IsCancel="True" Click="OkButton_Click" Content="OK"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
