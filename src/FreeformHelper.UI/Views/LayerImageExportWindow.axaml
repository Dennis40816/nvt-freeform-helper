<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:converters="clr-namespace:FreeformHelper.UI.Converters"
        x:Class="FreeformHelper.UI.Views.LayerImageExportWindow"
        x:DataType="vm:LayerImageExportViewModel"
        x:Name="ExportWindow"
        Width="{DynamicResource LayerImageExportWidth}"
        Height="{DynamicResource LayerImageExportHeight}"
        MinWidth="{DynamicResource LayerImageExportMinWidth}"
        MinHeight="{DynamicResource LayerImageExportMinHeight}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontFamilyUi}"
        FontSize="{DynamicResource FontSizeMd}"
        Title="Export layer image">
  <Window.Resources>
    <converters:AllLayersStateConverter x:Key="AllLayersStateConverter"/>
    <converters:LayerPreviewBitmapConverter x:Key="PreviewBitmapConverter"/>
    <converters:LayerImageSelectionVisibilityConverter x:Key="HasSelectionConverter"/>
    <converters:LayerImageSelectionVisibilityConverter x:Key="NoSelectionConverter" Negate="True"/>
    <converters:BooleanGlyphConverter x:Key="ThemeGlyph" TrueGlyph="dark_mode" FalseGlyph="light_mode"/>
    <converters:BooleanGlyphConverter x:Key="RatioGlyph" TrueGlyph="link" FalseGlyph="link_off"/>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://FreeformHelper.UI/Styles/LayerImageExport.axaml"/>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding #ExportWindow.FocusSearchCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}"/>
  </Window.KeyBindings>

  <Grid RowDefinitions="*,Auto">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{DynamicResource LayerImageExportListColumn}"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource BrushBorderMuted}" BorderThickness="{DynamicResource BorderLeftThin}"
              Padding="{DynamicResource Inset12}">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Margin="{DynamicResource InsetBottom12}">
            <TextBox x:Name="SearchBox" Classes="exportSearch" PlaceholderText="Search layers"
                     Height="{DynamicResource NfcControlHeight}"
                     Padding="{DynamicResource LayerImageExportSearchPadding}"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search layers"/>
            <controls:FontIcon Classes="symbols" Glyph="search" IsHitTestVisible="False"
                               HorizontalAlignment="Left" Margin="{DynamicResource InsetLeft8}"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="{DynamicResource InsetBottom4}">
            <CheckBox x:Name="AllLayersCheckBox" Classes="exportCheck" Content="All layers"
                      IsThreeState="True" Foreground="{DynamicResource BrushTextMuted}"
                      IsChecked="{Binding AllLayersState, Mode=OneWay, Converter={StaticResource AllLayersStateConverter}}"
                      Command="{Binding ToggleAllLayersCommand}"/>
            <TextBlock Grid.Column="1" Classes="exportMuted exportCount" Text="{Binding CountText}"/>
          </Grid>
          <ListBox x:Name="LayerList" Grid.Row="2" Classes="exportLayers" ItemsSource="{Binding VisibleRows}"
                   Focusable="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Layers">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LayerImageLayerRow">
                <CheckBox Classes="exportCheck" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                  <Grid ColumnDefinitions="*,Auto">
                    <controls:HighlightedTextBlock Text="{Binding Name}" Ranges="{Binding HighlightRanges}"
                                                   VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Classes="exportMuted exportCount"
                               Width="{DynamicResource LayerImageExportCountWidth}"
                               Text="{Binding PadCount, StringFormat={}{0:N0}}"/>
                  </Grid>
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="NoMatchesHint" Grid.Row="2" Classes="exportMuted" Text="No layers match"
                     IsVisible="{Binding !VisibleRows.Count}" VerticalAlignment="Top"/>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="{DynamicResource Inset16}">
        <Border Background="{DynamicResource BrushBgSurfaceInset}" CornerRadius="{DynamicResource NfcSurfaceCornerRadius}"
                MinWidth="{DynamicResource LayerImageExportPreviewMinWidth}"
                MinHeight="{DynamicResource LayerImageExportPreviewMinHeight}" ClipToBounds="True">
          <Grid>
            <Image x:Name="PreviewImage" Classes="exportPreview" Classes.updating="{Binding IsPreviewUpdating}"
                   Source="{Binding PreviewPng, Converter={StaticResource PreviewBitmapConverter}}"
                   Stretch="Uniform" Margin="{DynamicResource Inset24}">
              <Image.IsVisible>
                <MultiBinding Converter="{StaticResource HasSelectionConverter}">
                  <Binding Path="ConfirmCommand"/>
                  <Binding Path="CountText"/>
                </MultiBinding>
              </Image.IsVisible>
            </Image>
            <TextBlock x:Name="SelectLayerHint" Text="Select a layer" Classes="exportMuted"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{StaticResource NoSelectionConverter}">
                  <Binding Path="ConfirmCommand"/>
                  <Binding Path="CountText"/>
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <StackPanel Margin="{DynamicResource Inset12}" VerticalAlignment="Bottom">
              <TextBlock Text="Updating" Classes="exportMuted" IsVisible="{Binding IsPreviewUpdating}"/>
              <TextBlock Text="{Binding PreviewErrorText}" Classes="exportMuted" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Classes="actionIconButton actionGhost flat" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="{DynamicResource Inset8}" Command="{Binding PreviewSettings.ToggleThemeCommand}"
                    ToolTip.Tip="Light / dark" AutomationProperties.Name="Light / dark">
              <controls:FontIcon Classes="symbols" Glyph="{Binding PreviewSettings.UseDarkTheme, Converter={StaticResource ThemeGlyph}}"/>
            </Button>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Classes="panelForm" Spacing="{DynamicResource Space8}" Margin="{DynamicResource InsetTop10}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="exportLabel" Text="Pixels"/>
            <StackPanel Classes="panelFormField">
              <controls:NumberScrubber Classes="exportNumber" Minimum="2" Maximum="100000" SmallChange="1" FormatString="0"
                                       Value="{Binding PreviewSettings.PixelsX, Mode=TwoWay}" AutomationProperties.Name="Pixels X"/>
            </StackPanel>
            <ToggleButton Classes="actionIconButton actionGhost flat" IsChecked="{Binding PreviewSettings.KeepRatio, Mode=TwoWay}"
                          ToolTip.Tip="Keep ratio" AutomationProperties.Name="Keep ratio">
              <controls:FontIcon Classes="symbols" Glyph="{Binding PreviewSettings.KeepRatio, Converter={StaticResource RatioGlyph}}"/>
            </ToggleButton>
            <StackPanel Classes="panelFormField">
              <controls:NumberScrubber Classes="exportNumber" Minimum="2" Maximum="100000" SmallChange="1" FormatString="0"
                                       Value="{Binding PreviewSettings.PixelsY, Mode=TwoWay}" AutomationProperties.Name="Pixels Y"/>
            </StackPanel>
            <Button Classes="actionIconButton actionGhost flat" Command="{Binding PreviewSettings.ResetToProjectSizeCommand}"
                    ToolTip.Tip="Reset to project size" AutomationProperties.Name="Reset to project size">
              <controls:FontIcon Classes="symbols" Glyph="restart_alt"/>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="exportLabel" Text="Padding"/>
            <StackPanel Classes="panelFormField">
              <controls:NumberScrubber Classes="exportNumber" Minimum="0" Maximum="100000" SmallChange="1" FormatString="0"
                                       Value="{Binding PreviewSettings.PaddingX, Mode=TwoWay}" AutomationProperties.Name="Padding X"/>
            </StackPanel>
            <TextBlock Text="×" Classes="exportMuted" Width="{DynamicResource NfcControlHeight}" TextAlignment="Center"/>
            <StackPanel Classes="panelFormField">
              <controls:NumberScrubber Classes="exportNumber" Minimum="0" Maximum="100000" SmallChange="1" FormatString="0"
                                       Value="{Binding PreviewSettings.PaddingY, Mode=TwoWay}" AutomationProperties.Name="Padding Y"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="exportLabel" Text="Line width"/>
            <StackPanel Classes="panelFormField">
              <controls:NumberScrubber Classes="exportNumber" Minimum="0.1" Maximum="100" SmallChange="0.1"
                                       FormatString="0.##" SnapToStep="False"
                                       Value="{Binding PreviewSettings.LineWidthPixels, Mode=TwoWay}" AutomationProperties.Name="Line width in pixels"/>
            </StackPanel>
            <TextBlock Text="px" Classes="exportMuted" Margin="{DynamicResource InsetLeft8}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorderMuted}" BorderThickness="{DynamicResource BorderTopThin}"
            Padding="{DynamicResource Inset12_10}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding FooterText}" Classes="exportMuted" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Space8}">
          <Button Content="Cancel" Classes="actionGhost" Command="{Binding CancelCommand}"/>
          <Button x:Name="ExportButton" Content="Export…" Classes="actionPrimary" IsDefault="True" Command="{Binding ConfirmCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
