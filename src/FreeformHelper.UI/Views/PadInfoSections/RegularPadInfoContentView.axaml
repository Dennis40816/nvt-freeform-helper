<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:padInfo="clr-namespace:FreeformHelper.UI.Views.PadInfoSections"
             xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
             xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
             xmlns:primitives="clr-namespace:Nvt.Core.Avalonia.Primitives;assembly=Nvt.Core.Avalonia"
             x:Class="FreeformHelper.UI.Views.PadInfoSections.RegularPadInfoContentView"
             x:DataType="vm:RegularPadInfoViewModel">
  <UserControl.Styles>
    <StyleInclude Source="avares://Nvt.Core.Avalonia/Panels/PanelsStyles.axaml"/>
    <StyleInclude Source="avares://Nvt.Core.Avalonia/Primitives/PrimitivesStyles.axaml"/>
  </UserControl.Styles>
  <ScrollViewer x:Name="RegularPadInfoScroll" Classes="scrollV2"
                MaxHeight="{DynamicResource PadInfoContentMaxHeight}"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" Padding="{DynamicResource InsetNone}">
    <Border Padding="{DynamicResource InsetRight12Bottom12}">
      <StackPanel Spacing="{DynamicResource Space12}">
        <controls:PadHeader x:Name="RegularHeader" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
          <controls:PadHeader.KindMark>
            <Path Width="{DynamicResource IconSizeMd}" Height="{DynamicResource IconSizeMd}"
                  Fill="{DynamicResource BrushCanvasRegularSelected}" Data="M3 3 H21 V21 H3 Z"/>
          </controls:PadHeader.KindMark>
          <controls:PadHeader.Actions>
            <Grid ColumnDefinitions="Auto">
              <Border ToolTip.Tip="{Binding LocateMatchToolTip}">
                <Button Classes="actionGhost"
                        Classes.actionTextButton="{Binding ShowActionLabels, ElementName=RegularHeader}"
                        Classes.actionIconButton="{Binding !ShowActionLabels, ElementName=RegularHeader}"
                        AutomationProperties.Name="Locate match" Command="{Binding LocateMatchCommand}"
                        IsEnabled="{Binding HasLocateMatchAction}" ToolTip.Tip="{Binding LocateMatchToolTip}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space4}">
                    <controls:FontIcon Classes="symbols iconSm" Glyph="{DynamicResource Nvt.Icon.FitScreen}"/>
                    <TextBlock Text="Locate match" IsVisible="{Binding ShowActionLabels, ElementName=RegularHeader}"/>
                  </StackPanel>
                </Button>
              </Border>
            </Grid>
          </controls:PadHeader.Actions>
        </controls:PadHeader>
        <StackPanel Spacing="{DynamicResource Space4}">
          <SelectableTextBlock Classes="padInfoBodyText" Text="{Binding PanelIdentityText}" TextWrapping="Wrap"
                               ToolTip.Tip="{Binding IdentityToolTip}"/>
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}"
                      IsVisible="{Binding IsSingle}" ToolTip.Tip="{Binding IdentityToolTip}">
            <SelectableTextBlock Classes="padInfoMetaText" Text="{Binding HeaderAxisXText}"/>
            <SelectableTextBlock Classes="padInfoMetaText" Text="{Binding HeaderAxisYText}"/>
          </StackPanel>
        </StackPanel>
        <Border Classes="padInfoSectionBlock">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="{DynamicResource Space12}" RowSpacing="{DynamicResource Space8}">
            <StackPanel Spacing="{DynamicResource Space2}">
              <SelectableTextBlock Classes="padInfoKeyLabel" Text="Match"/>
              <SelectableTextBlock Classes="padInfoKeyValue" Text="{Binding MatchText}" ToolTip.Tip="{Binding MatchToolTip}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="{DynamicResource Space2}">
              <SelectableTextBlock Classes="padInfoKeyLabel" Text="Freeform"/>
              <SelectableTextBlock Classes="padInfoKeyValue" Text="{Binding FreeformText}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="{DynamicResource Space2}" IsVisible="{Binding IsMulti}">
              <SelectableTextBlock Classes="padInfoKeyLabel" Text="Diff idx"/>
              <SelectableTextBlock Classes="padInfoKeyValue" Text="{Binding DiffIndexText}" ToolTip.Tip="{Binding DiffSourceText}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{DynamicResource Space2}" IsVisible="{Binding IsMulti}">
              <SelectableTextBlock Classes="padInfoKeyLabel" Text="IC"/>
              <SelectableTextBlock Classes="padInfoKeyValue" Text="{Binding IcText}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="{DynamicResource Space2}">
              <SelectableTextBlock Classes="padInfoKeyLabel" Text="Notch rows"/>
              <SelectableTextBlock Classes="padInfoBodyText" Text="{Binding NotchRowsSummaryText}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
        <primitives:SectionFrame Title="Relation">
          <StackPanel Spacing="{DynamicResource Space8}">
            <Border Classes="padInfoSectionBlock">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="{DynamicResource Space12}" RowSpacing="{DynamicResource Space4}">
                <SelectableTextBlock Classes="padInfoKeyLabel" Text="Location" IsVisible="{Binding IsSingle}"/>
                <SelectableTextBlock Grid.Column="1" Classes="padInfoBodyText" Text="{Binding RowColText}"
                                     IsVisible="{Binding IsSingle}" TextWrapping="Wrap"/>
                <SelectableTextBlock Grid.Row="1" Classes="padInfoKeyLabel" Text="Owners"/>
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="padInfoBodyText"
                                     Text="{Binding OwnerSummaryText}" TextWrapping="Wrap"/>
                <SelectableTextBlock Grid.Row="2" Classes="padInfoKeyLabel" Text="Rows" IsVisible="{Binding IsMulti}"/>
                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="padInfoBodyText"
                                     Text="{Binding RowRangeText}" IsVisible="{Binding IsMulti}" TextWrapping="Wrap"/>
                <SelectableTextBlock Grid.Row="3" Classes="padInfoKeyLabel" Text="Cols" IsVisible="{Binding IsMulti}"/>
                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="padInfoBodyText"
                                     Text="{Binding ColRangeText}" IsVisible="{Binding IsMulti}" TextWrapping="Wrap"/>
              </Grid>
            </Border>
            <StackPanel Spacing="{DynamicResource Space4}" IsVisible="{Binding HasMatchAreaCards}">
              <SelectableTextBlock Classes="padInfoTitle" Text="{Binding AllocationTitleText}"/>
              <SelectableTextBlock Classes="padInfoMetaText" Text="{Binding AllocationHintText}" TextWrapping="Wrap"/>
              <padInfo:PadInfoRelationCardListView Cards="{Binding MatchAreaCards}" Compact="True"/>
            </StackPanel>
            <panels:CollapsiblePanel Title="Notch row flow" IsExpanded="False" IsVisible="{Binding HasNotchRowFlowCards}">
              <padInfo:PadInfoRelationCardListView Cards="{Binding NotchRowFlowCards}" Compact="True"/>
            </panels:CollapsiblePanel>
          </StackPanel>
        </primitives:SectionFrame>
        <primitives:SectionFrame Title="Edit tools">
          <StackPanel Spacing="{DynamicResource Space8}">
            <SelectableTextBlock Classes="padInfoMetaText" Text="{Binding SizeScopeText}"
                                 TextWrapping="Wrap" HorizontalAlignment="Left"/>
            <Grid ColumnDefinitions="*,*">
              <StackPanel Classes="panelFormField left">
                <SelectableTextBlock Classes="padInfoKeyLabel" Text="Pad width (mm)"/>
                <SelectableTextBlock Classes="padInfoMetaText" Text="Mixed values. Enter to override selection."
                                     IsVisible="{Binding IsPadWidthMixed}" TextWrapping="Wrap"/>
                <controls:NumberScrubber Minimum="0" Maximum="1000000" SmallChange="0.0001"
                                         FormatString="0.####" SnapToStep="False" HorizontalAlignment="Stretch"
                                         Value="{Binding PadWidth, Mode=TwoWay}"
                                         ToolTip.Tip="Overrides pad width for selected rows/cols."/>
              </StackPanel>
              <StackPanel Grid.Column="1" Classes="panelFormField right">
                <SelectableTextBlock Classes="padInfoKeyLabel" Text="Pad height (mm)"/>
                <SelectableTextBlock Classes="padInfoMetaText" Text="Mixed values. Enter to override selection."
                                     IsVisible="{Binding IsPadHeightMixed}" TextWrapping="Wrap"/>
                <controls:NumberScrubber Minimum="0" Maximum="1000000" SmallChange="0.0001"
                                         FormatString="0.####" SnapToStep="False" HorizontalAlignment="Stretch"
                                         Value="{Binding PadHeight, Mode=TwoWay}"
                                         ToolTip.Tip="Overrides pad height for the selected rows/cols."/>
              </StackPanel>
            </Grid>
            <SelectableTextBlock Classes="padInfoMetaText" Text="Unsaved changes"
                                 IsVisible="{Binding HasPendingChanges}" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space8}" HorizontalAlignment="Right">
              <Button Classes="actionTextButton actionGhost" Content="Discard" Command="{Binding DiscardChangesCommand}"/>
              <Button Classes="actionTextButton actionPrimary" Content="Apply changes"
                      IsEnabled="{Binding HasPendingChanges}" Command="{Binding ApplyChangesCommand}"
                      ToolTip.Tip="Apply changes and close."/>
            </StackPanel>
          </StackPanel>
        </primitives:SectionFrame>
        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="{DynamicResource BorderTopThin}"
                Padding="{DynamicResource InsetTop8}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space6}" HorizontalAlignment="Left">
            <SelectableTextBlock Classes="padInfoKeyLabel" Text="Freeform" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding FreeformActionHint}"/>
            <controls:FontIcon Classes="symbols iconSm" Glyph="{x:Static icons:IconGlyphs.Info}"
                               VerticalAlignment="Center" ToolTip.Tip="{Binding FreeformActionHint}"/>
            <Button Classes="actionNeutral actionTextButton padInfoActionButton" Content="None"
                    Command="{Binding SetFreeformNoneCommand}" ToolTip.Tip="Mark selection as none."/>
            <Button Classes="actionNeutral actionTextButton padInfoActionButton" Content="X"
                    Command="{Binding SetFreeformXCommand}" ToolTip.Tip="Mark selection as X-way."/>
            <Button Classes="actionNeutral actionTextButton padInfoActionButton" Content="Y"
                    Command="{Binding SetFreeformYCommand}" ToolTip.Tip="Mark selection as Y-way."/>
            <Button Classes="actionNeutral actionTextButton padInfoActionButton" Content="XY"
                    Command="{Binding SetFreeformXYCommand}" ToolTip.Tip="Mark selection as XY-way."/>
          </StackPanel>
        </Border>
        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="{DynamicResource BorderTopThin}"
                Padding="{DynamicResource InsetTop8}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="actionTextButton actionGhost" Content="Reset size" Command="{Binding ResetPadSizeCommand}"/>
          </StackPanel>
        </Border>
        <panels:CollapsiblePanel x:Name="GeometryDebugSection" Title="Geometry / Debug"
                                 IsExpanded="{Binding ShowGeometryDetails, Mode=TwoWay}">
          <StackPanel Spacing="{DynamicResource Space8}" IsVisible="{Binding ShowGeometryDetails}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="{DynamicResource Space12}" RowSpacing="{DynamicResource Space4}">
              <SelectableTextBlock Classes="padInfoKeyLabel" Text="Area"/>
              <SelectableTextBlock Grid.Column="1" Classes="padInfoBodyText" Text="{Binding AreaText}"/>
              <SelectableTextBlock Grid.Row="1" Classes="padInfoKeyLabel" Text="Centroid"/>
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="padInfoBodyText" Text="{Binding CentroidText}"/>
              <SelectableTextBlock Grid.Row="2" Classes="padInfoKeyLabel" Text="Bounds"/>
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="padInfoBodyText" Text="{Binding BoundsText}" TextWrapping="Wrap"/>
              <SelectableTextBlock Grid.Row="3" Classes="padInfoKeyLabel" Text="Regular id"/>
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="padInfoBodyText" Text="{Binding RegularPadIdText}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding RuleTraceLines}" IsVisible="{Binding HasRuleTrace}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <SelectableTextBlock Classes="padInfoMetaText" Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </panels:CollapsiblePanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
