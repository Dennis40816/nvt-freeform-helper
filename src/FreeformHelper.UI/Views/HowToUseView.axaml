<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
             x:Class="FreeformHelper.UI.Views.HowToUseView"
             x:DataType="vm:HowToUseViewModel">
  <Design.DataContext>
    <vm:HowToUseViewModel/>
  </Design.DataContext>
  <UserControl.Styles>
    <StyleInclude Source="avares://FreeformHelper.UI/Styles/HowToUse.axaml"/>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="{DynamicResource Inset20}">
      <StackPanel x:Name="HelpSections" Spacing="{DynamicResource Space12}">
        <StackPanel Spacing="{DynamicResource Space4}">
          <SelectableTextBlock Text="How To Use" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"/>
          <SelectableTextBlock Text="Workflow, controls, and settings reference." Foreground="{DynamicResource BrushTextMuted}"/>
        </StackPanel>
        <controls:HidePanelBlock Title="Quick Start" IsExpanded="True" DefaultExpanded="True" IsCollapsible="False">
          <StackPanel Spacing="{DynamicResource Space6}">
            <SelectableTextBlock Text="1) Open DXF → 2) Review grid settings → 3) Match → 4) Tag freeforms → 5) Export."/>
            <SelectableTextBlock Text="Regular pads are generated from AA size + channels even before a DXF is loaded."/>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock Title="Interface tour" IsExpanded="False" DefaultExpanded="False">
          <StackPanel Spacing="{DynamicResource Space12}">
            <controls:PadInfoSectionFrame Title="Navigation">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- Top tabs: Freeform Helper, How To Use, Dev."/>
                <SelectableTextBlock Text="- Fit icon: top-right of the canvas."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
            <controls:PadInfoSectionFrame Title="Menu Bar">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- File: Open DXF, Save Project, Load Project."/>
                <SelectableTextBlock Text="- Match: Run pad matching."/>
                <SelectableTextBlock Text="- Export: Notch CSV review or C v2.1/v2.2."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock Title="Display and DXF settings" IsExpanded="False" DefaultExpanded="False">
          <StackPanel Spacing="{DynamicResource Space12}">
            <controls:PadInfoSectionFrame Title="Workspace Header (Display)">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- Display menu: CAD layer, Regular grid, Highlight unmatched/freeform, Color by area."/>
                <SelectableTextBlock Text="- CAD display: line width and line color."/>
                <SelectableTextBlock Text="- Area buckets: CAD-only area grouping colors."/>
                <SelectableTextBlock Text="- Status and selection summaries update automatically."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
            <controls:PadInfoSectionFrame Title="DXF Settings (Left Panel)">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- Only closed polylines: import closed shapes only."/>
                <SelectableTextBlock Text="- Layer toggles: hide/show CAD pads by layer after import."/>
                <SelectableTextBlock Text="- Check DXF overlaps: scan duplicates and overlaps on demand."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock Title="Canvas navigation and selection" IsExpanded="False" DefaultExpanded="False">
          <StackPanel Spacing="{DynamicResource Space4}">
            <Border Classes="workspaceTableHeader">
              <Grid x:Name="CanvasNavigationHeader" Classes="howToGestureRow">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{DynamicResource HowToGestureColumnWidth}"/>
                  <ColumnDefinition Width="{DynamicResource HowToActionColumnWidth}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Classes="workspaceTableHeaderText" Text="Gesture or key"/>
                <TextBlock Grid.Column="1" Classes="workspaceTableHeaderText" Text="Action"/>
              </Grid>
            </Border>
            <ListBox x:Name="CanvasNavigationTable" Classes="workspaceDataList" ItemsSource="{Binding CanvasGestures}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HowToUseGestureRow">
                  <Border Classes="workspaceTableHeader">
                    <Grid Classes="howToGestureRow">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource HowToGestureColumnWidth}"/>
                        <ColumnDefinition Width="{DynamicResource HowToActionColumnWidth}"/>
                      </Grid.ColumnDefinitions>
                      <SelectableTextBlock Classes="workspaceDataCellText strong" Text="{Binding Gesture}" TextWrapping="Wrap"/>
                      <SelectableTextBlock Grid.Column="1" Classes="workspaceDataCellText" Text="{Binding Action}" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock Title="Manual sizing and right-pane settings" IsExpanded="False" DefaultExpanded="False">
          <StackPanel Spacing="{DynamicResource Space12}">
            <controls:PadInfoSectionFrame Title="Manual Sizing (Header Bar)">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- Rows/Cols: enter ranges like 5, 5-7, 5,7."/>
                <SelectableTextBlock Text="- Width/Height: set target size for selected regular pads."/>
                <SelectableTextBlock Text="- Use Selection: fill Rows/Cols from current selection."/>
                <SelectableTextBlock Text="- '*' means mixed values in the current selection."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
            <controls:PadInfoSectionFrame Title="Right Panel: General Settings">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- IC layout: Cascade count and per-IC X/Y channels."/>
                <SelectableTextBlock Text="- Grid settings: Padding percent, scan order, and sizing scope (Local/Global)."/>
                <SelectableTextBlock Text="- Panel AA size (mm): Physical panel size used to compute pitch."/>
                <SelectableTextBlock Text="- Alignment mode: Choose AA vs DXF bounds."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
            <controls:PadInfoSectionFrame Title="Right Panel: Analysis">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- Matching: overlap-based CAD↔Regular relation; one CAD can map to multiple regular pads."/>
                <SelectableTextBlock Text="- Unmatched threshold: Display-only overlap / regular area diagnostic; changing it does not change links."/>
                <SelectableTextBlock Text="- Freeform tagging: Assign X/Y/XY/None to selected pads."/>
                <SelectableTextBlock Text="- Notch export: Enable versions and legacy values."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock Title="Notch reference" IsExpanded="False" DefaultExpanded="False">
          <StackPanel Spacing="{DynamicResource Space12}">
            <controls:PadInfoSectionFrame Title="Notch Terms &amp; Thresholds">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- BBoxArea: CAD pad bounding-box area, formula = width × height (used by V2.1 REGU_TO_FULL field)."/>
                <SelectableTextBlock Text="- Freeform TH (Matching &gt; Freeform axis threshold): decides XWay/YWay/None classification during auto-detect."/>
                <SelectableTextBlock Text="- Notch TH (Notch threshold Q7): after allocation, if max allocation &lt; TH, that CAD is skipped from notch export."/>
                <SelectableTextBlock Text="- Effective boundary: To Full can only start from CAD-overlapped regulars that are connected to boundary seeds (outer edge or inactive-neighbor seed)."/>
                <SelectableTextBlock Text="- Multi-owner gate: if one regular is owned by more than one CAD (strict overlap over TH), that regular cannot be a To Full target."/>
                <SelectableTextBlock Text="- Active regular visibility mask: boundary inactive-neighbor check uses current active regular set (match result scope), not all grid cells."/>
                <SelectableTextBlock Text="- Allocation cutoff: reserved for future FW-oriented row minimization (not enabled in current build)."/>
                <SelectableTextBlock Text="- Export notch now opens a row picker, so each generated notch row can be included/excluded manually before file output."/>
                <Image Source="avares://FreeformHelper.UI/Assets/HowTo/notch-flow.png" Height="{DynamicResource HowToFigureHeight}"
                       Stretch="Uniform" HorizontalAlignment="Left"/>
                <Image Source="avares://FreeformHelper.UI/Assets/HowTo/threshold-scope.png" Height="{DynamicResource HowToFigureHeight}"
                       Stretch="Uniform" HorizontalAlignment="Left"/>
                <Image Source="avares://FreeformHelper.UI/Assets/HowTo/bbox-area.png" Height="{DynamicResource HowToFigureHeight}"
                       Stretch="Uniform" HorizontalAlignment="Left"/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock Title="Numeric input and Console" IsExpanded="False" DefaultExpanded="False">
          <StackPanel Spacing="{DynamicResource Space12}">
            <controls:PadInfoSectionFrame Title="Number Inputs">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- Type a value and press Enter or click away to commit."/>
                <SelectableTextBlock Text="- Up/Down buttons step by the configured increment."/>
                <SelectableTextBlock Text="- Drag the right scrub area to adjust quickly."/>
                <SelectableTextBlock Text="- Alt + mouse wheel changes the value."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
            <controls:PadInfoSectionFrame Title="Console &amp; Undo">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- Bottom console streams logs and auto-scrolls to the latest entry."/>
                <SelectableTextBlock Text="- Clear removes entries."/>
                <SelectableTextBlock Text="- Ctrl + Z undoes settings and pad edits (global when not editing text)."/>
                <SelectableTextBlock Text="- Delete hides selected CAD pads (global when not editing text)."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
          </StackPanel>
        </controls:HidePanelBlock>
        <controls:HidePanelBlock Title="Advanced reference" IsExpanded="False" DefaultExpanded="False">
          <StackPanel Spacing="{DynamicResource Space12}">
            <controls:PadInfoSectionFrame Title="Build &amp; Tests">
              <StackPanel Spacing="{DynamicResource Space6}">
                <SelectableTextBlock Text="- Run scripts/build.ps1 to build and execute unit tests."/>
              </StackPanel>
            </controls:PadInfoSectionFrame>
          </StackPanel>
        </controls:HidePanelBlock>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
