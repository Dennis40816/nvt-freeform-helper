<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        x:Class="FreeformHelper.UI.Views.CadLoadSpinnerWindow"
        Width="{StaticResource CadLoadSpinnerWindowSize}"
        Height="{StaticResource CadLoadSpinnerWindowSize}"
        Background="Transparent"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        TransparencyLevelHint="Transparent">
  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent"
                 ClipToBounds="False">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"/>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Styles>

  <controls:LoadingSpinner x:Name="PART_LoadingSpinner"
                           IsAnimationActive="True"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
</Window>
