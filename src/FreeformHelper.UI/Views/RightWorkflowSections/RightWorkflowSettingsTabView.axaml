<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
             xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
             xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
             xmlns:stepViews="clr-namespace:FreeformHelper.UI.Views.WorkflowSteps"
             x:Class="FreeformHelper.UI.Views.RightWorkflowSections.RightWorkflowSettingsTabView">
    <StackPanel Spacing="{StaticResource Space10}"
                IsVisible="{Binding IsRightPanelSettingsTab}">
    <panels:CollapsiblePanel Title="Overview" IsExpanded="False">
      <panels:CollapsiblePanel.HeaderRight>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
          <Border Classes="chipStatus warning" Classes.danger="{Binding HasSimulationSafetyOverviewRisk}"
                  IsVisible="{Binding HasSimulationSafetyOverviewAttention}"
                  ToolTip.Tip="{Binding SimulationSafetyOverviewSummaryText}">
            <SelectableTextBlock Text="Simulation safety"/>
          </Border>
              <Button Grid.Column="1"
                      Tag="General"
                      Classes="actionIconButton actionGhost workflowOverviewAction"
                      Click="OpenSettingsButton_Click"
                      ToolTip.Tip="Open Settings > General.">
                <controls:FontIcon Classes="symbols iconSm"
                                   Glyph="{x:Static icons:IconGlyphs.Settings}"/>
              </Button>
        </StackPanel>
      </panels:CollapsiblePanel.HeaderRight>
        <Border Classes="workflowOverviewSection"
                ToolTip.Tip="Project geometry and regular-grid readiness summary. Edit values in Settings > General.">
          <StackPanel Spacing="{StaticResource Space8}">
            <Grid Classes="workflowOverviewHeader" ColumnDefinitions="*,Auto">
              <SelectableTextBlock Classes="workflowOverviewTitle" Text="Project / grid"/>

            </Grid>
            <Grid Classes="workflowOverviewInfoGrid"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto,*">
              <SelectableTextBlock Classes="workflowOverviewLabel" Text="CAD"/>
              <SelectableTextBlock Grid.Column="1"
                                   Classes="workflowOverviewValue"
                                   Text="{Binding CadPads.Count}"
                                   ToolTip.Tip="Loaded CAD pad count after DXF import and current DXF edits."/>
              <SelectableTextBlock Grid.Column="2"
                                   Classes="workflowOverviewLabel"
                                   Text="REG"/>
              <SelectableTextBlock Grid.Column="3"
                                   Classes="workflowOverviewValue"
                                   Text="{Binding RegularPads.Count}"
                                   ToolTip.Tip="Generated regular-grid pad count."/>
              <SelectableTextBlock Grid.Row="1"
                                   Classes="workflowOverviewLabel"
                                   Text="IC"/>
              <SelectableTextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Classes="workflowOverviewValue"
                                   Text="{Binding CascadeNum}"
                                   ToolTip.Tip="Cascade IC count from Settings > General."/>
              <SelectableTextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Classes="workflowOverviewLabel"
                                   Text="X"/>
              <SelectableTextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Classes="workflowOverviewValue"
                                   Text="{Binding XChannels}"
                                   ToolTip.Tip="X-channel count per IC from Settings > General."/>
              <SelectableTextBlock Grid.Row="2"
                                   Classes="workflowOverviewLabel"
                                   Text="Y"/>
              <SelectableTextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Classes="workflowOverviewValue"
                                   Text="{Binding YChannels}"
                                   ToolTip.Tip="Y-channel count per IC from Settings > General."/>
            </Grid>
            <StackPanel Classes="workflowOverviewMetaBlock">
              <SelectableTextBlock Classes="workflowOverviewMeta"
                                   Text="{Binding PitchSizeXSummary}"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding PitchSizeXSummary}"/>
              <SelectableTextBlock Classes="workflowOverviewMeta"
                                   Text="{Binding PitchSizeYSummary}"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding PitchSizeYSummary}"/>
            </StackPanel>
          </StackPanel>
        </Border>
    </panels:CollapsiblePanel>

    <stepViews:RightWorkflowStep1View OpenSettingsRequested="OnStepOpenSettingsRequested"/>

    <stepViews:RightWorkflowStep2View x:Name="Step2Block"
                                      OpenSettingsRequested="OnStepOpenSettingsRequested"/>

    <stepViews:RightWorkflowStep3View x:Name="Step3Block"
                                      OpenSettingsRequested="OnStepOpenSettingsRequested"/>



    <stepViews:RightWorkflowStep5View x:Name="Step5Block"
                                      OpenSettingsRequested="OnStepOpenSettingsRequested"/>

    <stepViews:RightWorkflowStep4View x:Name="Step4Block"
                                      OpenSettingsRequested="OnStepOpenSettingsRequested"/>


    <panels:CollapsiblePanel x:Name="Step6Block"
                             Title="Validation Quick Trace"
                             IsExpanded="{Binding IsStep6Expanded, Mode=TwoWay}">
      <StackPanel Spacing="{StaticResource Space8}" HorizontalAlignment="Stretch">
        <SelectableTextBlock Classes="stepNote" Text="{Binding ValidationTraceHint}" TextWrapping="Wrap"/>
        <Button Content="Use Selected REG" Command="{Binding UseSelectedRegularForNotchValidationCommand}"
                ToolTip.Tip="Copy currently selected REG id and run validation."/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space6}">
          <controls:NumberScrubber Minimum="0" Maximum="2000000000" SmallChange="1" FormatString="0"
                                   Value="{Binding NotchValidationRegularPadId, Mode=TwoWay}"
                                   ToolTip.Tip="Target REG id to inspect row/flow trace."/>
          <Button Grid.Column="1" Content="Analyze" Command="{Binding AnalyzeNotchValidationCommand}"
                  ToolTip.Tip="Analyze direct rows and incoming/outgoing allocations for this REG."/>
        </Grid>

        <SelectableTextBlock Classes="stepNote"
                             IsVisible="{Binding HasNotchValidationItems}"
                             Text="Click one row to focus source/target pads on AA canvas."/>
        <StackPanel Spacing="{StaticResource Space6}"
                    IsVisible="{Binding HasNotchValidationItems}">
          <panels:CollapsiblePanel Title="DIRECT details"
                                   IsExpanded="False"
                                   IsCollapsible="True">
            <panels:CollapsiblePanel.HeaderRight>
              <Border Classes="validationCountPill">
                <SelectableTextBlock Classes="validationCountText"
                                     Text="{Binding NotchValidationDirectCount, StringFormat='x{0}'}"/>
              </Border>
            </panels:CollapsiblePanel.HeaderRight>
            <StackPanel Spacing="{StaticResource Space6}">
              <SelectableTextBlock Classes="stepNote"
                                   IsVisible="{Binding IsNotchValidationDirectEmpty}"
                                   Text="No DIRECT rows for current REG."/>
              <ScrollViewer Classes="scrollV2"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            MaxHeight="{StaticResource NotchDetailListMaxHeight}"
                            IsVisible="{Binding HasNotchValidationDirectItems}">
                <ItemsControl ItemsSource="{Binding NotchValidationDirectItems}"
                              ItemTemplate="{StaticResource NotchValidationRowTemplate}"/>
              </ScrollViewer>
            </StackPanel>
          </panels:CollapsiblePanel>
          <panels:CollapsiblePanel Title="IN details"
                                   IsExpanded="False"
                                   IsCollapsible="True">
            <panels:CollapsiblePanel.HeaderRight>
              <Border Classes="validationCountPill">
                <SelectableTextBlock Classes="validationCountText"
                                     Text="{Binding NotchValidationIncomingCount, StringFormat='x{0}'}"/>
              </Border>
            </panels:CollapsiblePanel.HeaderRight>
            <StackPanel Spacing="{StaticResource Space6}">
              <SelectableTextBlock Classes="stepNote"
                                   IsVisible="{Binding IsNotchValidationIncomingEmpty}"
                                   Text="No IN rows for current REG."/>
              <ScrollViewer Classes="scrollV2"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            MaxHeight="{StaticResource NotchDetailListMaxHeight}"
                            IsVisible="{Binding HasNotchValidationIncomingItems}">
                <ItemsControl ItemsSource="{Binding NotchValidationIncomingItems}"
                              ItemTemplate="{StaticResource NotchValidationRowTemplate}"/>
              </ScrollViewer>
            </StackPanel>
          </panels:CollapsiblePanel>
          <panels:CollapsiblePanel Title="OUT details"
                                   IsExpanded="False"
                                   IsCollapsible="True">
            <panels:CollapsiblePanel.HeaderRight>
              <Border Classes="validationCountPill">
                <SelectableTextBlock Classes="validationCountText"
                                     Text="{Binding NotchValidationOutgoingCount, StringFormat='x{0}'}"/>
              </Border>
            </panels:CollapsiblePanel.HeaderRight>
            <StackPanel Spacing="{StaticResource Space6}">
              <SelectableTextBlock Classes="stepNote"
                                   IsVisible="{Binding IsNotchValidationOutgoingEmpty}"
                                   Text="No OUT rows for current REG."/>
              <ScrollViewer Classes="scrollV2"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            MaxHeight="{StaticResource NotchDetailListMaxHeight}"
                            IsVisible="{Binding HasNotchValidationOutgoingItems}">
                <ItemsControl ItemsSource="{Binding NotchValidationOutgoingItems}"
                              ItemTemplate="{StaticResource NotchValidationRowTemplate}"/>
              </ScrollViewer>
            </StackPanel>
          </panels:CollapsiblePanel>
        </StackPanel>
        <SelectableTextBlock Classes="stepNote"
                             IsVisible="{Binding IsNotchValidationItemsEmpty}"
                             Text="No rows yet. Run Analyze for current REG."/>
        <Separator/>
        <Button Classes="actionTextButton actionDanger" Content="Clear trace" HorizontalAlignment="Right"
                Command="{Binding ClearNotchValidationCommand}" ToolTip.Tip="Clear validation trace."/>
      </StackPanel>
    </panels:CollapsiblePanel>
    </StackPanel>
</UserControl>
