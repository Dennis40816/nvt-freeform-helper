<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FreeformHelper.UI.ViewModels"
        x:Class="FreeformHelper.UI.Views.DxfOverlapReportWindow"
        x:DataType="vm:DxfOverlapReportViewModel"
        Width="{DynamicResource IndexMappingReportWidth}"
        Height="{DynamicResource IndexMappingReportHeight}"
        MinWidth="{DynamicResource IndexMappingReportMinWidth}"
        MinHeight="{DynamicResource IndexMappingReportMinHeight}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgSurface}"
        Foreground="{DynamicResource BrushTextPrimary}"
        Title="DXF overlaps report">
  <Window.Styles>
    <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ButtonStyles.axaml"/>
    <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/TextStyles.axaml"/>
  </Window.Styles>
  <Border Padding="{DynamicResource Inset14}">
    <Grid x:Name="ReportLayout" RowDefinitions="Auto,*" RowSpacing="{DynamicResource Space12}">
      <StackPanel x:Name="ReportSummary" Spacing="{DynamicResource Space12}">
        <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                             Foreground="{DynamicResource BrushTextMuted}"/>
        <SelectableTextBlock Text="{Binding IssueTitle}" Classes="bodyStrong"/>
      </StackPanel>
      <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="{DynamicResource Space12}">
        <Border Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="{DynamicResource BorderThin}"
                CornerRadius="{DynamicResource RadiusSm}"
                Padding="{DynamicResource Inset8}">
          <TextBox x:Name="ReportTextBox"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource FontFamilyCode}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Text="{Binding ReportText, Mode=OneWay}"/>
        </Border>
        <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="{DynamicResource BorderTopThin}" Padding="{DynamicResource InsetTop10}">
          <Grid x:Name="ReportFooter" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space12}">
            <TextBlock x:Name="CopyResult" Text="{Binding CopyResultText}" IsVisible="{Binding HasCopyResult}"
                       Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Classes="actionPrimary" Content="Copy all"
                    HorizontalAlignment="Right" Click="CopyAll_Click" ToolTip.Tip="Copy overlap report text."/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
