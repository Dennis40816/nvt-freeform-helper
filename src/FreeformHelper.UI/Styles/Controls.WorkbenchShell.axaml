<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FreeformHelper.UI.Views">
  <!-- SidePanelGrid uses the Grid style key. Keep the nested Simulation row splitter outside this shell selector. -->
  <Style Selector="views|SimulationWorkspaceView > Grid > Grid > GridSplitter, views|CoordinatePlannerWorkspaceView > Grid > GridSplitter">
    <Setter Property="Width" Value="{StaticResource SplitterThickness}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="ShowsPreview" Value="True"/>
  </Style>
</Styles>
