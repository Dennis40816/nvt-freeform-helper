<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
        x:DataType="panels:WorkspaceShell">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Nvt.Core.Avalonia/Icons/IconResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- This view keeps the soft choice-row fill; the application default is None. -->
      <x:String x:Key="Nvt.Controls.RestFillMode">Soft</x:String>
    </ResourceDictionary>
  </Styles.Resources>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ChoiceStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ListStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Primitives/PrimitivesStyles.axaml"/>
  <!-- The window title names the view, so the shell header takes no space. -->
  <Style Selector="panels|WorkspaceShell.exportRows /template/ StackPanel">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="panels|WorkspaceShell.exportRows /template/ Border > Grid">
    <Setter Property="RowSpacing" Value="{DynamicResource Space8}"/>
  </Style>
  <Style Selector="panels|WorkspaceShell.exportRows /template/ Border.workspaceTopLayerBox">
    <Setter Property="Background" Value="{x:Null}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderNone}"/>
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
  </Style>
  <Style Selector="Border.exportCheckRow">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}"/>
    <Setter Property="Padding" Value="{DynamicResource Inset8_6}"/>
  </Style>
  <Style Selector="Border.exportCheckRow controls|FontIcon.exportCheckWarning">
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="Border.exportCode">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}"/>
    <Setter Property="Padding" Value="{DynamicResource Inset8_6}"/>
  </Style>
  <Style Selector="SelectableTextBlock.exportFooterStatus.warning">
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>
  <!-- The passed checks cover table rows, so the popup surface is opaque. -->
  <Style Selector="FlyoutPresenter.exportChecks">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}"/>
  </Style>
  <Style Selector="CheckBox.exportRowCheck">
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="CheckBox.exportRowCheck /template/ Border#ChoiceRow">
    <Setter Property="Tag" Value="None"/>
  </Style>
  <!-- The first item of an IC group also holds the group header. Core draws selection on the whole item,
       so these rows draw the fill, the selection mark and the focus ring on the data row only. -->
  <Style Selector="ListBox.notchExportRows ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem /template/ Border#ListSelectionIndicator">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem /template/ Border#ListFocusRing">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ContentControl.exportIcGroup">
    <Setter Property="Margin" Value="{DynamicResource Nvt.List.RowPadding}"/>
  </Style>
  <!-- Core sets the state colors on the item. The data row and its mark read them from there. -->
  <Style Selector="ListBox.notchExportRows ListBoxItem Border.exportRowFill">
    <Setter Property="Background" Value="{Binding $parent[ListBoxItem].Background}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem Border.exportRowMark">
    <Setter Property="Background" Value="{Binding $parent[ListBoxItem].Foreground}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows Border.exportRowFill">
    <Setter Property="MinHeight" Value="{DynamicResource NfcControlHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource Nvt.List.RowPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.Shape.ControlCornerRadius}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows Border.exportRowMark">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Width" Value="{DynamicResource Nvt.List.SelectionIndicatorWidth}"/>
    <Setter Property="Height" Value="{DynamicResource Nvt.List.SelectionIndicatorHeight}"/>
    <Setter Property="Margin" Value="{DynamicResource Nvt.List.SelectionIndicatorMargin}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.Shape.RoundCornerRadius}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected Border.exportRowMark">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="ListBox.notchExportRows Border.exportRowFocus">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Margin" Value="{DynamicResource Nvt.Controls.InsetFocusRingMargin}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Nvt.Controls.FocusBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource Nvt.Focus.RingThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Nvt.List.FocusCornerRadius}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:focus-visible:not(:disabled) Border.exportRowFocus">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck">
    <Setter Property="Foreground" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Border#ChoiceIndicator">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Path#ChoiceCheck">
    <Setter Property="Stroke" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Border#ChoiceRow">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
  </Style>
</Styles>
