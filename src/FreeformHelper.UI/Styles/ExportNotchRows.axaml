<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
        x:DataType="panels:WorkspaceShell">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Nvt.Core.Avalonia/Icons/IconResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- This view keeps the soft choice-row fill; the application default is None. -->
      <x:String x:Key="Nvt.Controls.RestFillMode">Soft</x:String>
    </ResourceDictionary>
  </Styles.Resources>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ChoiceStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ListStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Primitives/PrimitivesStyles.axaml"/>
  <!-- The window title names the view, so the shell header takes no space. -->
  <Style Selector="panels|WorkspaceShell.exportRows /template/ StackPanel">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="panels|WorkspaceShell.exportRows /template/ Border > Grid">
    <Setter Property="RowSpacing" Value="{DynamicResource Space8}"/>
  </Style>
  <Style Selector="panels|WorkspaceShell.exportRows /template/ Border.workspaceTopLayerBox">
    <Setter Property="Background" Value="{x:Null}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderNone}"/>
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
  </Style>
  <Style Selector="Border.exportCheckRow">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}"/>
    <Setter Property="Padding" Value="{DynamicResource Inset8_6}"/>
  </Style>
  <Style Selector="Border.exportCheckRow controls|FontIcon.exportCheckWarning">
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="Border.exportCode">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource NfcCompactCornerRadius}"/>
    <Setter Property="Padding" Value="{DynamicResource Inset8_6}"/>
  </Style>
  <Style Selector="SelectableTextBlock.exportFooterStatus.warning">
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>
  <!-- The passed checks cover table rows, so the popup surface is opaque. -->
  <Style Selector="FlyoutPresenter.exportChecks">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}"/>
  </Style>
  <Style Selector="CheckBox.exportRowCheck">
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="CheckBox.exportRowCheck /template/ Border#ChoiceRow">
    <Setter Property="Tag" Value="None"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck">
    <Setter Property="Foreground" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Border#ChoiceIndicator">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Path#ChoiceCheck">
    <Setter Property="Stroke" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Border#ChoiceRow">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
  </Style>
</Styles>
