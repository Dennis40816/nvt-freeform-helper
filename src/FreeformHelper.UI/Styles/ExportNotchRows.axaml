<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:panels="clr-namespace:Nvt.Core.Avalonia.Panels;assembly=Nvt.Core.Avalonia"
        x:DataType="panels:WorkspaceShell">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Nvt.Core.Avalonia/Icons/IconResources.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ButtonStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ChoiceStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ListStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Panels/PanelsStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Primitives/PrimitivesStyles.axaml"/>
  <Style Selector="panels|WorkspaceShell.exportRows /template/ SelectableTextBlock.workspaceMainTitle">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="panels|WorkspaceShell.exportRows /template/ Border.workspaceTopLayerBox">
    <Setter Property="Background" Value="{x:Null}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderNone}"/>
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
  </Style>
  <Style Selector="CheckBox.exportRowCheck">
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.actionGhost controls|FontIcon">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
  </Style>
  <Style Selector="CheckBox.exportRowCheck /template/ Border#ChoiceRow">
    <Setter Property="Tag" Value="None"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck">
    <Setter Property="Foreground" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Border#ChoiceIndicator">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Path#ChoiceCheck">
    <Setter Property="Stroke" Value="{DynamicResource Nvt.List.SelectedLabelBrush}"/>
  </Style>
  <Style Selector="ListBox.notchExportRows ListBoxItem:selected CheckBox.exportRowCheck /template/ Border#ChoiceRow">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
  </Style>
</Styles>
