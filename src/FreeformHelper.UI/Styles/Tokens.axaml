<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
                    xmlns:collections="clr-namespace:Avalonia.Collections;assembly=Avalonia.Base">
  <!-- Shared by the Core accent brush and Fluent's per-variant palette. -->
  <Color x:Key="ColorAccentDark">#53A6FF</Color>
  <Color x:Key="ColorAccentLight">#2967A9</Color>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="NfcAccentBrush" Color="{StaticResource ColorAccentDark}"/>
      <SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Color="{StaticResource ColorAccentDark}"/>
      <SolidColorBrush x:Key="NfcAccentStrongBrush" Color="#86C0FF"/>
      <SolidColorBrush x:Key="NfcAccentSurfaceBrush" Color="#192941"/>
      <SolidColorBrush x:Key="NfcAccentSurfaceSubtleBrush" Color="#152134"/>
      <SolidColorBrush x:Key="NfcAccentBorderBrush" Color="#53A6FF"/>
      <SolidColorBrush x:Key="NfcAccentBorderStrongBrush" Color="#86C0FF"/>
      <SolidColorBrush x:Key="NfcAccentBorderLightBrush" Color="#53A6FF"/>
      <!-- Checked text toggle: white text stays readable, also on the dimmed canvas toolbar. -->
      <SolidColorBrush x:Key="BrushToggleCheckedBackground" Color="#2967A9"/>
      <SolidColorBrush x:Key="BrushToggleCheckedForeground" Color="#FFFFFF"/>
      <!-- Canvas toolbar opacity at rest. -->
      <x:Double x:Key="OpacityCanvasQuickToolbarIdle">0.3</x:Double>
      <x:Double x:Key="OpacityViewportActionIdle">0.72</x:Double>
      <!-- NFH accent and tool data colors. Core owns neutral and semantic brushes. -->
      <Color x:Key="ColorWhite">#FFFFFF</Color>
      <Color x:Key="ColorBlack">#000000</Color>
      <Color x:Key="ColorSimulationScaleLow">#236CFF</Color>
      <Color x:Key="ColorSimulationScaleZero">#32FF6A</Color>
      <Color x:Key="ColorSimulationScaleMid">#FFD230</Color>
      <Color x:Key="ColorSimulationScaleWarm">#FF8A1F</Color>
      <Color x:Key="ColorSimulationScaleHigh">#FF4028</Color>
      <Color x:Key="ColorSimulationScaleNeutral">#6B7280</Color>
      <Color x:Key="ColorSimulationCopperHalo">#3858F8FF</Color>
      <Color x:Key="ColorSimulationCopperRim">#B8A6FFFF</Color>
      <Color x:Key="ColorSimulationCopperFill">#1627F5FF</Color>
      <Color x:Key="ColorSimulationCopperCenter">#FFFFFFFF</Color>
      <Color x:Key="ColorCoordinatePlannerGuide">#5DE2A5</Color>
      <Color x:Key="ColorCoordinatePlannerPoint">#FFD166</Color>
      <Color x:Key="ColorCoordinatePlannerBist">#FF7A2B</Color>
      <Color x:Key="ColorCoordinatePlannerArray">#8B7BFF</Color>
      <Color x:Key="ColorCoordinatePlannerLabelBackground">#CC0F131A</Color>
      <Color x:Key="ColorCoordinatePlannerLabelForeground">#E8EDF4</Color>

      <!-- Pad info popover -->
      <Color x:Key="ColorPadInfoPanelBackground">#B20F131A</Color>
      <!-- BoxShadow format: offsetX offsetY blur spread color, separated by commas -->
      <media:BoxShadows x:Key="ShadowPadInfoConfirm">0 0 0 1 #2B4A73, 0 0 16 0 #0E1A2B</media:BoxShadows>

      <!-- Canvas colors -->
      <Color x:Key="ColorCanvasBackground">#0A0A0A</Color>
      <Color x:Key="ColorCanvasAxisLabel">#D2DCF0</Color>
      <Color x:Key="ColorCanvasIcBlockFill">#1F4DA3FF</Color>
      <Color x:Key="ColorCanvasIcBlockStroke">#A04DA3FF</Color>
      <Color x:Key="ColorCanvasSelection">#50A0FF</Color>
      <Color x:Key="ColorCanvasSelectionFill">#1250A0FF</Color>
      <Color x:Key="ColorCanvasRegularSelected">#FFC878</Color>
      <Color x:Key="ColorCanvasRegularFreeform">#FFB450</Color>
      <Color x:Key="ColorCanvasRegularFreeformHatchPrimary">#E45858</Color>
      <Color x:Key="ColorCanvasRegularFreeformHatchSecondary">#5CD08B</Color>
      <Color x:Key="ColorCanvasRegularUnmatched">#FF5A5A</Color>
      <Color x:Key="ColorCanvasCadSelected">#78C8FF</Color>
      <Color x:Key="ColorCanvasCadFillDefault">#23C8C8C8</Color>
      <Color x:Key="ColorCanvasCadFillSelected">#5A78C8FF</Color>
      <Color x:Key="ColorCanvasCadOverlapFill">#35FFB86B</Color>
      <Color x:Key="ColorCanvasCadLine">#78C8FF</Color>
      <Color x:Key="ColorCanvasCadOverlapStroke">#FFB86B</Color>
      <Color x:Key="ColorCanvasDiffIdxOverride">#FFD166</Color>
      <Color x:Key="ColorCanvasDiffIdxAnchor">#5DE2A5</Color>
      <Color x:Key="ColorCanvasRegularLine">#F45C5C</Color>
      <Color x:Key="ColorCanvasMatchRatioLabel">#ECF3FF</Color>
      <Color x:Key="ColorCanvasMatchRatioBackground">#B8212B3A</Color>
      <Color x:Key="ColorCanvasMatchRatioBorder">#8AB6FF</Color>
      <Color x:Key="ColorCanvasNotchRatioLabel">#FFF2DE</Color>
      <Color x:Key="ColorCanvasNotchRatioBackground">#B82A1E12</Color>
      <Color x:Key="ColorCanvasNotchRatioBorder">#FFB86B</Color>
      <Color x:Key="ColorNotchCadStroke">#78C8FF</Color>
      <SolidColorBrush x:Key="BrushNotchExplanationNeighbor" Color="#507493"/>
      <SolidColorBrush x:Key="BrushNotchExplanationRegular" Color="#FF5064"/>
      <SolidColorBrush x:Key="BrushNotchExplanationArea" Color="#FFB767"/>
      <SolidColorBrush x:Key="BrushNotchExplanationReachFill" Color="#20FF9F43"/>
      <SolidColorBrush x:Key="BrushNotchExplanationReachOutline" Color="#FF9F43"/>
      <DrawingBrush x:Key="BrushNotchExplanationHatch" TileMode="Tile" Stretch="None" SourceRect="0,0,8,8" DestinationRect="0,0,8,8">
        <DrawingBrush.Drawing>
          <GeometryDrawing Geometry="M -8,8 L 0,0 M 0,8 L 8,0 M 8,8 L 16,0">
            <GeometryDrawing.Pen><Pen Brush="#FFB767" Thickness="{DynamicResource NotchExplanationHatchWidth}"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <Color x:Key="ColorNotchCadFill">#2A78C8FF</Color>
      <Color x:Key="ColorNotchRegularStroke">#C8D0DB</Color>
      <Color x:Key="ColorNotchToFullOutline">#FF9F43</Color>
      <Color x:Key="ColorNotchToFullFill">#4DFF9F43</Color>
      <Color x:Key="ColorNotchToFullSeedOutline">#5DE2A5</Color>
      <Color x:Key="ColorNotchToFullSeedFill">#305DE2A5</Color>
      <Color x:Key="ColorNotchToFullCandidateOutline">#FFD166</Color>
      <Color x:Key="ColorNotchToFullCandidateFill">#33FFD166</Color>
      <Color x:Key="ColorNotchX">#4FD1A5</Color>
      <Color x:Key="ColorNotchY">#4DA3FF</Color>
      <Color x:Key="ColorNotchXY">#FF6B6B</Color>

      <!-- CAD area bucket palette (bright, high contrast) -->
      <Color x:Key="ColorCadAreaBucket1">#00BCD4</Color>
      <Color x:Key="ColorCadAreaBucket2">#2196F3</Color>
      <Color x:Key="ColorCadAreaBucket3">#3F51B5</Color>
      <Color x:Key="ColorCadAreaBucket4">#9C27B0</Color>
      <Color x:Key="ColorCadAreaBucket5">#E91E63</Color>
      <Color x:Key="ColorCadAreaBucket6">#F44336</Color>
      <Color x:Key="ColorCadAreaBucket7">#FF5722</Color>
      <Color x:Key="ColorCadAreaBucket8">#FF9800</Color>
      <Color x:Key="ColorCadAreaBucket9">#FFC107</Color>
      <Color x:Key="ColorCadAreaBucket10">#4CAF50</Color>
      <Color x:Key="ColorCadAreaBucket11">#8BC34A</Color>
      <Color x:Key="ColorCadAreaBucket12">#009688</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="NfcAccentBrush" Color="{StaticResource ColorAccentLight}"/>
      <SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Color="{StaticResource ColorAccentLight}"/>
      <SolidColorBrush x:Key="NfcAccentStrongBrush" Color="#225489"/>
      <SolidColorBrush x:Key="NfcAccentSurfaceBrush" Color="#F0F4F9"/>
      <SolidColorBrush x:Key="NfcAccentSurfaceSubtleBrush" Color="#F8FAFC"/>
      <SolidColorBrush x:Key="NfcAccentBorderBrush" Color="#2967A9"/>
      <SolidColorBrush x:Key="NfcAccentBorderStrongBrush" Color="#225489"/>
      <SolidColorBrush x:Key="NfcAccentBorderLightBrush" Color="#2967A9"/>
      <!-- Checked text toggle: white text stays readable, also on the dimmed canvas toolbar. -->
      <SolidColorBrush x:Key="BrushToggleCheckedBackground" Color="#2967A9"/>
      <SolidColorBrush x:Key="BrushToggleCheckedForeground" Color="#FFFFFF"/>
      <!-- Canvas toolbar and floating button opacity at rest. Avalonia applies opacity to every shape, so on the
           white canvas lower values drop a checked toggle or a button glyph below 3:1. -->
      <x:Double x:Key="OpacityCanvasQuickToolbarIdle">0.85</x:Double>
      <x:Double x:Key="OpacityViewportActionIdle">0.8</x:Double>
      <!-- NFH accent and tool data colors. Core owns neutral and semantic brushes. -->
      <Color x:Key="ColorWhite">#FFFFFF</Color>
      <Color x:Key="ColorBlack">#000000</Color>
      <Color x:Key="ColorSimulationScaleLow">#1E63E4</Color>
      <Color x:Key="ColorSimulationScaleZero">#159F45</Color>
      <Color x:Key="ColorSimulationScaleMid">#D99512</Color>
      <Color x:Key="ColorSimulationScaleWarm">#C96B12</Color>
      <Color x:Key="ColorSimulationScaleHigh">#D12C1D</Color>
      <Color x:Key="ColorSimulationScaleNeutral">#7B8798</Color>
      <Color x:Key="ColorSimulationCopperHalo">#333A83D8</Color>
      <Color x:Key="ColorSimulationCopperRim">#D03A83D8</Color>
      <Color x:Key="ColorSimulationCopperFill">#141E88E5</Color>
      <Color x:Key="ColorSimulationCopperCenter">#FFFFFFFF</Color>
      <Color x:Key="ColorCoordinatePlannerGuide">#159F45</Color>
      <Color x:Key="ColorCoordinatePlannerPoint">#C77D1A</Color>
      <Color x:Key="ColorCoordinatePlannerBist">#D35400</Color>
      <Color x:Key="ColorCoordinatePlannerArray">#6A5AE0</Color>
      <Color x:Key="ColorCoordinatePlannerLabelBackground">#EFFFFFFF</Color>
      <Color x:Key="ColorCoordinatePlannerLabelForeground">#1E2430</Color>

      <!-- Pad info popover -->
      <Color x:Key="ColorPadInfoPanelBackground">#E6FFFFFF</Color>
      <!-- BoxShadow format: offsetX offsetY blur spread color, separated by commas -->
      <media:BoxShadows x:Key="ShadowPadInfoConfirm">0 0 0 1 #B8C1CC, 0 0 16 0 #00000020</media:BoxShadows>

      <!-- Canvas colors (light theme placeholders) -->
      <Color x:Key="ColorCanvasBackground">#FFFFFF</Color>
      <Color x:Key="ColorCanvasAxisLabel">#1E2430</Color>
      <Color x:Key="ColorCanvasIcBlockFill">#142B6CB0</Color>
      <Color x:Key="ColorCanvasIcBlockStroke">#8A2B6CB0</Color>
      <Color x:Key="ColorCanvasSelection">#2B6CB0</Color>
      <Color x:Key="ColorCanvasSelectionFill">#122B6CB0</Color>
      <Color x:Key="ColorCanvasRegularSelected">#C77D1A</Color>
      <Color x:Key="ColorCanvasRegularFreeform">#DD6B20</Color>
      <Color x:Key="ColorCanvasRegularFreeformHatchPrimary">#C43B3B</Color>
      <Color x:Key="ColorCanvasRegularFreeformHatchSecondary">#2F855A</Color>
      <Color x:Key="ColorCanvasRegularUnmatched">#D64545</Color>
      <Color x:Key="ColorCanvasCadSelected">#2B6CB0</Color>
      <Color x:Key="ColorCanvasCadFillDefault">#23CCCCCC</Color>
      <Color x:Key="ColorCanvasCadFillSelected">#5A2B6CB0</Color>
      <Color x:Key="ColorCanvasCadOverlapFill">#30C77D1A</Color>
      <Color x:Key="ColorCanvasCadLine">#2B6CB0</Color>
      <Color x:Key="ColorCanvasCadOverlapStroke">#C77D1A</Color>
      <Color x:Key="ColorCanvasDiffIdxOverride">#C77D1A</Color>
      <Color x:Key="ColorCanvasDiffIdxAnchor">#2F855A</Color>
      <Color x:Key="ColorCanvasRegularLine">#D64545</Color>
      <Color x:Key="ColorCanvasMatchRatioLabel">#1E2430</Color>
      <Color x:Key="ColorCanvasMatchRatioBackground">#E8FFFFFF</Color>
      <Color x:Key="ColorCanvasMatchRatioBorder">#8A2B6CB0</Color>
      <Color x:Key="ColorCanvasNotchRatioLabel">#3E2A16</Color>
      <Color x:Key="ColorCanvasNotchRatioBackground">#F4FFF5E8</Color>
      <Color x:Key="ColorCanvasNotchRatioBorder">#C77D1A</Color>
      <Color x:Key="ColorNotchCadStroke">#2B6CB0</Color>
      <SolidColorBrush x:Key="BrushNotchExplanationNeighbor" Color="#9AAFC0"/>
      <SolidColorBrush x:Key="BrushNotchExplanationRegular" Color="#DB3349"/>
      <SolidColorBrush x:Key="BrushNotchExplanationArea" Color="#C77D1A"/>
      <SolidColorBrush x:Key="BrushNotchExplanationReachFill" Color="#20C77D1A"/>
      <SolidColorBrush x:Key="BrushNotchExplanationReachOutline" Color="#C77D1A"/>
      <DrawingBrush x:Key="BrushNotchExplanationHatch" TileMode="Tile" Stretch="None" SourceRect="0,0,8,8" DestinationRect="0,0,8,8">
        <DrawingBrush.Drawing>
          <GeometryDrawing Geometry="M -8,8 L 0,0 M 0,8 L 8,0 M 8,8 L 16,0">
            <GeometryDrawing.Pen><Pen Brush="#C77D1A" Thickness="{DynamicResource NotchExplanationHatchWidth}"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <Color x:Key="ColorNotchCadFill">#2A2B6CB0</Color>
      <Color x:Key="ColorNotchRegularStroke">#3E4A5A</Color>
      <Color x:Key="ColorNotchToFullOutline">#C77D1A</Color>
      <Color x:Key="ColorNotchToFullFill">#3DC77D1A</Color>
      <Color x:Key="ColorNotchToFullSeedOutline">#2F855A</Color>
      <Color x:Key="ColorNotchToFullSeedFill">#2D2F855A</Color>
      <Color x:Key="ColorNotchToFullCandidateOutline">#C77D1A</Color>
      <Color x:Key="ColorNotchToFullCandidateFill">#33C77D1A</Color>
      <Color x:Key="ColorNotchX">#2F855A</Color>
      <Color x:Key="ColorNotchY">#2B6CB0</Color>
      <Color x:Key="ColorNotchXY">#D64545</Color>

      <!-- CAD area bucket palette (bright, high contrast) -->
      <Color x:Key="ColorCadAreaBucket1">#00ACC1</Color>
      <Color x:Key="ColorCadAreaBucket2">#1E88E5</Color>
      <Color x:Key="ColorCadAreaBucket3">#3949AB</Color>
      <Color x:Key="ColorCadAreaBucket4">#8E24AA</Color>
      <Color x:Key="ColorCadAreaBucket5">#D81B60</Color>
      <Color x:Key="ColorCadAreaBucket6">#E53935</Color>
      <Color x:Key="ColorCadAreaBucket7">#F4511E</Color>
      <Color x:Key="ColorCadAreaBucket8">#FB8C00</Color>
      <Color x:Key="ColorCadAreaBucket9">#FFB300</Color>
      <Color x:Key="ColorCadAreaBucket10">#43A047</Color>
      <Color x:Key="ColorCadAreaBucket11">#7CB342</Color>
      <Color x:Key="ColorCadAreaBucket12">#00897B</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Brushes -->
  <SolidColorBrush x:Key="BrushWhite" Color="{DynamicResource ColorWhite}"/>
  <SolidColorBrush x:Key="BrushBlack" Color="{DynamicResource ColorBlack}"/>
  <SolidColorBrush x:Key="BrushSimulationScaleLow" Color="{DynamicResource ColorSimulationScaleLow}"/>
  <SolidColorBrush x:Key="BrushSimulationScaleZero" Color="{DynamicResource ColorSimulationScaleZero}"/>
  <SolidColorBrush x:Key="BrushSimulationScaleMid" Color="{DynamicResource ColorSimulationScaleMid}"/>
  <SolidColorBrush x:Key="BrushSimulationScaleWarm" Color="{DynamicResource ColorSimulationScaleWarm}"/>
  <SolidColorBrush x:Key="BrushSimulationScaleNeutral" Color="{DynamicResource ColorSimulationScaleNeutral}"/>
  <SolidColorBrush x:Key="BrushSimulationScaleHigh" Color="{DynamicResource ColorSimulationScaleHigh}"/>
  <SolidColorBrush x:Key="BrushSimulationCopperHalo" Color="{DynamicResource ColorSimulationCopperHalo}"/>
  <SolidColorBrush x:Key="BrushSimulationCopperRim" Color="{DynamicResource ColorSimulationCopperRim}"/>
  <SolidColorBrush x:Key="BrushSimulationCopperFill" Color="{DynamicResource ColorSimulationCopperFill}"/>
  <SolidColorBrush x:Key="BrushSimulationCopperCenter" Color="{DynamicResource ColorSimulationCopperCenter}"/>
  <SolidColorBrush x:Key="BrushCoordinatePlannerGuide" Color="{DynamicResource ColorCoordinatePlannerGuide}"/>
  <SolidColorBrush x:Key="BrushCoordinatePlannerPoint" Color="{DynamicResource ColorCoordinatePlannerPoint}"/>
  <SolidColorBrush x:Key="BrushCoordinatePlannerBist" Color="{DynamicResource ColorCoordinatePlannerBist}"/>
  <SolidColorBrush x:Key="BrushCoordinatePlannerArray" Color="{DynamicResource ColorCoordinatePlannerArray}"/>
  <SolidColorBrush x:Key="BrushCoordinatePlannerLabelBackground" Color="{DynamicResource ColorCoordinatePlannerLabelBackground}"/>
  <SolidColorBrush x:Key="BrushCoordinatePlannerLabelForeground" Color="{DynamicResource ColorCoordinatePlannerLabelForeground}"/>
  <LinearGradientBrush x:Key="BrushSimulationScaleSequential"
                       StartPoint="0,0.5"
                       EndPoint="1,0.5">
    <GradientStop Offset="0"
                  Color="{DynamicResource ColorSimulationScaleZero}"/>
    <GradientStop Offset="0.58"
                  Color="{DynamicResource ColorSimulationScaleMid}"/>
    <GradientStop Offset="0.82"
                  Color="{DynamicResource ColorSimulationScaleWarm}"/>
    <GradientStop Offset="1"
                  Color="{DynamicResource ColorSimulationScaleHigh}"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BrushSimulationScaleDiverging"
                       StartPoint="0,0.5"
                       EndPoint="1,0.5">
    <GradientStop Offset="0"
                  Color="{DynamicResource ColorSimulationScaleLow}"/>
    <GradientStop Offset="0.5"
                  Color="{DynamicResource ColorSimulationScaleZero}"/>
    <GradientStop Offset="0.78"
                  Color="{DynamicResource ColorSimulationScaleMid}"/>
    <GradientStop Offset="0.9"
                  Color="{DynamicResource ColorSimulationScaleWarm}"/>
    <GradientStop Offset="1"
                  Color="{DynamicResource ColorSimulationScaleHigh}"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="BrushTransparent" Color="Transparent"/>

  <SolidColorBrush x:Key="BrushPadInfoPanelBackground" Color="{DynamicResource ColorPadInfoPanelBackground}"/>

  <SolidColorBrush x:Key="BrushCanvasBackground" Color="{DynamicResource ColorCanvasBackground}"/>
  <SolidColorBrush x:Key="BrushCanvasAxisLabel" Color="{DynamicResource ColorCanvasAxisLabel}"/>
  <SolidColorBrush x:Key="BrushCanvasIcBlockFill" Color="{DynamicResource ColorCanvasIcBlockFill}"/>
  <SolidColorBrush x:Key="BrushCanvasIcBlockStroke" Color="{DynamicResource ColorCanvasIcBlockStroke}"/>
  <SolidColorBrush x:Key="BrushCanvasSelection" Color="{DynamicResource ColorCanvasSelection}"/>
  <SolidColorBrush x:Key="BrushCanvasSelectionFill" Color="{DynamicResource ColorCanvasSelectionFill}"/>
  <SolidColorBrush x:Key="BrushCanvasRegularSelected" Color="{DynamicResource ColorCanvasRegularSelected}"/>
  <SolidColorBrush x:Key="BrushCanvasRegularFreeform" Color="{DynamicResource ColorCanvasRegularFreeform}"/>
  <SolidColorBrush x:Key="BrushCanvasRegularUnmatched" Color="{DynamicResource ColorCanvasRegularUnmatched}"/>
  <SolidColorBrush x:Key="BrushCanvasCadSelected" Color="{DynamicResource ColorCanvasCadSelected}"/>
  <SolidColorBrush x:Key="BrushCanvasCadFillDefault" Color="{DynamicResource ColorCanvasCadFillDefault}"/>
  <SolidColorBrush x:Key="BrushCanvasCadFillSelected" Color="{DynamicResource ColorCanvasCadFillSelected}"/>
  <SolidColorBrush x:Key="BrushNotchCadStroke" Color="{DynamicResource ColorNotchCadStroke}"/>
  <SolidColorBrush x:Key="BrushNotchCadFill" Color="{DynamicResource ColorNotchCadFill}"/>
  <SolidColorBrush x:Key="BrushNotchRegularStroke" Color="{DynamicResource ColorNotchRegularStroke}"/>
  <SolidColorBrush x:Key="BrushNotchToFullOutline" Color="{DynamicResource ColorNotchToFullOutline}"/>
  <SolidColorBrush x:Key="BrushNotchToFullFill" Color="{DynamicResource ColorNotchToFullFill}"/>
  <SolidColorBrush x:Key="BrushNotchToFullSeedOutline" Color="{DynamicResource ColorNotchToFullSeedOutline}"/>
  <SolidColorBrush x:Key="BrushNotchToFullSeedFill" Color="{DynamicResource ColorNotchToFullSeedFill}"/>
  <SolidColorBrush x:Key="BrushNotchToFullCandidateOutline" Color="{DynamicResource ColorNotchToFullCandidateOutline}"/>
  <SolidColorBrush x:Key="BrushNotchToFullCandidateFill" Color="{DynamicResource ColorNotchToFullCandidateFill}"/>
  <SolidColorBrush x:Key="BrushNotchX" Color="{DynamicResource ColorNotchX}"/>
  <SolidColorBrush x:Key="BrushNotchY" Color="{DynamicResource ColorNotchY}"/>
  <SolidColorBrush x:Key="BrushNotchXY" Color="{DynamicResource ColorNotchXY}"/>

  <!-- Spacing -->
  <x:Double x:Key="Space0">0</x:Double>
  <x:Double x:Key="Space2">2</x:Double>
  <x:Double x:Key="Space1">1</x:Double>
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space6">6</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space10">10</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space14">14</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space18">18</x:Double>
  <x:Double x:Key="Space20">20</x:Double>
  <x:Double x:Key="Space24">24</x:Double>

  <!-- Insets -->
  <Thickness x:Key="Inset1">1</Thickness>
  <Thickness x:Key="InsetNone">0</Thickness>
  <Thickness x:Key="Inset2">2</Thickness>
  <Thickness x:Key="Inset4">4</Thickness>
  <Thickness x:Key="Inset6">6</Thickness>
  <Thickness x:Key="Inset8">8</Thickness>
  <Thickness x:Key="Inset10">10</Thickness>
  <Thickness x:Key="Inset14">14</Thickness>
  <Thickness x:Key="Inset12">12</Thickness>
  <Thickness x:Key="Inset16">16</Thickness>
  <Thickness x:Key="Inset20">20</Thickness>
  <Thickness x:Key="Inset24">24</Thickness>
  <Thickness x:Key="Inset10_4">10,4</Thickness>
  <Thickness x:Key="Inset10_6">10,6</Thickness>
  <Thickness x:Key="Inset10_8">10,8</Thickness>
  <Thickness x:Key="Inset12_8">12,8</Thickness>
  <Thickness x:Key="Inset12_10">12,10</Thickness>
  <Thickness x:Key="Inset14_6">14,6</Thickness>
  <Thickness x:Key="Inset14_8">14,8</Thickness>
  <Thickness x:Key="Inset8_4">8,4</Thickness>
  <Thickness x:Key="Inset8_6">8,6</Thickness>
  <Thickness x:Key="Inset6_4">6,4</Thickness>
  <Thickness x:Key="Inset6_2">6,2</Thickness>
  <Thickness x:Key="Inset10_8_10_12">10,8,10,12</Thickness>
  <Thickness x:Key="Inset10_10">10,10</Thickness>
  <Thickness x:Key="InsetRight10">0,0,10,0</Thickness>
  <Thickness x:Key="InsetRight12">0,0,12,0</Thickness>
  <Thickness x:Key="InsetRight12Bottom12">0,0,12,12</Thickness>
  <Thickness x:Key="InsetRight12Bottom16">0,0,12,16</Thickness>
  <Thickness x:Key="InsetRight12Bottom20">0,0,12,20</Thickness>
  <Thickness x:Key="InsetRight10Bottom12">0,0,10,12</Thickness>
  <Thickness x:Key="InsetRight12Bottom6">0,0,12,6</Thickness>
  <Thickness x:Key="InsetRight6">0,0,6,0</Thickness>
  <Thickness x:Key="InsetRight6Bottom2">0,0,6,2</Thickness>
  <Thickness x:Key="InsetRight6Bottom6">0,0,6,6</Thickness>
  <Thickness x:Key="InsetRight8">0,0,8,0</Thickness>
  <Thickness x:Key="InsetRight8Bottom8">0,0,8,8</Thickness>
  <Thickness x:Key="InsetRight8Bottom6">0,0,8,6</Thickness>
  <Thickness x:Key="InsetBottom2">0,0,0,2</Thickness>
  <Thickness x:Key="InsetBottom4">0,0,0,4</Thickness>
  <Thickness x:Key="InsetBottom6">0,0,0,6</Thickness>
  <Thickness x:Key="InsetBottom12">0,0,0,12</Thickness>
  <Thickness x:Key="InsetBottom20">0,0,0,20</Thickness>
  <Thickness x:Key="InsetTop4Bottom10">0,4,0,10</Thickness>
  <Thickness x:Key="InsetTop2Bottom8">0,2,0,8</Thickness>
  <Thickness x:Key="InsetTop2">0,2,0,0</Thickness>
  <Thickness x:Key="InsetTop4">0,4,0,0</Thickness>
  <Thickness x:Key="InsetTop8">0,8,0,0</Thickness>
