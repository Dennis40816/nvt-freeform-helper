<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls">
  <!-- Scope shared roles to these dialogs, keeping the rest of the app unchanged. -->
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ButtonStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ChoiceStyles.axaml"/>
  <StyleInclude Source="avares://Nvt.Core.Avalonia/Theme/ListStyles.axaml"/>

  <Style Selector="TextBlock.exportMuted, TextBlock.exportLabel">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.exportCount">
    <Setter Property="FontFamily" Value="{DynamicResource FontFamilyCode}"/>
    <Setter Property="TextAlignment" Value="Right"/>
  </Style>
  <Style Selector="TextBlock.exportLabel">
    <Setter Property="Width" Value="{DynamicResource LayerImageExportLabelWidth}"/>
  </Style>
  <Style Selector="controls|NumberScrubber.exportNumber">
    <Setter Property="Width" Value="{DynamicResource LayerImageExportFieldWidth}"/>
    <Setter Property="Height" Value="{DynamicResource NfcControlHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource NfcControlHeight}"/>
  </Style>
  <Style Selector="CheckBox.exportCheck">
    <Setter Property="MinHeight" Value="{DynamicResource LayerImageExportRowHeight}"/>
    <Setter Property="Height" Value="{DynamicResource LayerImageExportRowHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <!-- Keep Core's marks and interaction states; only compact the row geometry. -->
  <Style Selector="CheckBox.exportCheck /template/ Border#ChoiceRow">
    <Setter Property="Tag" Value="None"/>
  </Style>
  <Style Selector="CheckBox.exportCheck /template/ Border#ChoiceIndicator">
    <Setter Property="Width" Value="{DynamicResource Nvt.LayerImageExport.CheckIndicatorSize}"/>
    <Setter Property="Height" Value="{DynamicResource Nvt.LayerImageExport.CheckIndicatorSize}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="CheckBox.exportCheck /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="MinHeight" Value="{DynamicResource Nvt.LayerImageExport.CheckIndicatorSize}"/>
    <Setter Property="Margin" Value="{DynamicResource Nvt.Choice.LabelMargin}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.exportSearch">
    <Setter Property="Background" Value="{DynamicResource BrushBgSurfaceInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushFieldBorder}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource NfcSurfaceCornerRadius}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ListBox.exportLayers ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource LayerImageExportRowHeight}"/>
    <Setter Property="Height" Value="{DynamicResource LayerImageExportRowHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource InsetNone}"/>
  </Style>
  <!-- Checked rows own the mark. ListBox selection only tracks keyboard navigation. -->
  <Style Selector="ListBox.exportLayers ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Nvt.List.TransparentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
  </Style>
  <Style Selector="ListBox.exportLayers ListBoxItem:pointerover, ListBox.exportLayers ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushBgInteractiveHover}"/>
  </Style>
  <Style Selector="ListBox.exportLayers ListBoxItem:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushBgInteractivePressed}"/>
  </Style>
  <Style Selector="ListBox.exportLayers ListBoxItem:selected /template/ Border#ListSelectionIndicator">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Image.exportPreview.updating">
    <Setter Property="Opacity" Value="{DynamicResource OpacitySubtle}"/>
  </Style>
</Styles>
