<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls">
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
  </Style>

  <Style Selector="StackPanel.panelFormField">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Spacing" Value="{StaticResource PanelFormFieldSpacing}"/>
  </Style>

  <Style Selector="StackPanel.panelFormField.left">
    <Setter Property="Margin" Value="{StaticResource InsetFormColumnLeft}"/>
  </Style>

  <Style Selector="StackPanel.panelFormField.right">
    <Setter Property="Margin" Value="{StaticResource InsetFormColumnRight}"/>
  </Style>

  <Style Selector="StackPanel.panelForm TextBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderInput}"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
  </Style>

  <Style Selector="CheckBox, ToggleButton, MenuItem, NumericUpDown">
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}"/>
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderInput}"/>
  </Style>

  <Style Selector="ToggleSwitch:checked">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderControl}"/>
  </Style>

  <Style Selector="StackPanel.panelForm ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderInput}"/>
  </Style>

  <Style Selector="StackPanel.panelForm NumericUpDown">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="{StaticResource Inset6_4}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderInput}"/>
  </Style>

  <Style Selector="StackPanel.panelForm NumericUpDown TextBox">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="{StaticResource Inset6_4}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="StackPanel.panelForm NumericUpDown /template/ RepeatButton">
    <Setter Property="Width" Value="{StaticResource Space16}"/>
    <Setter Property="MinHeight" Value="{StaticResource Space10}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <Style Selector="StackPanel.panelForm TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
  </Style>

  <Style Selector="StackPanel.panelForm ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
  </Style>

  <Style Selector="ComboBox.boundLayerSelector">
    <Setter Property="MaxDropDownHeight" Value="{StaticResource LayerDropdownMaxHeight}"/>
  </Style>

  <Style Selector="StackPanel.panelForm NumericUpDown:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
  </Style>

  <Style Selector="StackPanel.panelForm NumericUpDown TextBox:focus">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- Custom numeric scrubber -->
  <Style Selector="controls|NumberScrubber">
    <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.panelFormField TextBlock, StackPanel.panelFormField SelectableTextBlock">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="StackPanel.panelFormField TextBox, StackPanel.panelFormField ComboBox, StackPanel.panelFormField NumericUpDown, StackPanel.panelFormField controls|NumberScrubber">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="ComboBox.regularLayerSelector">
    <Setter Property="MaxDropDownHeight" Value="{StaticResource LayerDropdownMaxHeight}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="ComboBox.regularLayerSelector /template/ Popup">
    <Setter Property="MinWidth" Value="{Binding $parent[ComboBox].Bounds.Width}"/>
    <Setter Property="MaxWidth" Value="{Binding $parent[ComboBox].Bounds.Width}"/>
    <Setter Property="PlacementConstraintAdjustment" Value="All"/>
  </Style>

  <Style Selector="ComboBox.regularLayerSelector ComboBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="ComboBox.regularLayerSelector /template/ ContentPresenter">
    <Setter Property="TextBlock.TextWrapping" Value="NoWrap"/>
    <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="ComboBox.regularLayerSelector ComboBoxItem SelectableTextBlock">
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="Border.numberScrubber">
    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.numberScrubber.focused">
    <Setter Property="Background" Value="{DynamicResource BrushBgInteractivePressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
  </Style>

  <Style Selector="TextBox.numberScrubberInput">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="{StaticResource Inset6_2}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="StackPanel.panelForm TextBox.numberScrubberInput">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="{StaticResource Inset6_2}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="TextBox.numberScrubberInput:focus, StackPanel.panelForm TextBox.numberScrubberInput:focus">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="Border.numberScrubberSpin">
    <Setter Property="Background" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderRightThin}"/>
    <Setter Property="Width" Value="{StaticResource SpinButtonWidth}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusRightMd}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style Selector="StackPanel.panelForm TextBlock, StackPanel.panelForm SelectableTextBlock">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="TabItem">
    <Setter Property="Padding" Value="{StaticResource Inset14_8}"/>
  </Style>

</Styles>
