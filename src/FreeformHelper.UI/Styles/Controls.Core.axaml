<Styles x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:icons="using:Nvt.Core.Avalonia.Icons"
        xmlns:primitives="clr-namespace:Nvt.Core.Avalonia.Primitives;assembly=Nvt.Core.Avalonia">
  <!-- Default look of buttons without a Core role. Keep these before every product button style:
       with :not() they have the same priority as class styles, so the later style wins. -->
  <Style Selector="Button:not(.actionPrimary):not(.actionNeutral):not(.actionDanger):not(.actionGhost):not(.actionIconButton):not(.chipAction)">
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_6}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="ToggleButton:not(.actionPrimary):not(.actionNeutral):not(.actionDanger):not(.actionGhost):not(.actionIconButton):not(.chipAction)">
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <!-- Slightly denser typography -->
  <Style Selector="TextBlock, SelectableTextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}"/>
  </Style>

  <Style Selector="Button SelectableTextBlock, ToggleButton SelectableTextBlock, CheckBox SelectableTextBlock, MenuItem SelectableTextBlock, ComboBox SelectableTextBlock, ComboBoxItem SelectableTextBlock">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>

  <Style Selector="Border.validationCountPill">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
  </Style>

  <Style Selector="SelectableTextBlock.validationCountText, TextBlock.validationCountText">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
  </Style>

  <Style Selector="Button.validationTraceRow">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Padding" Value="{StaticResource Inset8}"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
  </Style>

  <Style Selector="Button.validationTraceRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
  </Style>

  <Style Selector="Button.validationTraceRow:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.direct">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.incoming">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessTextBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.outgoing">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.validationRowKindText, TextBlock.validationRowKindText">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.direct SelectableTextBlock.validationRowKindText, Border.validationRowKindTag.direct TextBlock.validationRowKindText">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.incoming SelectableTextBlock.validationRowKindText, Border.validationRowKindTag.incoming TextBlock.validationRowKindText">
    <Setter Property="Foreground" Value="{DynamicResource NfcSuccessTextBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.outgoing SelectableTextBlock.validationRowKindText, Border.validationRowKindTag.outgoing TextBlock.validationRowKindText">
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.legacy">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcTextMutedBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.legacy SelectableTextBlock.validationRowKindText, Border.validationRowKindTag.legacy TextBlock.validationRowKindText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.nocad">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerTextBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.nocad SelectableTextBlock.validationRowKindText, Border.validationRowKindTag.nocad TextBlock.validationRowKindText">
    <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}"/>
  </Style>

  <Style Selector="Border.validationRowKindTag.workspaceContextBadge">
    <Setter Property="BorderThickness" Value="{StaticResource BorderNotchExportBadge}"/>
  </Style>

  <Style Selector="Grid.workspacePresetButtonContent">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space6}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspacePresetButtonLabel, TextBlock.workspacePresetButtonLabel">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>

  <Style Selector="StackPanel.infoTierRow">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="Spacing" Value="{StaticResource Space8}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Grid.infoTierRow">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space8}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.infoTierDot">
    <Setter Property="Width" Value="{StaticResource InspectorTierDotSize}"/>
    <Setter Property="Height" Value="{StaticResource InspectorTierDotSize}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.infoTierDot.summary">
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}"/>
  </Style>

  <Style Selector="Border.infoTierDot.detail">
    <Setter Property="Background" Value="{DynamicResource NfcTextMutedBrush}"/>
  </Style>

  <Style Selector="Border.infoTierDot.warning">
    <Setter Property="Background" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>

  <Style Selector="Border.infoTierDot.trace">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessTextBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.padInspectorLineValue, TextBlock.padInspectorLineValue">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.padInspectorLineLabel, TextBlock.padInspectorLineLabel">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.padInspectorLineLabel.padInspectorLineLabelKey, TextBlock.padInspectorLineLabel.padInspectorLineLabelKey">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.padInspectorLineLabel.padInspectorLineLabelWarning, TextBlock.padInspectorLineLabel.padInspectorLineLabelWarning">
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.padInspectorLineValue.padInspectorLineValueKey, TextBlock.padInspectorLineValue.padInspectorLineValueKey">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.padInspectorLineValue.padInspectorLineValueWarning, TextBlock.padInspectorLineValue.padInspectorLineValueWarning">
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.padInspectorFreeformSlashX, TextBlock.padInspectorFreeformSlashX">
    <Setter Property="Foreground" Value="{DynamicResource BrushNotchX}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="SelectableTextBlock.padInspectorFreeformSlashY, TextBlock.padInspectorFreeformSlashY">
    <Setter Property="Foreground" Value="{DynamicResource BrushNotchY}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Border.workspaceTopLayerBox">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_8}"/>
  </Style>

  <Style Selector="Border.workspaceFirstPeekBar">
    <Setter Property="Padding" Value="{StaticResource Inset12_10}"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderBottomThin}"/>
  </Style>

  <Style Selector="Border.workspaceSecondPeekBar">
    <Setter Property="Padding" Value="{StaticResource Inset12_10}"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderBottomThin}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceFirstPeekTitle, TextBlock.workspaceFirstPeekTitle">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeLg}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceFirstPeekSubtitle, TextBlock.workspaceFirstPeekSubtitle">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceSecondPeekStatus, TextBlock.workspaceSecondPeekStatus">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="StackPanel.workspaceHeaderSettingBlock">
    <Setter Property="Spacing" Value="{StaticResource Space4}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceMainTitle, TextBlock.workspaceMainTitle">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceHeaderMeta, TextBlock.workspaceHeaderMeta">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceToolbarLabel, TextBlock.workspaceToolbarLabel">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style Selector="SelectableTextBlock.chipStatusText, TextBlock.chipStatusText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceFilterResultText, TextBlock.workspaceFilterResultText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style Selector="Border.workspaceSectionCard">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceSectionTitle, TextBlock.workspaceSectionTitle">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Grid.workspaceSectionHeader">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space8}"/>
    <Setter Property="RowSpacing" Value="{StaticResource Space2}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceSectionSummary, TextBlock.workspaceSectionSummary">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="2"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceSectionMeta, TextBlock.workspaceSectionMeta">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceSectionMeta.compact, TextBlock.workspaceSectionMeta.compact">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="2"/>
  </Style>

  <Style Selector="Border.workspaceDetailStrip">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.workspaceDetailStrip.flat">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderTopThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusNone}"/>
  </Style>

  <Style Selector="Border.workspaceFileRow">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Grid.workspaceFileRowContent">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space8}"/>
  </Style>

  <Style Selector="controls|FontIcon.workspaceFileRowIcon">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource IconSizeMd}"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceFileRowTitle, TextBlock.workspaceFileRowTitle">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceFileRowMeta, TextBlock.workspaceFileRowMeta">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="ToggleButton.workspaceFoldHeader">
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="ToggleButton.workspaceFoldHeader controls|FontIcon">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
    <Setter Property="FontSize" Value="{StaticResource IconSizeSm}"/>
    <Setter Property="FontWeight" Value="Black"/>
  </Style>

  <Style Selector="Grid.workspaceFoldHeaderContent">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space8}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.workspaceFoldCornerBadge">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Width" Value="{StaticResource WorkspaceFoldCornerBadgeSize}"/>
    <Setter Property="Height" Value="{StaticResource WorkspaceFoldCornerBadgeSize}"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="{StaticResource InsetWorkspaceFoldCornerBadgeOffset}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.workspaceFoldCornerBadge.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerTextBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceFoldCornerBadgeText, TextBlock.workspaceFoldCornerBadgeText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>

  <Style Selector="Border.workspaceFoldCornerBadge.danger SelectableTextBlock.workspaceFoldCornerBadgeText, Border.workspaceFoldCornerBadge.danger TextBlock.workspaceFoldCornerBadgeText">
    <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}"/>
  </Style>

  <Style Selector="Border.workspaceFoldBody">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderTopThin}"/>
    <Setter Property="Padding" Value="{StaticResource InsetTop8}"/>
  </Style>

  <Style Selector="Border.workspaceGroupToolbarItem">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceGroupTitle, TextBlock.workspaceGroupTitle">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceGroupSummary, TextBlock.workspaceGroupSummary">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="Button.workspaceInfoButton">
    <Setter Property="MinWidth" Value="{StaticResource ProductControlMinHeight}"/>
  </Style>

  <Style Selector="ListBox.workspaceDataList:not(.coordinateArtifactList) ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="{StaticResource InsetBottom4}"/>
  </Style>

  <Style Selector="ListBox.workspaceFilterOptions ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="{StaticResource FormControlCompactHeight}"/>
  </Style>

  <Style Selector="Button.verificationTableRow, Button.workspaceDataRow">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Button.verificationTableRow:pointerover, Button.workspaceDataRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
  </Style>

  <Style Selector="Button.verificationTableRow.verificationTableRowActive, Button.workspaceDataRow.workspaceDataRowActive">
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}"/>
  </Style>

  <Style Selector="Button.verificationTableRow.verificationTableRowActive:pointerover, Button.workspaceDataRow.workspaceDataRowActive:pointerover">
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}"/>
  </Style>

  <Style Selector="SelectableTextBlock.verificationTableCellText, TextBlock.verificationTableCellText, SelectableTextBlock.workspaceDataCellText, TextBlock.workspaceDataCellText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style Selector="SelectableTextBlock.verificationTableCellText.strong, TextBlock.verificationTableCellText.strong, SelectableTextBlock.workspaceDataCellText.strong, TextBlock.workspaceDataCellText.strong">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Border.workspaceTableHeader">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceTableHeaderText, TextBlock.workspaceTableHeaderText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="Button.workspaceTableHeaderButton">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="Padding" Value="{StaticResource Inset6_2}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="{StaticResource ProductControlMinHeight}"/>
  </Style>

  <Style Selector="Button.workspaceTableHeaderButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}"/>
  </Style>

  <Style Selector="Button.workspaceTableHeaderButton.active">
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentBrush}"/>
  </Style>

  <Style Selector="Border.workspaceInspectorHost">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.workspaceInspectorContextStrip">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.workspaceInspectorSection">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceInspectorSectionTitle, TextBlock.workspaceInspectorSectionTitle">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceInspectorValue, TextBlock.workspaceInspectorValue">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceInspectorContextText, TextBlock.workspaceInspectorContextText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="Border.verificationStepRailNode">
    <Setter Property="Width" Value="{StaticResource VerificationStepRailNodeSize}"/>
    <Setter Property="Height" Value="{StaticResource VerificationStepRailNodeSize}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>

  <Style Selector="Border.verificationStepRailNode.active">
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}"/>
  </Style>

  <Style Selector="Border.verificationStepRailNode.pass">
    <Setter Property="Background" Value="{DynamicResource NfcSuccessTextBrush}"/>
  </Style>

  <Style Selector="Border.verificationStepRailNode.warning">
    <Setter Property="Background" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>

  <Style Selector="Border.verificationStepRailNode.blocked">
    <Setter Property="Background" Value="{DynamicResource NfcDangerTextBrush}"/>
  </Style>

  <Style Selector="Border.verificationStepRailConnector">
    <Setter Property="Width" Value="{StaticResource VerificationStepRailLineWidth}"/>
    <Setter Property="Margin" Value="{StaticResource InsetTop4}"/>
    <Setter Property="Background" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.workspaceCodeBlock">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workspaceCodeText, TextBlock.workspaceCodeText">
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyCode}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="Border.workspaceLinkItem">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8}"/>
    <Setter Property="Margin" Value="{StaticResource InsetBottom6}"/>
  </Style>

  <Style Selector="Border.notchExportRestoreHint">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_6}"/>
  </Style>

  <Style Selector="SelectableTextBlock.notchExportRestoreHintText, TextBlock.notchExportRestoreHintText">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Button.notchExportRestoreHintAction">
    <Setter Property="MinHeight" Value="{StaticResource ProductControlMinHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_6}"/>
  </Style>


  <Style Selector="Button:not(.actionPrimary):not(.actionNeutral):not(.actionDanger):not(.actionGhost):not(.actionIconButton):not(.chipAction):pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button:not(.actionPrimary):not(.actionNeutral):not(.actionDanger):not(.actionGhost):not(.actionIconButton):not(.chipAction):pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button:not(.actionPrimary):not(.actionNeutral):not(.actionDanger):not(.actionGhost):not(.actionIconButton):not(.chipAction):disabled:pointerover, Button:not(.actionPrimary):not(.actionNeutral):not(.actionDanger):not(.actionGhost):not(.actionIconButton):not(.chipAction):disabled:pressed">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}"/>
  </Style>

  <Style Selector="ToggleButton:not(.actionPrimary):not(.actionNeutral):not(.actionDanger):not(.actionGhost):not(.actionIconButton):not(.chipAction):disabled:pointerover, ToggleButton:not(.actionPrimary):not(.actionNeutral):not(.actionDanger):not(.actionGhost):not(.actionIconButton):not(.chipAction):disabled:pressed">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}"/>
  </Style>

  <Style Selector="StackPanel.panelForm">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="StackPanel.panelForm Button">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="primitives|BalancedWrapPanel.badgeGroup">
    <Setter Property="ItemSpacing" Value="{StaticResource Space6}"/>
    <Setter Property="LineSpacing" Value="{StaticResource Space6}"/>
    <Setter Property="BalanceLastRow" Value="True"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Grid.panelActionRow">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Button.dxfEditSummaryChip">
    <Setter Property="MinWidth" Value="{StaticResource DxfEditSummaryBadgeMinWidth}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="controls|FontIcon.dxfEditBadgeIcon">
    <Setter Property="FontSize" Value="{DynamicResource IconSizeMd}"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>

  <Style Selector="SelectableTextBlock.dxfEditSummaryBadgeText, TextBlock.dxfEditSummaryBadgeText">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="SelectableTextBlock.dxfEditSectionLabel, TextBlock.dxfEditSectionLabel">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="SelectableTextBlock.dxfEditSelectionSummary, TextBlock.dxfEditSelectionSummary">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="Border.dxfEditActionGroup">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8}"/>
  </Style>

  <Style Selector="SelectableTextBlock.dxfEditActionGroupLabel, TextBlock.dxfEditActionGroupLabel">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Grid.dxfEditActionGroupRow">
    <Setter Property="RowSpacing" Value="{StaticResource Space6}"/>
  </Style>

  <!-- Layer visibility is conveyed by the eye glyph and text, without a selected row surface. -->
  <Style Selector="ToggleButton.layerToggle:checked:not(:pointerover):not(:pressed)">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
  </Style>

  <Style Selector="ToggleButton.layerToggle:checked:not(:disabled)">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="ToggleButton.layerToggle:not(:checked):not(:disabled)">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
  </Style>

  <Style Selector="ToggleButton.dxfLayerBulkToggleButton">
    <Setter Property="Height" Value="{StaticResource ProductControlMinHeight}"/>
    <Setter Property="MinHeight" Value="{StaticResource ProductControlMinHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_4}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderInput}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Grid.dxfLayerBulkToggleContent">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space6}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Border.dxfLayerBulkMixedIndicator">
    <Setter Property="Width" Value="{StaticResource Space12}"/>
    <Setter Property="Height" Value="{StaticResource Space2}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="SelectableTextBlock.dxfLayerBulkToggleLabel, TextBlock.dxfLayerBulkToggleLabel">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Grid.dxfEditAlignedFieldRow">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space6}"/>
  </Style>

  <Style Selector="Border.dxfEditFieldActionSpacer">
    <Setter Property="Width" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
  </Style>

  <Style Selector="StackPanel.dxfEditMiniActionContent">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="controls|FontIcon.dxfEditMiniActionIcon">
    <Setter Property="FontSize" Value="{StaticResource IconSizeSm}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="SelectableTextBlock.dxfEditMiniActionLabel, TextBlock.dxfEditMiniActionLabel">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>

  <Style Selector="Button.simulationActionButton, ToggleButton.simulationActionButton, Button.workspaceActionButton, ToggleButton.workspaceActionButton">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Grid.iconTextButtonContent">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space6}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="controls|FontIcon.iconTextButtonLeadingIcon">
    <Setter Property="Width" Value="{StaticResource IconSizeSm}"/>
    <Setter Property="Height" Value="{StaticResource IconSizeSm}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="{StaticResource IconSizeSm}"/>
    <Setter Property="FontWeight" Value="Black"/>
  </Style>

  <Style Selector="Border.iconTextButtonTrailingSpacer">
    <Setter Property="Width" Value="{StaticResource IconSizeSm}"/>
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>

  <Style Selector="SelectableTextBlock.iconTextButtonLabel, TextBlock.iconTextButtonLabel">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MaxLines" Value="1"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="Border.dxfEditAdvancedContent">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderTopThin}"/>
    <Setter Property="Padding" Value="{StaticResource Inset12}"/>
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusBottomMd}"/>
  </Style>

  <Style Selector="Button.dxfEditCompactIconAction, ToggleButton.dxfEditCompactIconAction">
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <Style Selector="SelectableTextBlock.dxfEditFieldLabel, TextBlock.dxfEditFieldLabel">
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="Button, ToggleButton">
    <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
  </Style>
</Styles>
