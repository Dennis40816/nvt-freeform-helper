  </Style>

  <Style Selector="Button.actionGhost:focus-visible, ToggleButton.actionGhost:focus-visible">
    <Setter Property="Background" Value="{DynamicResource BrushActionFocusBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionFocusBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionFocusForeground}"/>
  </Style>

  <Style Selector="Button.actionGhost:pressed, ToggleButton.actionGhost:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushActionGhostPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionGhostPressed}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionFocusForeground}"/>
  </Style>

  <Style Selector="Button.actionGhost:disabled, ToggleButton.actionGhost:disabled">
    <Setter Property="Background" Value="{DynamicResource BrushActionGhostBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionGhostBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

