  <!-- Passive status chip role. -->
  <Style Selector="Border.chipStatus">
    <Setter Property="Background" Value="{DynamicResource BrushStatusChipBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushStatusChipBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderControl}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
    <Setter Property="MaxWidth" Value="{StaticResource WorkspaceSummaryChipMaxWidth}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.chipStatus.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
  </Style>

  <Style Selector="Border.chipStatus.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
  </Style>

  <Style Selector="Border.chipStatus.success">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
  </Style>

