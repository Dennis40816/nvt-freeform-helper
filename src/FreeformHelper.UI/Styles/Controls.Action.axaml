  <Style Selector="Button.actionIconButton.actionNeutral:disabled, Button.actionIconButton.actionPrimary:disabled, Button.actionIconButton.actionDanger:disabled, Button.actionIconButton.actionGhost:disabled, ToggleButton.actionIconButton.actionNeutral:disabled, ToggleButton.actionIconButton.actionPrimary:disabled, ToggleButton.actionIconButton.actionDanger:disabled, ToggleButton.actionIconButton.actionGhost:disabled">
