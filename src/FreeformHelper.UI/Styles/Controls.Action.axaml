<Styles x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls">
  <!-- Core owns public role appearance. These controls retain product geometry. -->
  <Style Selector="Button.viewportOverlayAction, ToggleButton.viewportOverlayAction, Button.canvasToolbarIcon, ToggleButton.canvasToolbarIcon">
    <Setter Property="Width" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="MinWidth" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="Height" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="MinHeight" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="Padding" Value="{StaticResource InsetNone}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="ToggleButton.viewportOverlayAction, ToggleButton.canvasQuickToggle, ToggleButton.canvasToolbarIcon, ToggleButton.productChipAction, ToggleButton.productFilterChip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Button.viewportOverlayAction, Button.canvasQuickToggle, Button.canvasToolbarIcon, Button.productChipAction, Button.productFilterChip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Button.viewportOverlayAction, ToggleButton.viewportOverlayAction">
    <Setter Property="Background" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="Opacity" Value="{StaticResource OpacityMuted}"/>
  </Style>

  <Style Selector="Button.viewportOverlayAction:pointerover, ToggleButton.viewportOverlayAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcTextStrongBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcTextStrongBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Button.viewportOverlayAction:focus-visible, ToggleButton.viewportOverlayAction:focus-visible">
    <Setter Property="Background" Value="{DynamicResource NfcTextStrongBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Button.viewportOverlayAction:pressed, ToggleButton.viewportOverlayAction:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Button.viewportOverlayAction:pointerover controls|FontIcon, ToggleButton.viewportOverlayAction:pointerover controls|FontIcon, Button.viewportOverlayAction:pressed controls|FontIcon, ToggleButton.viewportOverlayAction:pressed controls|FontIcon">
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}"/>
  </Style>

  <Style Selector="Button.viewportOverlayAction:disabled, ToggleButton.viewportOverlayAction:disabled">
    <Setter Property="Background" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="Opacity" Value="{StaticResource OpacityMuted}"/>
  </Style>

  <Style Selector="ToggleButton.viewportOverlayAction:checked, ToggleButton.viewportOverlayAction:checked:pointerover, ToggleButton.viewportOverlayAction:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcAccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="ToggleButton.viewportOverlayAction:checked controls|FontIcon, ToggleButton.viewportOverlayAction:checked:pointerover controls|FontIcon, ToggleButton.viewportOverlayAction:checked:pressed controls|FontIcon">
    <Setter Property="Foreground" Value="{DynamicResource NfcSurfaceBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction, ToggleButton.productChipAction">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction:pointerover, ToggleButton.productChipAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction:focus-visible, ToggleButton.productChipAction:focus-visible">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction:pressed, ToggleButton.productChipAction:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction:disabled, ToggleButton.productChipAction:disabled">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
    <Setter Property="Opacity" Value="{StaticResource OpacitySubtle}"/>
  </Style>

  <Style Selector="Button.productChipAction.active, ToggleButton.productChipAction.active">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.direct, Button.productChipAction.transfer, Button.productChipAction.linked, ToggleButton.productChipAction.direct, ToggleButton.productChipAction.transfer, ToggleButton.productChipAction.linked">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.hidden, Button.productChipAction.geometry, ToggleButton.productChipAction.hidden, ToggleButton.productChipAction.geometry">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.combined, ToggleButton.productChipAction.combined">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessTextBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcSuccessTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.duplicate, ToggleButton.productChipAction.duplicate">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningTextBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.layer, ToggleButton.productChipAction.layer">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.incoming, ToggleButton.productChipAction.incoming">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcSuccessTextBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcSuccessTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.outgoing, ToggleButton.productChipAction.outgoing">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcWarningTextBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcWarningTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.nocad, ToggleButton.productChipAction.nocad">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcDangerTextBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcDangerTextBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction.legacy, ToggleButton.productChipAction.legacy">
    <Setter Property="BorderBrush" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
  </Style>

  <Style Selector="ToggleButton.productChipAction:checked, ToggleButton.productChipAction:checked:pointerover, ToggleButton.productChipAction:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="ToggleButton.canvasQuickToggle">
    <Setter Property="MinHeight" Value="{StaticResource ProductControlMinHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_6}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="ToggleButton.canvasQuickToggle:focus-visible">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderStrongBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="ToggleButton.canvasQuickToggle:disabled">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceSubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="ToggleButton.canvasQuickToggle">
    <Setter Property="Background" Value="{DynamicResource NfcSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="ToggleButton.canvasQuickToggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="ToggleButton.canvasQuickToggle:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcBorderMutedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="ToggleButton.canvasQuickToggle:checked, ToggleButton.canvasQuickToggle:checked:pointerover, ToggleButton.canvasQuickToggle:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushToggleCheckedBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NfcAccentBorderBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushToggleCheckedForeground}"/>
  </Style>

  <Style Selector="Button.canvasToolbarIcon, ToggleButton.canvasToolbarIcon">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button.canvasToolbarIcon:pointerover, ToggleButton.canvasToolbarIcon:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="Button.canvasToolbarIcon:focus-visible, ToggleButton.canvasToolbarIcon:focus-visible">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="Button.canvasToolbarIcon:pressed, ToggleButton.canvasToolbarIcon:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="Button.canvasToolbarIcon:disabled, ToggleButton.canvasToolbarIcon:disabled">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextMutedBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="ToggleButton.canvasToolbarIcon:checked">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="ToggleButton.canvasToolbarIcon:checked:pointerover, ToggleButton.canvasToolbarIcon:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextStrongBrush}"/>
  </Style>

  <Style Selector="Button.productChipAction, ToggleButton.productChipAction">
    <Setter Property="MinHeight" Value="{StaticResource ProductControlMinHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderControl}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="Button.productFilterChip, ToggleButton.productFilterChip">
    <Setter Property="FontFamily" Value="{DynamicResource NfcUiFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource NfcFontSize13}"/>
    <Setter Property="Height" Value="{DynamicResource NfcControlHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource NfcControlHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset14_0}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusNone}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}"/>
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextSecondaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="Button.productFilterChip:pointerover, ToggleButton.productFilterChip:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip:pressed, ToggleButton.productFilterChip:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip.active, ToggleButton.productFilterChip.active">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip:checked, ToggleButton.productFilterChip:checked">
    <Setter Property="Background" Value="{DynamicResource NfcAccentSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip:checked:pointerover, ToggleButton.productFilterChip:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip.active:pointerover, ToggleButton.productFilterChip.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource NfcSelectionSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip:checked:pressed, ToggleButton.productFilterChip:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip.active:pressed, ToggleButton.productFilterChip.active:pressed">
    <Setter Property="Background" Value="{DynamicResource NfcSecondaryActionPressedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcAccentStrongBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip:disabled, ToggleButton.productFilterChip:disabled">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource NfcTextDisabledBrush}"/>
  </Style>

  <Style Selector="Button.productFilterChip.columnFilter">
    <Setter Property="Padding" Value="{StaticResource Inset2}"/>
  </Style>

  <Style Selector="Button.dxfEditMiniAction">
    <Setter Property="MinWidth" Value="{StaticResource DxfEditMiniActionMinWidth}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="Border.chipStatus">
    <Setter Property="MaxWidth" Value="{StaticResource WorkspaceSummaryChipMaxWidth}"/>
  </Style>

  <!-- Glyph size only: Core owns the role colours but sets no icon size. -->
  <Style Selector="Button.actionIconButton:not(.dxfEditMiniAction) controls|FontIcon, ToggleButton.actionIconButton controls|FontIcon, Button.viewportOverlayAction controls|FontIcon, ToggleButton.viewportOverlayAction controls|FontIcon, Button.canvasToolbarIcon controls|FontIcon, ToggleButton.canvasToolbarIcon controls|FontIcon, Button.productChipAction controls|FontIcon, ToggleButton.productChipAction controls|FontIcon">
    <Setter Property="FontSize" Value="{DynamicResource IconSizeMd}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style Selector="Button.panelChromeToggle controls|FontIcon, ToggleButton.panelChromeToggle controls|FontIcon">
    <Setter Property="FontSize" Value="{DynamicResource IconSizeXl}"/>
  </Style>

  <Style Selector="Button controls|FontIcon.symbols">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>

  <Style Selector="Button.canvasQuickToggle TextBlock, Button.canvasQuickToggle SelectableTextBlock, Button.canvasToolbarIcon TextBlock, Button.canvasToolbarIcon SelectableTextBlock, Button.viewportOverlayAction TextBlock, Button.viewportOverlayAction SelectableTextBlock, Button.productChipAction TextBlock, Button.productChipAction SelectableTextBlock, Button.productFilterChip TextBlock, Button.productFilterChip SelectableTextBlock">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>

  <Style Selector="ToggleButton controls|FontIcon.symbols">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
  </Style>

  <Style Selector="ToggleButton.canvasQuickToggle TextBlock, ToggleButton.canvasQuickToggle SelectableTextBlock, ToggleButton.canvasToolbarIcon TextBlock, ToggleButton.canvasToolbarIcon SelectableTextBlock, ToggleButton.viewportOverlayAction TextBlock, ToggleButton.viewportOverlayAction SelectableTextBlock, ToggleButton.productChipAction TextBlock, ToggleButton.productChipAction SelectableTextBlock, ToggleButton.productFilterChip TextBlock, ToggleButton.productFilterChip SelectableTextBlock">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>
</Styles>
