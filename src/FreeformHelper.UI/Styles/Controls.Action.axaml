    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionDangerBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionDangerForeground}"/>
  </Style>

  <Style Selector="Button.actionDanger:pointerover, ToggleButton.actionDanger:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushActionDangerHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionDangerBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionDangerForeground}"/>
  </Style>

  <Style Selector="Button.actionDanger:focus-visible, ToggleButton.actionDanger:focus-visible">
