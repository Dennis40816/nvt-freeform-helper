  <Style Selector="Button.actionGhost, ToggleButton.actionGhost">
    <Setter Property="Background" Value="{DynamicResource BrushActionGhostBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionGhostBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionGhostForeground}"/>
  </Style>

  <Style Selector="Button.actionGhost:pointerover, ToggleButton.actionGhost:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushActionGhostHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionGhostHover}"/>
