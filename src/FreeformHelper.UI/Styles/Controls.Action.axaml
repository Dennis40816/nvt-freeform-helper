<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls">
  <!-- Action primitives: mechanical layout only. Semantic role classes own state colors. -->
  <Style Selector="Button.actionButton, ToggleButton.actionButton, Button.actionTextButton, ToggleButton.actionTextButton">
    <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_6}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="Button.actionIconButton, ToggleButton.actionIconButton">
    <Setter Property="Width" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="MinWidth" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="Height" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="MinHeight" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="Padding" Value="{StaticResource InsetNone}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderNone}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="Button.actionIconButton.actionNeutral, Button.actionIconButton.actionPrimary, Button.actionIconButton.actionDanger, Button.actionIconButton.actionGhost, Button.actionIconButton.viewportOverlayAction, Button.actionIconButton.panelChromeToggle, Button.actionIconButton.consoleHeaderAction">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.actionIconButton.actionNeutral, ToggleButton.actionIconButton.actionPrimary, ToggleButton.actionIconButton.actionDanger, ToggleButton.actionIconButton.actionGhost, ToggleButton.actionIconButton.viewportOverlayAction, ToggleButton.actionIconButton.panelChromeToggle, ToggleButton.actionIconButton.consoleHeaderAction">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Button.actionChip, ToggleButton.actionChip">
    <Setter Property="MinHeight" Value="{StaticResource FormControlHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderControl}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>

  <Style Selector="Button.actionButton, Button.actionTextButton, Button.actionChip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.actionButton, ToggleButton.actionTextButton, ToggleButton.actionChip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Button.actionTextButton TextBlock, Button.actionTextButton SelectableTextBlock, ToggleButton.actionTextButton TextBlock, ToggleButton.actionTextButton SelectableTextBlock, Button.actionChip TextBlock, Button.actionChip SelectableTextBlock, ToggleButton.actionChip TextBlock, ToggleButton.actionChip SelectableTextBlock">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>

  <Style Selector="ToggleButton.actionTextButton TextBlock, ToggleButton.actionTextButton SelectableTextBlock, ToggleButton.actionChip TextBlock, ToggleButton.actionChip SelectableTextBlock">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
  </Style>

  <Style Selector="Button.actionIconButton controls|FontIcon, Button.actionTextButton controls|FontIcon, Button.actionChip controls|FontIcon">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="FontSize" Value="{DynamicResource IconSizeMd}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="ToggleButton.actionIconButton controls|FontIcon, ToggleButton.actionTextButton controls|FontIcon, ToggleButton.actionChip controls|FontIcon">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
    <Setter Property="FontSize" Value="{DynamicResource IconSizeMd}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Neutral action role. -->
  <Style Selector="Button.actionNeutral, ToggleButton.actionNeutral">
    <Setter Property="Background" Value="{DynamicResource BrushActionNeutralBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionNeutralForeground}"/>
  </Style>

  <Style Selector="Button.actionNeutral:pointerover, ToggleButton.actionNeutral:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushActionNeutralHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionNeutralForeground}"/>
  </Style>

  <Style Selector="Button.actionNeutral:focus-visible, ToggleButton.actionNeutral:focus-visible">
    <Setter Property="Background" Value="{DynamicResource BrushActionFocusBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionFocusBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionFocusForeground}"/>
  </Style>

  <Style Selector="Button.actionNeutral:pressed, ToggleButton.actionNeutral:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushActionNeutralPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionNeutralForeground}"/>
  </Style>

  <Style Selector="Button.actionNeutral:disabled, ToggleButton.actionNeutral:disabled">
    <Setter Property="Background" Value="{DynamicResource BrushActionNeutralBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="ToggleButton.actionNeutral:checked">
    <Setter Property="Background" Value="{DynamicResource BrushActionSelectedBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionSelectedBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionSelectedForeground}"/>
  </Style>

  <Style Selector="ToggleButton.actionNeutral:checked:pointerover, ToggleButton.actionNeutral:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushActionSelectedBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionSelectedBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionSelectedForeground}"/>
  </Style>

  <Style Selector="Button.actionTextButton.actionNeutral, ToggleButton.actionTextButton.actionNeutral">
    <Setter Property="Background" Value="{DynamicResource BrushButtonNeutralBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushButtonNeutralForeground}"/>
  </Style>

  <Style Selector="Button.actionTextButton.actionNeutral:pointerover, ToggleButton.actionTextButton.actionNeutral:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushButtonNeutralHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushButtonNeutralForeground}"/>
  </Style>

  <Style Selector="Button.actionTextButton.actionNeutral:pressed, ToggleButton.actionTextButton.actionNeutral:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushButtonNeutralPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushButtonNeutralForeground}"/>
  </Style>

  <Style Selector="ToggleButton.actionTextButton.actionNeutral:checked, ToggleButton.actionTextButton.actionNeutral:checked:pointerover, ToggleButton.actionTextButton.actionNeutral:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushActionSelectedBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionSelectedBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionSelectedForeground}"/>
  </Style>

  <!-- Primary action role. -->
  <Style Selector="Button.actionPrimary, ToggleButton.actionPrimary">
