    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionTextHoverBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionTextHoverForeground}"/>
  </Style>

  <Style Selector="Button.dangerTextButton">
    <Setter Property="Background" Value="{DynamicResource BrushButtonNeutralBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionDangerOnNeutralForeground}"/>
  </Style>

  <Style Selector="Button.dangerTextButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushButtonNeutralHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionDangerOnNeutralForeground}"/>
  </Style>

  <Style Selector="Button.dangerTextButton:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushButtonNeutralPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonNeutralBorder}"/>
