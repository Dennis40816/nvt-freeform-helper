  <!-- Canvas viewport overlay role. -->
  <Style Selector="Button.viewportOverlayAction, ToggleButton.viewportOverlayAction">
    <Setter Property="Background" Value="{DynamicResource BrushActionViewportBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionViewportBorder}"/>
