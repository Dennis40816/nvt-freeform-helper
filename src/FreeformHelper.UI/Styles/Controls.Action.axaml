    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionDangerBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushButtonNeutralForeground}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="ToggleButton.actionDanger:checked, ToggleButton.actionDanger:checked:pointerover, ToggleButton.actionDanger:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushActionDangerPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionDangerBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionDangerForeground}"/>
  </Style>

  <Style Selector="Button.actionTextButton.actionDanger:pointerover, ToggleButton.actionTextButton.actionDanger:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushActionTextHoverBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionTextHoverBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionDangerForeground}"/>
  </Style>

  <Style Selector="Button.actionTextButton.actionDanger:pressed, ToggleButton.actionTextButton.actionDanger:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushActionTextPressedBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushActionTextHoverBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionDangerForeground}"/>
  </Style>

