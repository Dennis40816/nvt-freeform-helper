    <Setter Property="Foreground" Value="{DynamicResource BrushActionSelectedForeground}"/>
  </Style>

  <Style Selector="Button.actionTextButton.actionPrimary:pointerover, ToggleButton.actionTextButton.actionPrimary:pointerover">
