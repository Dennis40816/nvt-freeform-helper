    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushButtonDisabledForeground}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Button.dangerTextButton:disabled:pointerover, Button.dangerTextButton:disabled:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushButtonNeutralBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonNeutralBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushButtonDisabledForeground}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- Icon action roles mirror console toolbar affordance: quiet glyph, bright surface on hover. -->
  <Style Selector="Button.actionIconButton.actionNeutral, Button.actionIconButton.actionPrimary, Button.actionIconButton.actionDanger, Button.actionIconButton.actionGhost, ToggleButton.actionIconButton.actionNeutral, ToggleButton.actionIconButton.actionPrimary, ToggleButton.actionIconButton.actionDanger, ToggleButton.actionIconButton.actionGhost">
    <Setter Property="Background" Value="{DynamicResource BrushActionConsoleBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionConsoleForeground}"/>
  </Style>

  <Style Selector="Button.actionIconButton.actionNeutral:pointerover, Button.actionIconButton.actionPrimary:pointerover, Button.actionIconButton.actionGhost:pointerover, ToggleButton.actionIconButton.actionNeutral:pointerover, ToggleButton.actionIconButton.actionPrimary:pointerover, ToggleButton.actionIconButton.actionGhost:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushActionInverseBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionInverseForeground}"/>
  </Style>

  <Style Selector="Button.actionIconButton.actionDanger:pointerover, ToggleButton.actionIconButton.actionDanger:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushActionInverseBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushActionInverseForeground}"/>
