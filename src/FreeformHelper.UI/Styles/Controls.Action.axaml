  </Style>

  <Style Selector="Border.chipStatus.success TextBlock, Border.chipStatus.success SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
  </Style>

  <!-- DXF edit mini actions keep default button rest state, then invert on hover for the dark left pane. -->
  <Style Selector="Button.dxfEditMiniAction">
