<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeformHelper.UI.Controls"
        xmlns:icons="clr-namespace:FreeformHelper.UI.Icons"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls">
  <!-- Panel block (settings card with collapsible header) -->
  <Style Selector="controls|HidePanelBlock">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:HidePanelBlock">
          <Border Classes="panelBlockRoot" HorizontalAlignment="Stretch">
            <StackPanel>
              <ToggleButton Classes="panelBlockHeader"
                            IsEnabled="{TemplateBinding IsCollapsible}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Text="{TemplateBinding Title}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             VerticalAlignment="Center"/>

                  <ContentPresenter Grid.Column="1"
                                    Content="{TemplateBinding HeaderRight}"
                                    VerticalAlignment="Center"
                                    Margin="{StaticResource InsetLeft10}"/>

                  <Border Grid.Column="2"
                          Classes="panelBlockChevronHost"
                          Margin="{StaticResource InsetLeft10}"
                          IsVisible="{TemplateBinding IsCollapsible}">
                    <controls:FontIcon Classes="panelBlockChevron symbols iconSm"
                                       Glyph="{x:Static icons:IconGlyphs.ExpandMore}"/>
                  </Border>
                </Grid>
              </ToggleButton>

              <Border Classes="panelBlockContent"
                      IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalAlignment="Stretch"/>
              </Border>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="controls|ReviewWorkspaceShell">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ReviewWorkspaceShell">
          <Border Padding="{StaticResource Inset14}">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
                  RowSpacing="{StaticResource Space14}">
              <Grid Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource Space16}">
                <StackPanel Spacing="{StaticResource Space2}">
                  <SelectableTextBlock Classes="workspaceMainTitle"
                                       Text="{TemplateBinding Title}"/>
                  <SelectableTextBlock Text="{TemplateBinding Subtitle}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       TextWrapping="Wrap"/>
                </StackPanel>

                <ContentPresenter Grid.Column="1"
                                  Content="{TemplateBinding HeaderRight}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"/>
              </Grid>

              <Border Grid.Row="1"
                      Classes="workspaceTopLayerBox">
                <ContentPresenter Content="{TemplateBinding SummaryContent}"/>
              </Border>

              <Border Grid.Row="2"
                      Classes="workspaceTopLayerBox">
                <ContentPresenter Content="{TemplateBinding ToolbarContent}"/>
              </Border>

              <Border Grid.Row="3"
                      Background="{DynamicResource BrushBgPanel}"
                      BorderBrush="{DynamicResource BrushBorder}"
                      BorderThickness="{StaticResource BorderThin}"
                      CornerRadius="{StaticResource RadiusSm}"
                      Padding="{StaticResource Inset8}">
                <Grid ColumnSpacing="{StaticResource Space12}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource NotchExportMainLeftColumnWidth}"/>
                    <ColumnDefinition Width="{StaticResource NotchExportMainRightColumnWidth}"/>
                  </Grid.ColumnDefinitions>

                  <ContentPresenter Content="{TemplateBinding LeftContent}"/>
                  <ContentPresenter Grid.Column="1"
                                    Content="{TemplateBinding RightContent}"/>
                </Grid>
              </Border>

              <ContentPresenter Grid.Row="4"
                                Content="{TemplateBinding FooterContent}"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Border.panelBlockRoot">
    <Setter Property="Background" Value="{DynamicResource BrushBgSurfaceInset}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.workspaceSidePane">
    <Setter Property="Padding" Value="{StaticResource Inset12}"/>
    <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.workspaceSidePane.left">
    <Setter Property="BorderThickness" Value="{StaticResource BorderRightThin}"/>
    <Setter Property="MinWidth" Value="{StaticResource PanelLeftMinWidth}"/>
  </Style>

  <Style Selector="Border.workspaceSidePane.right">
    <Setter Property="BorderThickness" Value="{StaticResource BorderLeftThin}"/>
    <Setter Property="MinWidth" Value="{StaticResource PanelRightMinWidth}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderBottomThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusTopMd}"/>
    <Setter Property="Padding" Value="{StaticResource Inset12_10}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader TextBlock, ToggleButton.panelBlockHeader SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSubtle}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader controls|FontIcon.panelBlockChevron">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSubtle}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushBgInteractiveHover}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushBgInteractivePressed}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:checked">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderBottomThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusTopMd}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:checked TextBlock, ToggleButton.panelBlockHeader:checked SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:checked controls|FontIcon.panelBlockChevron">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushBgInteractiveHover}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:checked:pressed">
    <Setter Property="Background" Value="{DynamicResource BrushBgInteractivePressed}"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:disabled">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Border.panelBlockChevronHost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Width" Value="{StaticResource PanelBlockChevronHostSize}"/>
    <Setter Property="Height" Value="{StaticResource PanelBlockChevronHostSize}"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="ToggleButton.panelBlockHeader:checked controls|FontIcon.panelBlockChevron">
    <Setter Property="Glyph" Value="{x:Static icons:IconGlyphs.ExpandLess}"/>
  </Style>

  <Style Selector="Border.panelBlockContent">
    <Setter Property="Padding" Value="{StaticResource Inset10}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderTopThin}"/>
  </Style>

  <Style Selector="StackPanel.workflowOverviewRail">
    <Setter Property="Spacing" Value="{StaticResource Space8}"/>
  </Style>

  <Style Selector="Border.workflowOverviewSection">
    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_10}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.workflowOverviewSection.last">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
  </Style>

  <Style Selector="Border.workflowOverviewSection.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
  </Style>

  <Style Selector="Border.workflowOverviewSection.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
  </Style>

  <Style Selector="Border.workflowStepSubsection">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderTopThin}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_8}"/>
  </Style>

  <Style Selector="Border.workflowStepInsetPanel">
    <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
  </Style>

  <Style Selector="Border.workflowStepStatusStrip">
    <Setter Property="Background" Value="{DynamicResource BrushBgPanel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="{StaticResource Inset8_6}"/>
  </Style>

  <Style Selector="Border.workflowStepMetricTile">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderBottomThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusNone}"/>
    <Setter Property="Padding" Value="{StaticResource Inset6_4}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowStepMetricLabel, TextBlock.workflowStepMetricLabel">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowStepMetricText, TextBlock.workflowStepMetricText">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="3"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowStepMetricText.compact, TextBlock.workflowStepMetricText.compact">
    <Setter Property="MaxLines" Value="2"/>
  </Style>

  <Style Selector="Grid.workflowLegendRow">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space8}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowLegendTitle, TextBlock.workflowLegendTitle">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowLegendMeta, TextBlock.workflowLegendMeta">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="1"/>
  </Style>

  <Style Selector="Grid.workflowOverviewHeader">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space6}"/>
  </Style>

  <Style Selector="Grid.workflowOverviewInfoGrid">
    <Setter Property="ColumnSpacing" Value="{StaticResource Space8}"/>
    <Setter Property="RowSpacing" Value="{StaticResource Space4}"/>
  </Style>

  <Style Selector="StackPanel.workflowOverviewMetaBlock">
    <Setter Property="Spacing" Value="{StaticResource Space2}"/>
  </Style>

  <Style Selector="Button.icon.ghost.workflowOverviewAction, Button.icon.ghost.workflowStepAction">
    <Setter Property="Background" Value="{DynamicResource BrushTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
  </Style>

  <Style Selector="Button.icon.ghost.workflowOverviewAction:pointerover, Button.icon.ghost.workflowStepAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrushBgInteractiveHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushTransparent}"/>
  </Style>

  <Style Selector="Button.icon.ghost.workflowOverviewAction controls|FontIcon, Button.icon.ghost.workflowStepAction controls|FontIcon">
    <Setter Property="FontSize" Value="{DynamicResource IconSizeLg}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
  </Style>

  <Style Selector="Button.icon.ghost.workflowOverviewAction:pointerover controls|FontIcon, Button.icon.ghost.workflowStepAction:pointerover controls|FontIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
  </Style>

  <Style Selector="Border.workflowOverviewBadge">
    <Setter Property="Background" Value="{DynamicResource BrushBgElevated}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_4}"/>
    <Setter Property="Margin" Value="{StaticResource InsetRight8Bottom6}"/>
    <Setter Property="MaxWidth" Value="{StaticResource WorkspaceSummaryChipMaxWidth}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.workflowOverviewBadge.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
  </Style>

  <Style Selector="Border.workflowOverviewBadge.warning SelectableTextBlock.workflowOverviewBadgeText, Border.workflowOverviewBadge.warning TextBlock.workflowOverviewBadgeText">
    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
  </Style>

  <Style Selector="Border.workflowOverviewBadge.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
  </Style>

  <Style Selector="Border.workflowOverviewBadge.danger SelectableTextBlock.workflowOverviewBadgeText, Border.workflowOverviewBadge.danger TextBlock.workflowOverviewBadgeText">
    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewBadgeText, TextBlock.workflowOverviewBadgeText">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewTitle, TextBlock.workflowOverviewTitle">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewStatus, TextBlock.workflowOverviewStatus">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSubtle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewStatus.warning, TextBlock.workflowOverviewStatus.warning">
    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewStatus.danger, TextBlock.workflowOverviewStatus.danger">
    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewLabel, TextBlock.workflowOverviewLabel">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewValue, TextBlock.workflowOverviewValue">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSubtle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewValue.warning, TextBlock.workflowOverviewValue.warning">
    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewValue.danger, TextBlock.workflowOverviewValue.danger">
    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
  </Style>

  <Style Selector="SelectableTextBlock.workflowOverviewMeta, TextBlock.workflowOverviewMeta">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="MaxLines" Value="2"/>
  </Style>

  <!-- Console panel content. Toolbar actions live in Controls.Action.axaml. -->
  <Style Selector="avaloniaEdit|TextEditor.consoleEditor">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
  </Style>

  <Style Selector="TextBox.consoleSearch">
    <Setter Property="Padding" Value="{StaticResource Inset8_4}"/>
    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderMuted}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderInput}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBox.consoleSearch:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
  </Style>

  <Style Selector="Border.canvasQuickToolbar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Opacity" Value="{StaticResource OpacityCanvasQuickToolbarIdle}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
    <Setter Property="Padding" Value="{StaticResource Inset10_6}"/>
  </Style>

  <Style Selector="Border.canvasQuickToolbar:pointerover">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="Border.canvasQuickToolbar.coordinateOverlayToolbar">
    <Setter Property="Background" Value="{DynamicResource BrushBgSurface}"/>
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
  </Style>

  <Style Selector="TextBlock.canvasQuickHint, SelectableTextBlock.canvasQuickHint">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
  </Style>

  <Style Selector="TextBlock.stepNote, SelectableTextBlock.stepNote">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

</Styles>
