<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon\freeform-helper.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeformHelper.CoreSource\FreeformHelper.CoreSource.csproj" />
    <ProjectReference Include="..\FreeformHelper.Application\FreeformHelper.Application.csproj" />
    <ProjectReference Include="..\FreeformHelper.Infrastructure\FreeformHelper.Infrastructure.csproj" />
    <ProjectReference Include="..\FreeformHelper.Domain\FreeformHelper.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Nvt.Core.Avalonia" />
    <PackageReference Include="Nvt.Core.Fonts" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Copy from the restored Fonts package; keep notices beside both publish profiles' EXE. -->
    <Content Include="$(NuGetPackageRoot)nvt.core.fonts\0.1.0\LICENSE"
             Link="licenses\Nvt.Core\LICENSE"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="$(NuGetPackageRoot)nvt.core.fonts\0.1.0\licenses\**\*"
             Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <!-- Inter ships inside Avalonia.Fonts.Inter without a license file; keep its upstream OFL text beside the EXE. -->
    <Content Include="licenses\Inter\LICENSE"
             Link="licenses\Inter\LICENSE"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
