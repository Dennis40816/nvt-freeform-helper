<!-- xUnit v3 test projects must build an app host. The scripts' -UseNoAppHost passes UseAppHost=false to every
     project so that a running FreeformHelper.UI.exe is never overwritten; this project keeps its own value. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="UseAppHost">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FreeformHelper.Domain\FreeformHelper.Domain.csproj" />
    <ProjectReference Include="..\..\src\FreeformHelper.Application\FreeformHelper.Application.csproj" />
    <ProjectReference Include="..\..\src\FreeformHelper.Infrastructure\FreeformHelper.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\FreeformHelper.UI\FreeformHelper.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
</Project>
